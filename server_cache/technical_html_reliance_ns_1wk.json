ecoration='none'\">\r\n                                View Complete Portfolio & Trade History →\r\n                            </a>\r\n                        </div>\r\n                        \r\n                        <div style=\"display: grid; grid-template-columns: 1fr; gap: 20px;\">\r\n                            <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;\">\r\n                                <div style=\"background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;\">\r\n                                    <div style=\"font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;\">Available Cash</div>\r\n                                    <div id=\"virtual-cash-display\" style=\"font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;\">$100,000.00</div>\r\n                                </div>\r\n                                <div style=\"background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;\">\r\n                                    <div style=\"font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;\">Position in RELIANCE.NS</div>\r\n                                    <div id=\"virtual-holding-display\" style=\"font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;\">0 Shares</div>\r\n                                </div>\r\n                                <div style=\"background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;\">\r\n                                    <div style=\"font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;\">Average Buy Price</div>\r\n                                    <div id=\"virtual-avg-price-display\" style=\"font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;\">$0.00</div>\r\n                                </div>\r\n                            </div>\r\n                            \r\n                            <div style=\"display: flex; gap: 20px; align-items: flex-end; flex-wrap: wrap; margin-top: 5px; background: rgba(13, 17, 23, 0.4); padding: 20px; border: 1px solid var(--border); border-radius: 8px;\">\r\n                                <div style=\"flex: 1; min-width: 150px;\">\r\n                                    <label style=\"display: block; font-size: 0.75rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 8px;\">Order Action</label>\r\n                                    <div style=\"display: flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #0d1117; height: 42px; box-sizing: border-box;\">\r\n                                        <button type=\"button\" id=\"trade-btn-buy\" onclick=\"setChartTradeAction('BUY')\" style=\"flex: 1; border: none; background: #26a69a; color: #000; font-weight: bold; cursor: pointer; transition: all 0.2s;\">BUY</button>\r\n                                        <button type=\"button\" id=\"trade-btn-sell\" onclick=\"setChartTradeAction('SELL')\" style=\"flex: 1; border: none; background: transparent; color: #8E9BAE; font-weight: bold; cursor: pointer; transition: all 0.2s;\">SELL</button>\r\n                                    </div>\r\n                                </div>\r\n                                \r\n                                <div style=\"flex: 1; min-width: 120px;\">\r\n                                    <label style=\"display: block; font-size: 0.75rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 8px;\">Quantity</label>\r\n                                    <input type=\"number\" id=\"trade-qty-input\" value=\"1\" min=\"1\" step=\"1\" oninput=\"recalcChartTradeEstimate()\" style=\"width: 100%; height: 42px; padding: 10px; background: #0d1117; border: 1px solid var(--border); border-radius: 6px; color: #fff; font-family: 'JetBrains Mono', monospace; font-size: 1rem; font-weight: bold; outline: none; box-sizing: border-box;\">\r\n                                </div>\r\n                                \r\n                                <div style=\"flex: 1.5; min-width: 180px;\">\r\n                                    <div style=\"display: flex; justify-content: space-between; font-size: 0.75rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 8px;\">\r\n                                        <span>Estimated Cost</span>\r\n                                        <span id=\"chart-trade-currency\" style=\"color: #64748b;\">USD</span>\r\n                                    </div>\r\n                                    <div style=\"background: #0d1117; border: 1px solid var(--border); border-radius: 6px; padding: 0 15px; height: 42px; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;\">\r\n                                        <span id=\"chart-trade-estimate-price\" style=\"font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #8E9BAE;\">$0.00 each</span>\r\n                                        <span id=\"chart-trade-estimate-total\" style=\"font-family: 'JetBrains Mono', monospace; font-weight: bold; color: #fff; font-size: 1rem;\">$0.00</span>\r\n                                    </div>\r\n                                </div>\r\n                                \r\n                                <button type=\"button\" id=\"chart-trade-submit-btn\" onclick=\"executeChartTrade()\" style=\"height: 42px; padding: 0 25px; background: #26a69a; border: none; border-radius: 6px; color: #000; font-weight: bold; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s; box-shadow: 0 4px 15px rgba(38,166,154,0.3);\">\r\n                                    BUY RELIANCE.NS\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- LIVE SENTIMENT & NEWS TERMINAL -->\r\n                    <div class=\"chart-card\" id=\"sentiment-analysis-panel\" style=\"padding: 25px; margin-bottom: 25px;\">\r\n                        <div style=\"display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 20px;\">\r\n                            <h3 style=\"margin: 0; color: #f8fafc; font-size: 1.25rem; display: flex; align-items: center; gap: 8px;\">\r\n                                <span>🤖</span> AI News & Sentiment Terminal\r\n                            </h3>\r\n                            <span style=\"font-size: 0.8rem; color: #8e9bae; font-family: 'JetBrains Mono', monospace;\" id=\"sentiment-last-updated\">PENDING...</span>\r\n                        </div>\r\n\r\n                        <!-- Main Grid Layout -->\r\n                        <div style=\"display: grid; grid-template-columns: 1fr; gap: 20px;\">\r\n                            <!-- Top Sentiment Summary: Gauge and Score Cards -->\r\n                            <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;\">\r\n                                <!-- Sentiment Score Card -->\r\n                                <div style=\"background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px; display: flex; align-items: center; justify-content: space-between;\">\r\n                                    <div>\r\n                                        <div style=\"font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;\">Overall Sentiment</div>\r\n                                        <div id=\"sentiment-overall-label\" style=\"font-family: 'JetBrains Mono', monospace; font-size: 1.4rem; font-weight: 800; color: #8e9bae;\">LOADING...</div>\r\n                                    </div>\r\n                                    <div id=\"sentiment-overall-icon\" style=\"font-size: 2.2rem;\">📡</div>\r\n                                </div>\r\n\r\n                                <!-- Sentiment Gauge Card -->\r\n                                <div style=\"background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px; display: flex; align-items: center; gap: 20px;\">\r\n                                    <div style=\"position: relative; width: 80px; height: 40px; overflow: hidden; flex-shrink: 0;\">\r\n                                        <!-- Outer arc -->\r\n                                        <div style=\"width: 80px; height: 80px; border-radius: 50%; background: conic-gradient(from 270deg at 50% 50%, #ff0055 0deg, #f59e0b 90deg, #00FF9D 180deg, transparent 180deg); box-sizing: border-box; position: absolute; top: 0; left: 0;\"></div>\r\n                                        <!-- Inner cutout to create semi-circle arch -->\r\n                                        <div style=\"width: 60px; height: 60px; border-radius: 50%; background: #0d1117; position: absolute; top: 10px; left: 10px;\"></div>\r\n                                        <!-- Center pin -->\r\n                                        <div style=\"width: 8px; height: 8px; border-radius: 50%; background: #fff; position: absolute; bottom: 0; left: 36px; z-index: 5;\"></div>\r\n                                        <!-- Needle -->\r\n                                        <div id=\"sentiment-gauge-needle\" style=\"width: 2px; height: 32px; background: #fff; position: absolute; bottom: 0; left: 39px; transform-origin: bottom center; transform: rotate(0deg); transition: transform 1s cubic-bezier(0.175, 0.885, 0.32, 1.275); z-index: 4; box-shadow: 0 0 5px rgba(255,255,255,0.8);\"></div>\r\n                                    </div>\r\n                                    <div>\r\n                                        <div style=\"font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;\">Sentiment Index</div>\r\n                                        <div id=\"sentiment-index-val\" style=\"font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;\">0.00</div>\r\n                                    </div>\r\n                                </div>\r\n\r\n                                <!-- Key Buzzwords Card -->\r\n                                <div style=\"background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;\">\r\n                                    <div style=\"font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;\">Key Market Drivers</div>\r\n                                    <div id=\"sentiment-drivers-container\" style=\"display: flex; flex-wrap: wrap; gap: 6px; margin-top: 5px;\">\r\n                                        <span style=\"font-size: 0.75rem; color: #64748b;\">No active drivers</span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <!-- News Timeline List -->\r\n                            <div style=\"background: #0d1117; border: 1px solid var(--border); border-radius: 8px; padding: 20px;\">\r\n                                <div style=\"font-size: 0.8rem; color: #8e9bae; font-weight: bold; text-transform: uppercase; border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-bottom: 15px;\">\r\n                                    Latest Headwinds & Catalysts\r\n                                </div>\r\n                                <div id=\"sentiment-news-list\" style=\"display: flex; flex-direction: column; gap: 15px; max-height: 250px; overflow-y: auto; padding-right: 5px;\">\r\n                                    <div style=\"text-align: center; color: #64748b; padding: 20px; font-size: 0.9rem;\">\r\n                                        Analyzing news articles...\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"chart-card\">\r\n                        <button class=\"close-fullscreen-btn\" onclick=\"exitFullScreen(this)\"\r\n                            title=\"Close Full Screen\">×</button>\r\n                        <button class=\"menu-toggle-btn\" onclick=\"toggleSidebarMenu(this)\"\r\n                            title=\"Toggle Drawing Tools\">☰</button>\r\n                        <div\r\n                            style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;\">\r\n                            <h3 style=\"margin: 0; color: #e2e8f0;\">Pattern Recognition Canvas <span\r\n                                    style=\"font-size: 0.75rem; color: #64748b; font-weight: normal; margin-left: 10px;\">(Hold\r\n                                    Ctrl to Zoom)</span></h3>\r\n                            <div class=\"toolbar\"\r\n                                style=\"display: flex; align-items: center; gap: 10px; flex-wrap: wrap;\">\r\n                                <button class=\"tool-btn\" id=\"btn-fullscreen-pattern\"\r\n                                    style=\"color: #fff; background: rgba(255,255,255,0.1); border: 1px solid transparent; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; font-weight: 600;\">⛶\r\n                                    Full View</button>\r\n                                <label class=\"tool-checkbox\"\r\n                                    style=\"color: #fbbf24; padding: 4px 10px; background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.4); border-radius: 4px;\">\r\n                                    <input type=\"checkbox\" id=\"toggle-pattern-auto\" checked> Auto Patterns\r\n                                </label>\r\n                                <label class=\"tool-checkbox\"\r\n                                    style=\"color: #26a69a; padding: 4px 10px; background: rgba(38, 166, 154, 0.1); border: 1px solid rgba(38, 166, 154, 0.4); border-radius: 4px;\">\r\n                                    <input type=\"checkbox\" id=\"toggle-pattern-trendline\" checked> Auto Trendline\r\n                                </label>\r\n                                <label class=\"tool-checkbox\"\r\n                                    style=\"color: #a855f7; padding: 4px 10px; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.4); border-radius: 4px;\">\r\n                                    <input type=\"checkbox\" id=\"toggle-pattern-sr\"> Auto S/R\r\n                                </label>\r\n                                <label class=\"tool-checkbox\"\r\n                                    style=\"color: #f43f5e; padding: 4px 10px; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 4px;\">\r\n                                    <input type=\"checkbox\" id=\"toggle-pattern-fib\"> Auto Fib\r\n                                </label>\r\n                                <label class=\"tool-checkbox\"\r\n                                    style=\"color: #60a5fa; padding: 4px 10px; background: rgba(96, 165, 250, 0.1); border: 1px solid rgba(96, 165, 250, 0.4); border-radius: 4px;\">\r\n                                    <input type=\"checkbox\" id=\"toggle-pattern-pivot\"> Pivot Points\r\n                                </label>\r\n                            </div>\r\n                        </div>\r\n                        <div id=\"pattern-container\"\r\n                            style=\"position: relative; height: 350px; width: 100%; user-select: none; overflow: hidden; display: block; cursor: crosshair;\">\r\n                            <div id=\"pattern-chart-loading\" class=\"chart-loading-overlay\">\r\n                                <div class=\"loading-pulse\">Analyzing Candlestick Patterns...</div>\r\n                            </div>\r\n                            <svg id=\"pattern-svg\" style=\"width: 100%; height: 100%; display: block;\">\r\n                                <g id=\"pattern-grid-layer\"></g>\r\n                                <g id=\"pattern-candle-layer\" style=\"shape-rendering: crispEdges;\"></g>\r\n                                <g id=\"pattern-signal-layer\"></g>\r\n                                <g id=\"pattern-time-layer\"></g>\r\n                                <g id=\"pattern-drawing-layer\"></g>\r\n                                <line id=\"cross-h-pat\" class=\"crosshair\" x1=\"0\" y1=\"0\" x2=\"100%\" y2=\"0\" />\r\n                                <line id=\"cross-v-pat\" class=\"crosshair\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"100%\" />\r\n                            </svg>\r\n                    </div>\r\n\r\n                    <!-- AI Technical Analyst Summary Card -->\r\n                    <div class=\"chart-card\" id=\"ai-summary-section\" style=\"margin-top: 25px; display: none;\">\r\n                        <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;\">\r\n                            <div style=\"display: flex; align-items: center; gap: 10px;\">\r\n                                <h3 style=\"margin: 0; color: #e2e8f0; display: flex; align-items: center; gap: 8px;\">\r\n                                    <span style=\"color: #38bdf8;\">🤖</span> AI Technical Analyst Executive Summary\r\n                                </h3>\r\n                                <div style=\"display: flex; align-items: center; gap: 5px; background: rgba(38, 166, 154, 0.1); border: 1px solid rgba(38, 166, 154, 0.2); padding: 3px 8px; border-radius: 4px;\">\r\n                                    <span style=\"width: 6px; height: 6px; background: #26a69a; border-radius: 50%; display: inline-block; animation: pulse-green 1.5s infinite;\"></span>\r\n                                    <span style=\"font-size: 0.65rem; color: #26a69a; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;\">Live Quant Analysis</span>\r\n                                </div>\r\n                            </div>\r\n                            <button id=\"copy-summary-btn\" onclick=\"copySummaryText()\" style=\"background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s; border-radius: 6px;\">\r\n                                📋 Copy Report\r\n                            </button>\r\n                        </div>\r\n                        <div id=\"ai-summary-content\" style=\"font-family: 'Inter', sans-serif; font-size: 0.95rem; line-height: 1.7; color: #cbd5e1; background: rgba(13, 17, 23, 0.5); border: 1px solid #1e293b; padding: 25px; border-radius: 12px; min-height: 120px; max-height: 400px; overflow-y: auto; position: relative;\">\r\n                            <div id=\"ai-summary-text\" style=\"font-family: 'Inter', sans-serif; font-size: 0.95rem; line-height: 1.7; color: #e2e8f0; white-space: pre-line;\">Generating technical analysis script...</div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <footer style=\"background: rgba(10, 15, 30, 0.95); border-top: 1px solid var(--border, #334155); padding: 40px 20px; font-family: 'Inter', sans-serif; color: #94a3b8; margin-top: 50px; border-radius: 8px;\">\n    <div style=\"max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 30px; align-items: start;\">\n        <!-- Left Column: Branding -->\n        <div>\n            <div style=\"margin-bottom: 12px; display: flex; align-items: center; gap: 8px;\">\n                <img src=\"/images/finorapulse-logo-full.png\" alt=\"FinoraPulse Logo\" style=\"height: 28px; filter: drop-shadow(0 0 8px rgba(0, 240, 255, 0.2)); cursor: pointer;\" onclick=\"window.location.href='/'\">\n            </div>\n            <p style=\"font-size: 0.85rem; line-height: 1.6; color: #64748b; margin: 0 0 15px 0;\">\n                Advanced AI-powered stock prediction, algorithmic charting, macroeconomic research, and paper trading analytics.\n            </p>\n            <div style=\"font-size: 0.75rem; color: #475569;\">\n                &copy; 2026 FinoraPulse. All rights reserved.\n            </div>\n        </div>\n\n        <!-- Center Column: Core Features -->\n        <div>\n            <h4 style=\"color: #f8fafc; font-size: 0.9rem; margin-top: 0; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;\">Core Features</h4>\n            <div style=\"display: grid; grid-template-columns: 1fr; gap: 8px; font-size: 0.85rem;\">\n                <a href=\"/predict?ticker=RELIANCE.NS\" style=\"color: #94a3b8; text-decoration: none; transition: color 0.2s;\" onmouseover=\"this.style.color='#00E5FF'\" onmouseout=\"this.style.color='#94a3b8'\">AI Price Predictor</a>\n                <a href=\"/macro\" style=\"color: #94a3b8; text-decoration: none; transition: color 0.2s;\" onmouseover=\"this.style.color='#00E5FF'\" onmouseout=\"this.style.color='#94a3b8'\">Macro Quant Explorer</a>\n                <a href=\"/heatmap\" style=\"color: #94a3b8; text-decoration: none; transition: color 0.2s;\" onmouseover=\"this.style.color='#00E5FF'\" onmouseout=\"this.style.color='#94a3b8'\">Market Heatmap</a>\n                <a href=\"/calculator\" style=\"color: #94a3b8; text-decoration: none; transition: color 0.2s;\" onmouseover=\"this.style.color='#00E5FF'\" onmouseout=\"this.style.color='#94a3b8'\">Pro Calculators</a>\n            </div>\n        </div>\n\n        <!-- Right Column: Legal Information -->\n        <div>\n            <h4 style=\"color: #f8fafc; font-size: 0.9rem; margin-top: 0; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;\">Legal & Disclosure</h4>\n            <div style=\"display: flex; flex-direction: column; gap: 8px; font-size: 0.85rem;\">\n                <a href=\"/privacy-policy\" style=\"color: #00E5FF; text-decoration: none; font-weight: 600; transition: color 0.2s;\" onmouseover=\"this.style.color='#00FF9D'\" onmouseout=\"this.style.color='#00E5FF'\">Privacy Policy</a>\n                <a href=\"/terms-of-service\" style=\"color: #00E5FF; text-decoration: none; font-weight: 600; transition: color 0.2s;\" onmouseover=\"this.style.color='#00FF9D'\" onmouseout=\"this.style.color='#00E5FF'\">Terms of Service</a>\n                <a href=\"/disclaimer\" style=\"color: #00E5FF; text-decoration: none; font-weight: 600; transition: color 0.2s;\" onmouseover=\"this.style.color='#00FF9D'\" onmouseout=\"this.style.color='#00E5FF'\">Disclaimer</a>\n                <a href=\"/about\" style=\"color: #00E5FF; text-decoration: none; font-weight: 600; transition: color 0.2s;\" onmouseover=\"this.style.color='#00FF9D'\" onmouseout=\"this.style.color='#00E5FF'\">About Us</a>\n                <a href=\"/contact\" style=\"color: #00E5FF; text-decoration: none; font-weight: 600; transition: color 0.2s;\" onmouseover=\"this.style.color='#00FF9D'\" onmouseout=\"this.style.color='#00E5FF'\">Contact Us</a>\n                <p style=\"font-size: 0.7rem; color: #475569; line-height: 1.5; margin: 5px 0 0 0;\">\n                    <strong>Simulated Trading Notice:</strong> FinoraPulse provides mock trading tools. No actual capital is risked. All predictions are algorithmic suggestions and not financial advice.\n                </p>\n            </div>\n        </div>\n    </div>\n</footer>\n\r\n                </main>\r\n                <aside class=\"side-panel right\"></aside>\r\n        </div>\r\n\r\n        <script>\r\n            const currentTicker = \"RELIANCE.NS\";\r\n            let currentTimeframe = \"1wk\";\r\n\r\n            function changeTimeframe(tf, btnElement) {\r\n                currentTimeframe = tf;\r\n                document.querySelectorAll('.tf-btn').forEach(btn => btn.classList.remove('active'));\r\n                btnElement.classList.add('active');\r\n\r\n                const tfLabel = document.getElementById('timeframe-label');\r\n                if (tfLabel) {\r\n                    tfLabel.innerText = tf;\r\n                }\r\n\r\n                drawnLines = []; // Clear manual drawings since index/price scales change\r\n                fetchOHLCData();\r\n            }\r\n\r\n            let ohlcData = [];\r\n\r\n            // State Management\r\n            let visibleCount = 80; let offset = 0; let dragAccumulator = 0;\r\n            let chartState = { minP: 0, maxP: 0, range: 0, candleW: 0, chartH: 0, padT: 20, padB: 40, padR: 55 };\r\n\r\n            let patternVisibleCount = 80; let patternOffset = 0; let patternDragAccumulator = 0;\r\n            let patternState = { minP: 0, maxP: 0, range: 0, candleW: 0, chartH: 0, padT: 20, padB: 40, padR: 55 };\r\n\r\n            let verticalScrollShift = 0;\r\n            let patternVerticalScrollShift = 0;\r\n\r\n            function toggleSidebarMenu(btn) {\r\n                const card = btn.closest('.chart-card');\r\n                const toolbar = card.querySelector('.toolbar');\r\n                toolbar.classList.toggle('open');\r\n            }\r\n\r\n            function closeActiveDrawer() {\r\n                document.querySelectorAll('.toolbar').forEach(tb => tb.classList.remove('open'));\r\n            }\r\n\r\n            // UI States\r\n            let showSMA20 = false, showSMA50 = false, showEMA9 = false, showEMA21 = false, showVWAP = false;\r\n            let showBB = false, showVPVR = false, showIchimoku = false, showSuperTrend = false, showFVG = false;\r\n            let showPSAR = false, showCandleSignals = false;\r\n\r\n            // NEW STATES FOR PATTERN CANVAS\r\n            let showPatternSR = false, showAutoPatterns = true, showAutoTrendline = true, showAutoFib = false, showPivotPoints = false;\r\n\r\n            let activeSubChart = 'RSI', activeTool = 'pan';\r\n            let drawnLines = [], tempTrendline = null, tempFib = null;\r\n\r\n            const svgContainer = document.getElementById('svg-container');\r\n            const patternContainer = document.getElementById('pattern-container');\r\n            const chartContainers = [svgContainer, patternContainer];\r\n\r\n            // Tools\r\n            const tools = { 'tool-pan': 'pan', 'tool-hz': 'hz', 'tool-trend': 'trend', 'tool-fib': 'fib' };\r\n            Object.keys(tools).forEach(id => {\r\n                document.getElementById(id).onclick = (e) => {\r\n                    document.querySelectorAll('#tool-pan, #tool-hz, #tool-trend, #tool-fib').forEach(b => b.classList.remove('active'));\r\n                    e.target.classList.add('active');\r\n                    activeTool = tools[id];\r\n                    const cursorStyle = activeTool === 'pan' ? 'grab' : 'crosshair';\r\n                    svgContainer.style.cursor = cursorStyle; patternContainer.style.cursor = cursorStyle;\r\n                    closeActiveDrawer();\r\n                };\r\n            });\r\n\r\n            // Top Chart Listeners\r\n            document.getElementById('tool-clear').onclick = () => { drawnLines = []; renderAll(); closeActiveDrawer(); };\r\n            document.getElementById('toggle-sma20').onchange = (e) => { showSMA20 = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-sma50').onchange = (e) => { showSMA50 = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-ema9').onchange = (e) => { showEMA9 = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-ema21').onchange = (e) => { showEMA21 = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-vwap').onchange = (e) => { showVWAP = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-ichimoku').onchange = (e) => { showIchimoku = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-supertrend').onchange = (e) => { showSuperTrend = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-fvg').onchange = (e) => { showFVG = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-bb').onchange = (e) => { showBB = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-vpvr').onchange = (e) => { showVPVR = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-psar').onchange = (e) => { showPSAR = e.target.checked; renderSVG(); };\r\n            document.getElementById('toggle-candlesignals').onchange = (e) => { showCandleSignals = e.target.checked; renderAll(); };\r\n\r\n            // Pattern Chart Listeners\r\n            document.getElementById('toggle-pattern-sr').onchange = (e) => { showPatternSR = e.target.checked; renderPatternChart(); };\r\n            document.getElementById('toggle-pattern-auto').onchange = (e) => { showAutoPatterns = e.target.checked; renderPatternChart(); };\r\n            document.getElementById('toggle-pattern-trendline').onchange = (e) => { showAutoTrendline = e.target.checked; renderPatternChart(); };\r\n            document.getElementById('toggle-pattern-fib').onchange = (e) => { showAutoFib = e.target.checked; renderPatternChart(); };\r\n            document.getElementById('toggle-pattern-pivot').onchange = (e) => { showPivotPoints = e.target.checked; renderPatternChart(); };\r\n\r\n            // Checkbox drawer close handler\r\n            document.querySelectorAll('.toolbar input[type=\"checkbox\"]').forEach(cb => {\r\n                cb.addEventListener('change', () => {\r\n                    if (window.innerWidth <= 768) {\r\n                        closeActiveDrawer();\r\n                    }\r\n                });\r\n            });\r\n\r\n            document.getElementById('tab-rsi').onclick = () => setSubChart('RSI');\r\n            document.getElementById('tab-macd').onclick = () => setSubChart('MACD');\r\n            document.getElementById('tab-stoch').onclick = () => setSubChart('STOCH');\r\n            document.getElementById('tab-atr').onclick = () => setSubChart('ATR');\r\n            document.getElementById('tab-ao').onclick = () => setSubChart('AO');\r\n            document.getElementById('tab-none').onclick = () => setSubChart('OFF');\r\n\r\n            function setSubChart(type) {\r\n                activeSubChart = type;\r\n                const btns = ['tab-rsi', 'tab-macd', 'tab-stoch', 'tab-atr', 'tab-ao', 'tab-none'].map(id => document.getElementById(id));\r\n                const colors = { 'RSI': 'rgba(168, 85, 247,', 'MACD': 'rgba(74, 222, 128,', 'STOCH': 'rgba(251, 191, 36,', 'ATR': 'rgba(56, 189, 248,', 'AO': 'rgba(244, 114, 182,', 'OFF': 'rgba(239, 83, 80,' };\r\n\r\n                btns.forEach(btn => { btn.style.borderColor = 'transparent'; btn.style.background = 'transparent'; btn.classList.remove('active'); });\r\n                ['rsi', 'macd', 'stoch', 'atr', 'ao'].forEach(id => document.getElementById(id + '-container').style.display = 'none');\r\n\r\n                if (type !== 'OFF') {\r\n                    const activeBtn = document.getElementById('tab-' + type.toLowerCase());\r\n                    const c = colors[type];\r\n                    activeBtn.style.borderColor = c + ' 0.4)'; activeBtn.style.background = c + ' 0.1)'; activeBtn.classList.add('active');\r\n                    document.getElementById(type.toLowerCase() + '-container').style.display = 'block';\r\n                } else {\r\n                    const offBtn = document.getElementById('tab-none');\r\n                    offBtn.style.borderColor = colors['OFF'] + ' 0.4)'; offBtn.style.background = colors['OFF'] + ' 0.1)'; offBtn.classList.add('active');\r\n                }\r\n                closeActiveDrawer();\r\n                renderSVG();\r\n            }\r\n\r\n            async function fetchOHLCData() {\r\n                const techOverlay = document.getElementById('tech-chart-loading');\r\n                const patternOverlay = document.getElementById('pattern-chart-loading');\r\n                if (techOverlay) techOverlay.style.display = 'flex';\r\n                if (patternOverlay) patternOverlay.style.display = 'flex';\r\n\r\n                try {\r\n                    const res = await fetch(`/api/chart-svg?ticker=${currentTicker}&timeframe=${currentTimeframe}`);\r\n                    let data = await res.json();\r\n\r\n                    if (techOverlay) techOverlay.style.display = 'none';\r\n                    if (patternOverlay) patternOverlay.style.display = 'none';\r\n\r\n                    if (data.error || !Array.isArray(data)) {\r\n                        document.getElementById('overlay-layer').innerHTML = `<text x=\"50%\" y=\"50%\" fill=\"#ef5350\" font-size=\"20\" font-weight=\"bold\" text-anchor=\"middle\">⚠️ Error: ${data.error || 'Invalid Data'}</text>`;\r\n                        return;\r\n                    }\r\n                    if (data.length > 0 && Array.isArray(data[0])) { data = data.map(d => ({ date: d[0], open: d[1], high: d[2], low: d[3], close: d[4], volume: d[5] })); }\r\n\r\n                    ohlcData = data;\r\n                    offset = Math.max(0, ohlcData.length - visibleCount);\r\n                    patternOffset = Math.max(0, ohlcData.length - patternVisibleCount);\r\n                    renderAll();\r\n                    updateTrendSuggestion();\r\n                    generateAITechnicalScript();\r\n                } catch (e) {\r\n                    if (techOverlay) techOverlay.style.display = 'none';\r\n                    if (patternOverlay) patternOverlay.style.display = 'none';\r\n                    document.getElementById('overlay-layer').innerHTML = `<text x=\"50%\" y=\"50%\" fill=\"#ef5350\" font-size=\"16\" font-weight=\"bold\" text-anchor=\"middle\">Network Error: ${e.message}</text>`;\r\n                }\r\n            }\r\n\r\n            function getPriceFromY(y, container) {\r\n                const state = container === svgContainer ? chartState : patternState;\r\n                return state.range === 0 ? 0 : state.minP + state.range * ((container.clientHeight - state.padB - y) / state.chartH);\r\n            }\r\n            function getIndexFromX(x, container) {\r\n                return (container === svgContainer ? offset : patternOffset) + Math.floor(x / (container === svgContainer ? chartState : patternState).candleW);\r\n            }\r\n\r\n            // Controls (Mouse & Touch)\r\n            function getLocalCoords(clientX, clientY, container) {\r\n                const isRotated = container.closest('.chart-card').classList.contains('rotate-mobile');\r\n                const rect = container.getBoundingClientRect();\r\n                if (isRotated) {\r\n                    const centerX = rect.left + rect.width / 2;\r\n                    const centerY = rect.top + rect.height / 2;\r\n                    const dx_screen = clientX - centerX;\r\n                    const dy_screen = clientY - centerY;\r\n                    const dx_local = dy_screen;\r\n                    const dy_local = -dx_screen;\r\n                    return { x: container.clientWidth / 2 + dx_local, y: container.clientHeight / 2 + dy_local };\r\n                }\r\n                return { x: clientX - rect.left, y: clientY - rect.top };\r\n            }\r\n\r\n            const handleWheel = (e, container) => {\r\n                const isRotated = container.closest('.chart-card').classList.contains('rotate-mobile');\r\n                let deltaX = isRotated ? e.deltaY : e.deltaX;\r\n                let deltaY = isRotated ? -e.deltaX : e.deltaY;\r\n\r\n                const isMain = container === svgContainer;\r\n                let currentVis = isMain ? visibleCount : patternVisibleCount;\r\n                let currentOff = isMain ? offset : patternOffset;\r\n                let currentDrag = isMain ? dragAccumulator : patternDragAccumulator;\r\n\r\n                if (Math.abs(deltaX) > Math.abs(deltaY)) {\r\n                    e.preventDefault(); currentDrag -= deltaX;\r\n                    const candleW = (container.clientWidth - 55) / currentVis;\r\n                    const moves = Math.trunc(currentDrag / candleW);\r\n                    if (moves !== 0) {\r\n                        currentOff = Math.min(Math.max(currentOff - moves, 0), ohlcData.length - currentVis);\r\n                        currentDrag -= (moves * candleW);\r\n                        if (isMain) { offset = currentOff; dragAccumulator = currentDrag; renderSVG(); }\r\n                        else { patternOffset = currentOff; patternDragAccumulator = currentDrag; renderPatternChart(); }\r\n                    }\r\n                    return;\r\n                }\r\n\r\n                if (e.ctrlKey || e.metaKey) {\r\n                    e.preventDefault(); const delta = Math.sign(deltaY);\r\n                    const oldVis = currentVis;\r\n                    currentVis = Math.min(Math.max(currentVis + (delta * Math.ceil(currentVis * 0.15)), 10), ohlcData.length);\r\n                    currentOff = Math.min(Math.max(currentOff + Math.floor((oldVis - currentVis) / 2), 0), ohlcData.length - currentVis);\r\n                    if (isMain) { offset = currentOff; visibleCount = currentVis; renderSVG(); }\r\n                    else { patternOffset = currentOff; patternVisibleCount = currentVis; renderPatternChart(); }\r\n                }\r\n            };\r\n\r\n            svgContainer.addEventListener('wheel', (e) => handleWheel(e, svgContainer), { passive: false });\r\n            patternContainer.addEventListener('wheel', (e) => handleWheel(e, patternContainer), { passive: false });\r\n\r\n            // Double Click to Reset Vertical Shifts\r\n            svgContainer.ondblclick = () => { verticalScrollShift = 0; renderSVG(); };\r\n            patternContainer.ondblclick = () => { patternVerticalScrollShift = 0; renderPatternChart(); };\r\n\r\n            // Touch Panning & Pinch-to-Zoom\r\n            chartContainers.forEach(container => {\r\n                let tStartX = 0, tStartY = 0;\r\n                let initialTouchDist = 0;\r\n                let initialVisCount = 0;\r\n\r\n                container.addEventListener('touchstart', (e) => {\r\n                    if (e.touches.length === 1) {\r\n                        const coords = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);\r\n                        tStartX = coords.x;\r\n                        tStartY = coords.y;\r\n                        if (container === svgContainer) dragAccumulator = 0; else patternDragAccumulator = 0;\r\n                    } else if (e.touches.length === 2) {\r\n                        const t1 = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);\r\n                        const t2 = getLocalCoords(e.touches[1].clientX, e.touches[1].clientY, container);\r\n                        initialTouchDist = Math.hypot(t1.x - t2.x, t1.y - t2.y);\r\n                        initialVisCount = container === svgContainer ? visibleCount : patternVisibleCount;\r\n                    }\r\n                }, { passive: true });\r\n\r\n                container.addEventListener('touchmove', (e) => {\r\n                    const isMain = container === svgContainer;\r\n\r\n                    if (e.touches.length === 1 && activeTool === 'pan') {\r\n                        const coords = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);\r\n                        const dx = coords.x - tStartX;\r\n                        const dy = coords.y - tStartY;\r\n\r\n                        if (Math.abs(dx) > Math.abs(dy)) {\r\n                            e.preventDefault();\r\n                            tStartX = coords.x;\r\n                            tStartY = coords.y;\r\n\r\n                            let cVis = isMain ? visibleCount : patternVisibleCount;\r\n                            let cOff = isMain ? offset : patternOffset;\r\n                            let cDrag = isMain ? dragAccumulator : patternDragAccumulator;\r\n\r\n                            cDrag += dx;\r\n                            const cW = (container.clientWidth - 55) / cVis;\r\n                            const moves = Math.trunc(cDrag / cW);\r\n                            if (moves !== 0) {\r\n                                cOff = Math.min(Math.max(cOff - moves, 0), ohlcData.length - cVis);\r\n                                cDrag -= (moves * cW);\r\n                                if (isMain) { offset = cOff; dragAccumulator = cDrag; renderSVG(); }\r\n                                else { patternOffset = cOff; patternDragAccumulator = cDrag; renderPatternChart(); }\r\n                            }\r\n                        }\r\n                    } else if (e.touches.length === 2 && initialTouchDist > 0) {\r\n                        e.preventDefault();\r\n                        const t1 = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);\r\n                        const t2 = getLocalCoords(e.touches[1].clientX, e.touches[1].clientY, container);\r\n                        const dist = Math.hypot(t1.x - t2.x, t1.y - t2.y);\r\n\r\n                        if (dist > 10) {\r\n                            const scale = dist / initialTouchDist;\r\n                            const oldVis = isMain ? visibleCount : patternVisibleCount;\r\n                            let newVis = Math.round(initialVisCount / scale);\r\n                            newVis = Math.min(Math.max(newVis, 10), ohlcData.length);\r\n\r\n                            if (newVis !== oldVis) {\r\n                                if (isMain) {\r\n                                    offset = Math.min(Math.max(offset + Math.floor((oldVis - newVis) / 2), 0), ohlcData.length - newVis);\r\n                                    visibleCount = newVis;\r\n                                    renderSVG();\r\n                                } else {\r\n                                    patternOffset = Math.min(Math.max(patternOffset + Math.floor((oldVis - newVis) / 2), 0), ohlcData.length - newVis);\r\n                                    patternVisibleCount = newVis;\r\n                                    renderPatternChart();\r\n                                }\r\n                            }\r\n                        }\r\n                    }\r\n                }, { passive: false });\r\n\r\n                container.addEventListener('touchend', (e) => {\r\n                    if (e.touches.length < 2) {\r\n                        initialTouchDist = 0;\r\n                    }\r\n                }, { passive: true });\r\n            });\r\n\r\n            // Mouse Panning & Manual Drawing\r\n            let isDragging = false, lastMouseX = 0, lastMouseY = 0, activeDragContainer = null;\r\n\r\n            chartContainers.forEach(container => {\r\n                container.onmousedown = (e) => {\r\n                    const coords = getLocalCoords(e.clientX, e.clientY, container);\r\n                    const mx = coords.x, my = coords.y;\r\n                    if (activeTool === 'pan') {\r\n                        isDragging = true;\r\n                        lastMouseX = coords.x;\r\n                        lastMouseY = coords.y;\r\n                        if (container === svgContainer) dragAccumulator = 0; else patternDragAccumulator = 0;\r\n                        container.style.cursor = 'grabbing'; activeDragContainer = container;\r\n                    } else {\r\n                        if (activeTool === 'hz') { drawnLines.push({ type: 'horizontal', price: getPriceFromY(my, container) }); renderAll(); }\r\n                        else if (activeTool === 'trend') { isDragging = true; const sIdx = getIndexFromX(mx, container), sPr = getPriceFromY(my, container); tempTrendline = { type: 'trend', startIdx: sIdx, startPrice: sPr, endIdx: sIdx, endPrice: sPr }; activeDragContainer = container; }\r\n                        else if (activeTool === 'fib') { isDragging = true; const sIdx = getIndexFromX(mx, container), sPr = getPriceFromY(my, container); tempFib = { type: 'fib', startIdx: sIdx, startPrice: sPr, endIdx: sIdx, endPrice: sPr }; activeDragContainer = container; }\r\n                    }\r\n                };\r\n\r\n                container.onmousemove = (e) => {\r\n                    const coords = getLocalCoords(e.clientX, e.clientY, container);\r\n                    const mx = coords.x, my = coords.y;\r\n                    if (container === svgContainer) { document.getElementById('cross-h').setAttribute('y1', my); document.getElementById('cross-h').setAttribute('y2', my); document.getElementById('cross-v').setAttribute('x1', mx); document.getElementById('cross-v').setAttribute('x2', mx); }\r\n                    else if (container === patternContainer) { document.getElementById('cross-h-pat').setAttribute('y1', my); document.getElementById('cross-h-pat').setAttribute('y2', my); document.getElementById('cross-v-pat').setAttribute('x1', mx); document.getElementById('cross-v-pat').setAttribute('x2', mx); }\r\n\r\n                    if (isDragging && activeDragContainer === container) {\r\n                        const isMain = container === svgContainer;\r\n                        if (activeTool === 'pan') {\r\n                            let cVis = isMain ? visibleCount : patternVisibleCount;\r\n                            let cOff = isMain ? offset : patternOffset;\r\n                            let cDrag = isMain ? dragAccumulator : patternDragAccumulator;\r\n\r\n                            const dx = coords.x - lastMouseX;\r\n                            lastMouseX = coords.x;\r\n                            lastMouseY = coords.y;\r\n\r\n                            cDrag += dx;\r\n                            const cW = (container.clientWidth - 55) / cVis;\r\n                            const moves = Math.trunc(cDrag / cW);\r\n                            if (moves !== 0) {\r\n                                cOff = Math.min(Math.max(cOff - moves, 0), ohlcData.length - cVis); cDrag -= (moves * cW);\r\n                                if (isMain) { offset = cOff; dragAccumulator = cDrag; renderSVG(); } else { patternOffset = cOff; patternDragAccumulator = cDrag; renderPatternChart(); }\r\n                            }\r\n                        } else {\r\n                            if (activeTool === 'trend' && tempTrendline) { tempTrendline.endIdx = getIndexFromX(mx, container); tempTrendline.endPrice = getPriceFromY(my, container); renderAll(); }\r\n                            else if (activeTool === 'fib' && tempFib) { tempFib.endIdx = getIndexFromX(mx, container); tempFib.endPrice = getPriceFromY(my, container); renderAll(); }\r\n                        }\r\n                    }\r\n                };\r\n            });\r\n\r\n            window.addEventListener('mouseup', () => {\r\n                if (isDragging && activeTool === 'trend' && tempTrendline) { drawnLines.push(tempTrendline); tempTrendline = null; renderAll(); }\r\n                if (isDragging && activeTool === 'fib' && tempFib) { drawnLines.push(tempFib); tempFib = null; renderAll(); }\r\n                isDragging = false; activeDragContainer = null;\r\n                const cStyle = activeTool === 'pan' ? 'grab' : 'crosshair';\r\n                svgContainer.style.cursor = cStyle; patternContainer.style.cursor = cStyle;\r\n            });\r\n\r\n            function renderAll() { renderSVG(); renderPatternChart(); }\r\n\r\n            // Render Logic\r\n            function renderSVG() {\r\n                if (!ohlcData.length) return;\r\n                const w = svgContainer.clientWidth, h = svgContainer.clientHeight;\r\n                chartState.padR = 55; chartState.padB = 40; chartState.padT = 20;\r\n                const chartW = w - chartState.padR; chartState.chartH = h - chartState.padB - chartState.padT;\r\n                const displayData = ohlcData.slice(offset, offset + visibleCount);\r\n                if (displayData.length === 0) return;\r\n\r\n                let highs = displayData.map(d => d.high), lows = displayData.map(d => d.low);\r\n                if (showBB) { displayData.forEach(d => { if (d.bbUpper) highs.push(d.bbUpper); if (d.bbLower) lows.push(d.bbLower); }); }\r\n\r\n                chartState.maxP = Math.max(...highs) + verticalScrollShift;\r\n                chartState.minP = Math.min(...lows) + verticalScrollShift;\r\n                chartState.range = chartState.maxP - chartState.minP || 1;\r\n                chartState.candleW = chartW / displayData.length;\r\n                const getY = (p) => (h - chartState.padB) - ((p - chartState.minP) / chartState.range) * chartState.chartH;\r\n\r\n                let gridHtml = '';\r\n                for (let i = 0; i <= 8; i++) {\r\n                    const p = chartState.minP + (chartState.range * (i / 8));\r\n                    gridHtml += `<line x1=\"0\" y1=\"${getY(p)}\" x2=\"${chartW}\" y2=\"${getY(p)}\" stroke=\"#1e293b\" stroke-width=\"1\"/><text x=\"${chartW + 8}\" y=\"${getY(p) + 4}\" class=\"price-text\">${p.toFixed(2)}</text>`;\r\n                }\r\n                document.getElementById('grid-layer').innerHTML = gridHtml;\r\n\r\n                let candleHtml = '', volHtml = '', timeHtml = '', signalHtml = '';\r\n                const maxV = Math.max(...displayData.map(d => d.volume || 0)) || 1;\r\n                const timeStep = Math.ceil(visibleCount / 8);\r\n\r\n                displayData.forEach((d, i) => {\r\n                    const x = i * chartState.candleW, midX = x + (chartState.candleW / 2);\r\n                    if (i % timeStep === 0) timeHtml += `<text x=\"${midX}\" y=\"${h - 15}\" class=\"time-text\">${d.date}</text>`;\r\n\r\n                    if (d.is_future) return;\r\n\r\n                    const color = d.close >= d.open ? \"#26a69a\" : \"#ef5350\";\r\n                    const vH = (d.volume / maxV) * 60;\r\n                    volHtml += `<rect x=\"${x + 2}\" y=\"${h - chartState.padB - vH}\" width=\"${chartState.candleW - 4}\" height=\"${vH}\" fill=\"${color}\" />`;\r\n\r\n                    const bodyT = getY(Math.max(d.open, d.close)), bodyB = getY(Math.min(d.open, d.close));\r\n                    candleHtml += `<line x1=\"${midX}\" y1=\"${getY(d.high)}\" x2=\"${midX}\" y2=\"${getY(d.low)}\" stroke=\"${color}\" stroke-width=\"1.5\" />`;\r\n                    candleHtml += `<rect x=\"${x + (chartState.candleW * 0.15)}\" y=\"${bodyT}\" width=\"${chartState.candleW * 0.7}\" height=\"${Math.max(Math.abs(bodyT - bodyB), 1.5)}\" fill=\"${color}\" />`;\r\n\r\n                    if (showCandleSignals && d.candle_signal && d.candle_signal.signal !== 'neutral') {\r\n                        const isBull = d.candle_signal.signal === 'bullish';\r\n                        const sigY = isBull ? getY(d.low) + 15 : getY(d.high) - 5;\r\n                        const sigColor = isBull ? '#4ade80' : '#ef5350';\r\n                        signalHtml += `<text x=\"${midX}\" y=\"${sigY}\" fill=\"${sigColor}\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">${isBull ? '▲' : '▼'}</text>`;\r\n                        signalHtml += `<text x=\"${midX}\" y=\"${isBull ? sigY + 12 : sigY - 12}\" fill=\"${sigColor}\" font-size=\"9\" font-family=\"monospace\" text-anchor=\"middle\">${d.candle_signal.name}</text>`;\r\n                    }\r\n                });\r\n\r\n                document.getElementById('candle-layer').innerHTML = candleHtml;\r\n                document.getElementById('volume-layer').innerHTML = volHtml;\r\n                document.getElementById('time-layer').innerHTML = timeHtml;\r\n                document.getElementById('signal-layer').innerHTML = signalHtml;\r\n\r\n                let overlayHtml = '';\r\n                const drawPath = (dataKey, strokeColor, width, dash = \"\") => {\r\n                    let pathD = \"\", isFirst = true;\r\n                    const keys = dataKey.split('.');\r\n                    displayData.forEach((d, i) => {\r\n                        let val = d;\r\n                        keys.forEach(k => { if (val) val = val[k]; });\r\n                        if (val != null) {\r\n                            const pt = `${i * chartState.candleW + (chartState.candleW / 2)},${getY(val)}`; pathD += isFirst ? `M ${pt} ` : `L ${pt} `; isFirst = false;\r\n                        }\r\n                    });\r\n                    if (pathD) overlayHtml += `<path d=\"${pathD}\" fill=\"none\" stroke=\"${strokeColor}\" stroke-width=\"${width}\" stroke-dasharray=\"${dash}\" stroke-linejoin=\"round\" />`;\r\n                };\r\n\r\n                const drawSplitIndicatorPath = (dataKey, defaultColor, defaultWidth = 2) => {\r\n                    let histPoints = [];\r\n                    let futurePoints = [];\r\n                    let lastHistPoint = null;\r\n\r\n                    displayData.forEach((d, i) => {\r\n                        const val = d[dataKey];\r\n                        if (val != null) {\r\n                            const x = i * chartState.candleW + (chartState.candleW / 2);\r\n                            const y = getY(val);\r\n                            if (d.is_future) {\r\n                                futurePoints.push(`${x},${y}`);\r\n                            } else {\r\n                                histPoints.push(`${x},${y}`);\r\n                                lastHistPoint = `${x},${y}`;\r\n                            }\r\n                        }\r\n                    });\r\n\r\n                    if (histPoints.length > 0) {\r\n                        let pathD = \"M \" + histPoints.join(\" L \");\r\n                        overlayHtml += `<path d=\"${pathD}\" fill=\"none\" stroke=\"${defaultColor}\" stroke-width=\"${defaultWidth}\" stroke-linejoin=\"round\" />`;\r\n                    }\r\n\r\n                    if (futurePoints.length > 0) {\r\n                        const histSub = displayData.filter(d => !d.is_future && d[dataKey] != null);\r\n                        const futSub = displayData.filter(d => d.is_future && d[dataKey] != null);\r\n                        let trendColor = \"#8E9BAE\";\r\n                        if (histSub.length > 0 && futSub.length > 0) {\r\n                            const startVal = histSub[histSub.length - 1][dataKey];\r\n                            const endVal = futSub[futSub.length - 1][dataKey];\r\n                            const diff = endVal - startVal;\r\n                            const threshold = startVal * 0.0002;\r\n                            if (diff > threshold) {\r\n                                trendColor = \"#26a69a\";\r\n                            } else if (diff < -threshold) {\r\n                                trendColor = \"#ef5350\";\r\n                            }\r\n                        }\r\n\r\n                        let pathPoints = [];\r\n                        if (lastHistPoint) {\r\n                            pathPoints.push(lastHistPoint);\r\n                        }\r\n                        pathPoints = pathPoints.concat(futurePoints);\r\n\r\n                        if (pathPoints.length > 0) {\r\n                            let pathD = \"M \" + pathPoints.join(\" L \");\r\n                            overlayHtml += `<path d=\"${pathD}\" fill=\"none\" stroke=\"${trendColor}\" stroke-width=\"${defaultWidth + 0.5}\" stroke-dasharray=\"4,4\" stroke-linejoin=\"round\" />`;\r\n                        }\r\n                    }\r\n                };\r\n\r\n                if (showSMA20) drawSplitIndicatorPath('sma20', '#38bdf8', 2);\r\n                if (showSMA50) drawSplitIndicatorPath('sma50', '#f59e0b', 2);\r\n                if (showEMA9) drawSplitIndicatorPath('ema9', '#22d3ee', 1.5);\r\n                if (showEMA21) drawSplitIndicatorPath('ema21', '#818cf8', 1.5);\r\n                if (showVWAP) drawPath('vwap', '#fbbf24', 2, \"4,4\");\r\n\r\n                if (showIchimoku) {\r\n                    drawPath('ichimoku.tenkan', '#38bdf8', 1);\r\n                    drawPath('ichimoku.kijun', '#f59e0b', 1);\r\n                    drawPath('ichimoku.senkou_a', '#4ade80', 1);\r\n                    drawPath('ichimoku.senkou_b', '#ef5350', 1);\r\n\r\n                    let cloudA = [], cloudB = [];\r\n                    displayData.forEach((d, i) => {\r\n                        if (d.ichimoku && d.ichimoku.senkou_a != null && d.ichimoku.senkou_b != null) {\r\n                            const x = i * chartState.candleW + (chartState.candleW / 2);\r\n                            cloudA.push(`${x},${getY(d.ichimoku.senkou_a)}`);\r\n                            cloudB.push(`${x},${getY(d.ichimoku.senkou_b)}`);\r\n                        }\r\n                    });\r\n                    if (cloudA.length > 0) {\r\n                        const rB = [...cloudB].reverse();\r\n                        overlayHtml += `<path d=\"M ${cloudA[0]} L ${cloudA.join(' L ')} L ${rB[0]} L ${rB.join(' L ')} Z\" fill=\"rgba(74, 222, 128, 0.12)\" stroke=\"none\" />`;\r\n                    }\r\n                }\r\n\r\n                if (showSuperTrend) {\r\n                    let pathD = \"\", isFirst = true, currColor = null;\r\n                    displayData.forEach((d, i) => {\r\n                        if (d.supertrend && d.supertrend.val != null) {\r\n                            const pt = `${i * chartState.candleW + (chartState.candleW / 2)},${getY(d.supertrend.val)}`;\r\n                            const ptColor = d.supertrend.dir === 1 ? '#4ade80' : '#ef5350';\r\n                            if (currColor !== ptColor) {\r\n                                if (!isFirst) overlayHtml += `<path d=\"${pathD}\" fill=\"none\" stroke=\"${currColor}\" stroke-width=\"2.5\" stroke-linejoin=\"round\" />`;\r\n                                pathD = `M ${pt} `;\r\n                                currColor = ptColor;\r\n                                isFirst = false;\r\n                            } else {\r\n                                pathD += `L ${pt} `;\r\n                            }\r\n                        }\r\n                    });\r\n                    if (pathD) overlayHtml += `<path d=\"${pathD}\" fill=\"none\" stroke=\"${currColor}\" stroke-width=\"2.5\" stroke-linejoin=\"round\" />`;\r\n                }\r\n\r\n                if (showFVG) {\r\n                    displayData.forEach((d, i) => {\r\n                        if (d.fvg) {\r\n                            const x = (i - 2) * chartState.candleW;\r\n                            const yTop = getY(d.fvg.top);\r\n                            const yBot = getY(d.fvg.bottom);\r\n                            const height = Math.abs(yBot - yTop);\r\n                            const color = d.fvg.type === 'bullish' ? 'rgba(74, 222, 128, 0.15)' : 'rgba(239, 83, 80, 0.15)';\r\n                            const strokeColor = d.fvg.type === 'bullish' ? 'rgba(74, 222, 128, 0.4)' : 'rgba(239, 83, 80, 0.4)';\r\n                            if (height > 0) {\r\n                                overlayHtml += `<rect x=\"${x}\" y=\"${Math.min(yTop, yBot)}\" width=\"${chartState.candleW * 3}\" height=\"${height}\" fill=\"${color}\" stroke=\"${strokeColor}\" stroke-dasharray=\"2,2\" stroke-width=\"1\" />`;\r\n                                overlayHtml += `<text x=\"${x + chartState.candleW * 1.5}\" y=\"${Math.min(yTop, yBot) + height / 2 + 4}\" fill=\"${strokeColor}\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">FVG</text>`;\r\n                            }\r\n                        }\r\n                    });\r\n                }\r\n                if (showBB) {\r\n                    let uP = [], lP = [];\r\n                    displayData.forEach((d, i) => {\r\n                        if (d.bbUpper != null && d.bbLower != null) {\r\n                            const x = i * chartState.candleW + (chartState.candleW / 2); uP.push(`${x},${getY(d.bbUpper)}`); lP.push(`${x},${getY(d.bbLower)}`);\r\n                        }\r\n                    });\r\n                    if (uP.length > 0) {\r\n                        overlayHtml += `<path d=\"M ${uP.join(' L ')}\" fill=\"none\" stroke=\"#00E5FF\" stroke-width=\"1\" opacity=\"0.5\" stroke-dasharray=\"3\"/>`;\r\n                        overlayHtml += `<path d=\"M ${lP.join(' L ')}\" fill=\"none\" stroke=\"#00E5FF\" stroke-width=\"1\" opacity=\"0.5\" stroke-dasharray=\"3\"/>`;\r\n                        const rL = [...lP].reverse();\r\n                        overlayHtml += `<path d=\"M ${uP[0]} L ${uP.join(' L ')} L ${rL[0]} L ${rL.join(' L ')} Z\" fill=\"rgba(0, 229, 255, 0.08)\" stroke=\"none\" />`;\r\n                    }\r\n                }\r\n                if (showPSAR) {\r\n                    displayData.forEach((d, i) => {\r\n                        if (d.psar != null) {\r\n                            const x = i * chartState.candleW + (chartState.candleW / 2); const isBull = d.psar < d.close; const dotColor = isBull ? \"#26a69a\" : \"#ef5350\";\r\n                            overlayHtml += `<circle cx=\"${x}\" cy=\"${getY(d.psar)}\" r=\"2.5\" fill=\"${dotColor}\" />`;\r\n                        }\r\n                    });\r\n                }\r\n\r\n                if (showVPVR && chartState.range > 0) {\r\n                    const binCount = 24; let bins = new Array(binCount).fill(0); let binSize = chartState.range / binCount;\r\n                    displayData.forEach(d => {\r\n                        let startBin = Math.floor((d.low - chartState.minP) / binSize), endBin = Math.floor((d.high - chartState.minP) / binSize);\r\n                        startBin = Math.max(0, Math.min(binCount - 1, startBin)); endBin = Math.max(0, Math.min(binCount - 1, endBin));\r\n                        let volPerBin = (d.volume || 1) / ((endBin - startBin) + 1);\r\n                        for (let b = startBin; b <= endBin; b++) bins[b] += volPerBin;\r\n                    });\r\n                    let maxBinVol = Math.max(...bins) || 1, pocBin = bins.indexOf(maxBinVol);\r\n                    bins.forEach((vol, b) => {\r\n                        if (vol === 0) return;\r\n                        let barW = (vol / maxBinVol) * (chartW * 0.3), yTop = getY(chartState.minP + ((b + 1) * binSize)), barH = getY(chartState.minP + (b * binSize)) - yTop;\r\n                        let color = (b === pocBin) ? 'rgba(239, 83, 80, 0.4)' : 'rgba(56, 189, 248, 0.15)', stroke = (b === pocBin) ? 'rgba(239, 83, 80, 0.8)' : 'rgba(56, 189, 248, 0.4)';\r\n                        overlayHtml += `<rect x=\"${chartW - barW}\" y=\"${yTop}\" width=\"${barW}\" height=\"${barH}\" fill=\"${color}\" stroke=\"${stroke}\" stroke-width=\"1\" />`;\r\n                        if (b === pocBin) {\r\n                            let pocY = yTop + (barH / 2);\r\n                            overlayHtml += `<line x1=\"0\" y1=\"${pocY}\" x2=\"${chartW}\" y2=\"${pocY}\" stroke=\"#ef5350\" stroke-width=\"1.5\" stroke-dasharray=\"4\" /><text x=\"5\" y=\"${pocY - 5}\" fill=\"#ef5350\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\">POC</text>`;\r\n                        }\r\n                    });\r\n                }\r\n\r\n                document.getElementById('overlay-layer').innerHTML = overlayHtml;\r\n\r\n                let drawHtml = '';\r\n                const renderDrawing = (l) => {\r\n                    if (l.type === 'horizontal') {\r\n                        const y = getY(l.price);\r\n                        drawHtml += `<line x1=\"0\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"#a855f7\" stroke-width=\"2\" stroke-dasharray=\"4\"/><rect x=\"${chartW}\" y=\"${y - 10}\" width=\"80\" height=\"20\" fill=\"#a855f7\" /><text x=\"${chartW + 5}\" y=\"${y + 4}\" fill=\"#000\" font-size=\"11\" font-weight=\"bold\">${l.price.toFixed(2)}</text>`;\r\n                    } else if (l.type === 'trend') {\r\n                        drawHtml += `<line x1=\"${(l.startIdx - offset) * chartState.candleW + chartState.candleW / 2}\" y1=\"${getY(l.startPrice)}\" x2=\"${(l.endIdx - offset) * chartState.candleW + chartState.candleW / 2}\" y2=\"${getY(l.endPrice)}\" stroke=\"#a855f7\" stroke-width=\"2\" />`;\r\n                    } else if (l.type === 'fib') {\r\n                        const startX = (l.startIdx - offset) * chartState.candleW + chartState.candleW / 2, diff = l.endPrice - l.startPrice;\r\n                        const levels = [{ ratio: 0, color: '#787b86' }, { ratio: 0.236, color: '#f44336' }, { ratio: 0.382, color: '#81c784' }, { ratio: 0.5, color: '#4caf50' }, { ratio: 0.618, color: '#009688' }, { ratio: 0.786, color: '#64b5f6' }, { ratio: 1, color: '#787b86' }];\r\n                        drawHtml += `<line x1=\"${startX}\" y1=\"${getY(l.startPrice)}\" x2=\"${(l.endIdx - offset) * chartState.candleW + chartState.candleW / 2}\" y2=\"${getY(l.endPrice)}\" stroke=\"#ffffff\" stroke-width=\"1\" stroke-dasharray=\"2\" opacity=\"0.3\" />`;\r\n                        levels.forEach(level => {\r\n                            const price = l.startPrice + (diff * level.ratio), y = getY(price);\r\n                            drawHtml += `<line x1=\"${startX}\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"${level.color}\" stroke-width=\"1.5\" /><text x=\"${startX + 5}\" y=\"${y - 4}\" fill=\"${level.color}\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\">${(level.ratio * 100).toFixed(1)}% (${price.toFixed(2)})</text>`;\r\n                        });\r\n                    }\r\n                };\r\n\r\n                drawnLines.forEach(renderDrawing);\r\n                if (tempTrendline && activeDragContainer === svgContainer) renderDrawing(tempTrendline);\r\n                if (tempFib && activeDragContainer === svgContainer) renderDrawing(tempFib);\r\n                document.getElementById('drawing-layer').innerHTML = drawHtml;\r\n\r\n                if (activeSubChart === 'RSI') renderRSI();\r\n                if (activeSubChart === 'MACD') renderMACD();\r\n                if (activeSubChart === 'STOCH') renderStoch();\r\n                if (activeSubChart === 'ATR') renderATR();\r\n                if (activeSubChart === 'AO') renderAO();\r\n            }\r\n\r\n            function renderRSI() {\r\n                if (!ohlcData.length) return;\r\n                const w = document.getElementById('rsi-container').clientWidth, h = document.getElementById('rsi-container').clientHeight, chartW = w - 80, chartH = h - 40;\r\n                const displayData = ohlcData.slice(offset, offset + visibleCount);\r\n                if (displayData.length === 0) return;\r\n\r\n                const candleW = chartW / displayData.length; const getY = (val) => (h - 20) - (val / 100) * chartH;\r\n                document.getElementById('rsi-grid-layer').innerHTML = `\r\n        <line x1=\"0\" y1=\"${getY(70)}\" x2=\"${chartW}\" y2=\"${getY(70)}\" stroke=\"#ef5350\" stroke-width=\"1\" stroke-dasharray=\"4\"/><text x=\"${chartW + 8}\" y=\"${getY(70) + 4}\" fill=\"#ef5350\" font-size=\"10\" font-family=\"monospace\">70</text>\r\n        <line x1=\"0\" y1=\"${getY(50)}\" x2=\"${chartW}\" y2=\"${getY(50)}\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"2\"/>\r\n        <line x1=\"0\" y1=\"${getY(30)}\" x2=\"${chartW}\" y2=\"${getY(30)}\" stroke=\"#26a69a\" stroke-width=\"1\" stroke-dasharray=\"4\"/><text x=\"${chartW + 8}\" y=\"${getY(30) + 4}\" fill=\"#26a69a\" font-size=\"10\" font-family=\"monospace\">30</text>\r\n        <rect x=\"0\" y=\"${getY(70)}\" width=\"${chartW}\" height=\"${getY(30) - getY(70)}\" fill=\"rgba(168, 85, 247, 0.05)\" />`;\r\n\r\n                let pathD = \"\", isFirst = true;\r\n                displayData.forEach((d, i) => { if (d.rsi != null) { const pt = `${i * candleW + (candleW / 2)},${getY(d.rsi)}`; pathD += isFirst ? `M ${pt} ` : `L ${pt} `; isFirst = false; } });\r\n                document.getElementById('rsi-line-layer').innerHTML = pathD ? `<path d=\"${pathD}\" fill=\"none\" stroke=\"#a855f7\" stroke-width=\"2\" stroke-linejoin=\"round\" />` : \"\";\r\n            }\r\n\r\n            function renderMACD() {\r\n                if (!ohlcData.length) return;\r\n                const w = document.getElementById('macd-container').clientWidth, h = document.getElementById('macd-container').clientHeight, chartW = w - 80, chartH = h - 40;\r\n                const displayData = ohlcData.slice(offset, offset + visibleCount);\r\n                if (displayData.length === 0) return;\r\n\r\n                let maxAbs = 0; displayData.forEach(d => { if (d.macd != null) maxAbs = Math.max(maxAbs, Math.abs(d.macd), Math.abs(d.signal), Math.abs(d.hist)); }); maxAbs = maxAbs || 1;\r\n\r\n                const candleW = chartW / displayData.length; const getY = (val) => (h / 2) - (val / maxAbs) * (chartH / 2);\r\n                document.getElementById('macd-grid-layer').innerHTML = `<line x1=\"0\" y1=\"${h / 2}\" x2=\"${chartW}\" y2=\"${h / 2}\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"2\"/><text x=\"${chartW + 8}\" y=\"${(h / 2) + 4}\" fill=\"#64748b\" font-size=\"10\" font-family=\"monospace\">0.0</text>`;\r\n\r\n                let histHtml = '';\r\n                displayData.forEach((d, i) => {\r\n                    if (d.hist != null) {\r\n                        const color = d.hist >= 0 ? \"rgba(38, 166, 154, 0.6)\" : \"rgba(239, 83, 80, 0.6)\", yStart = d.hist >= 0 ? getY(d.hist) : h / 2, barH = Math.abs(getY(d.hist) - (h / 2));\r\n                        histHtml += `<rect x=\"${i * candleW + 2}\" y=\"${yStart}\" width=\"${candleW - 4}\" height=\"${barH}\" fill=\"${color}\" />`;\r\n                    }\r\n                });\r\n                document.getElementById('macd-hist-layer').innerHTML = histHtml;\r\n\r\n                let macdPath = \"\", signalPath = \"\", isFirstM = true, isFirstS = true;\r\n                displayData.forEach((d, i) => {\r\n                    const x = i * candleW + (candleW / 2);\r\n                    if (d.macd != null) { const pt = `${x},${getY(d.macd)}`; macdPath += isFirstM ? `M ${pt} ` : `L ${pt} `; isFirstM = false; }\r\n                    if (d.signal != null) { const pt = `${x},${getY(d.signal)}`; signalPath += isFirstS ? `M ${pt} ` : `L ${pt} `; isFirstS = false; }\r\n                });\r\n                let lineHtml = \"\";\r\n                if (macdPath) lineHtml += `<path d=\"${macdPath}\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />`;\r\n                if (signalPath) lineHtml += `<path d=\"${signalPath}\" fill=\"none\" stroke=\"#f59e0b\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />`;\r\n                document.getElementById('macd-line-layer').innerHTML = lineHtml;\r\n            }\r\n\r\n            function renderStoch() {\r\n                if (!ohlcData.length) return;\r\n                const w = document.getElementById('stoch-container').clientWidth, h = document.getElementById('stoch-container').clientHeight, chartW = w - 80, chartH = h - 40;\r\n                const displayData = ohlcData.slice(offset, offset + visibleCount);\r\n                if (displayData.length === 0) return;\r\n\r\n                const candleW = chartW / displayData.length; const getY = (val) => (h - 20) - (val / 100) * chartH;\r\n                document.getElementById('stoch-grid-layer').innerHTML = `\r\n        <line x1=\"0\" y1=\"${getY(80)}\" x2=\"${chartW}\" y2=\"${getY(80)}\" stroke=\"#ef5350\" stroke-width=\"1\" stroke-dasharray=\"4\"/><text x=\"${chartW + 8}\" y=\"${getY(80) + 4}\" fill=\"#ef5350\" font-size=\"10\" font-family=\"monospace\">80</text>\r\n        <line x1=\"0\" y1=\"${getY(50)}\" x2=\"${chartW}\" y2=\"${getY(50)}\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"2\"/>\r\n        <line x1=\"0\" y1=\"${getY(20)}\" x2=\"${chartW}\" y2=\"${getY(20)}\" stroke=\"#26a69a\" stroke-width=\"1\" stroke-dasharray=\"4\"/><text x=\"${chartW + 8}\" y=\"${getY(20) + 4}\" fill=\"#26a69a\" font-size=\"10\" font-family=\"monospace\">20</text>\r\n        <rect x=\"0\" y=\"${getY(80)}\" width=\"${chartW}\" height=\"${getY(20) - getY(80)}\" fill=\"rgba(251, 191, 36, 0.05)\" />`;\r\n\r\n                let kPath = \"\", dPath = \"\", isFirstK = true, isFirstD = true;\r\n                displayData.forEach((d, i) => {\r\n                    const x = i * candleW + (candleW / 2);\r\n                    if (d.stoch && d.stoch.k != null) { const pt = `${x},${getY(d.stoch.k)}`; kPath += isFirstK ? `M ${pt} ` : `L ${pt} `; isFirstK = false; }\r\n                    if (d.stoch && d.stoch.d != null) { const pt = `${x},${getY(d.stoch.d)}`; dPath += isFirstD ? `M ${pt} ` : `L ${pt} `; isFirstD = false; }\r\n                });\r\n                let lineHtml = \"\";\r\n                if (kPath) lineHtml += `<path d=\"${kPath}\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />`;\r\n                if (dPath) lineHtml += `<path d=\"${dPath}\" fill=\"none\" stroke=\"#f59e0b\" stroke-width=\"1.5\" stroke-linejoin=\"round\" stroke-dasharray=\"2\" />`;\r\n                document.getElementById('stoch-line-layer').innerHTML = lineHtml;\r\n            }\r\n\r\n            function renderATR() {\r\n                if (!ohlcData.length) return;\r\n                const w = document.getElementById('atr-container').clientWidth, h = document.getElementById('atr-container').clientHeight, chartW = w - 80, chartH = h - 40;\r\n                const displayData = ohlcData.slice(offset, offset + visibleCount);\r\n                if (displayData.length === 0) return;\r\n\r\n                let minATR = Infinity, maxATR = -Infinity;\r\n                displayData.forEach(d => { if (d.atr != null) { minATR = Math.min(minATR, d.atr); maxATR = Math.max(maxATR, d.atr); } });\r\n                if (minATR === Infinity) { minATR = 0; maxATR = 1; }\r\n                const range = maxATR - minATR || 1;\r\n\r\n                const candleW = chartW / displayData.length; const getY = (val) => (h - 20) - ((val - minATR) / range) * chartH;\r\n\r\n                document.getElementById('atr-grid-layer').innerHTML = `\r\n        <line x1=\"0\" y1=\"${getY(maxATR)}\" x2=\"${chartW}\" y2=\"${getY(maxATR)}\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"2\"/><text x=\"${chartW + 8}\" y=\"${getY(maxATR) + 4}\" fill=\"#64748b\" font-size=\"10\" font-family=\"monospace\">${maxATR.toFixed(2)}</text>\r\n        <line x1=\"0\" y1=\"${getY(minATR)}\" x2=\"${chartW}\" y2=\"${getY(minATR)}\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"2\"/><text x=\"${chartW + 8}\" y=\"${getY(minATR) + 4}\" fill=\"#64748b\" font-size=\"10\" font-family=\"monospace\">${minATR.toFixed(2)}</text>`;\r\n\r\n                let pathD = \"\", isFirst = true;\r\n                displayData.forEach((d, i) => { if (d.atr != null) { const pt = `${i * candleW + (candleW / 2)},${getY(d.atr)}`; pathD += isFirst ? `M ${pt} ` : `L ${pt} `; isFirst = false; } });\r\n                document.getElementById('atr-line-layer').innerHTML = pathD ? `<path d=\"${pathD}\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"1.5\" stroke-linejoin=\"round\" />` : \"\";\r\n            }\r\n\r\n            function renderAO() {\r\n                if (!ohlcData.length) return;\r\n                const w = document.getElementById('ao-container').clientWidth, h = document.getElementById('ao-container').clientHeight, chartW = w - 80, chartH = h - 40;\r\n                const displayData = ohlcData.slice(offset, offset + visibleCount);\r\n                if (displayData.length === 0) return;\r\n\r\n                let maxAbs = 0; displayData.forEach(d => { if (d.ao != null) maxAbs = Math.max(maxAbs, Math.abs(d.ao)); }); maxAbs = maxAbs || 1;\r\n\r\n                const candleW = chartW / displayData.length; const getY = (val) => (h / 2) - (val / maxAbs) * (chartH / 2);\r\n                document.getElementById('ao-grid-layer').innerHTML = `<line x1=\"0\" y1=\"${h / 2}\" x2=\"${chartW}\" y2=\"${h / 2}\" stroke=\"#64748b\" stroke-width=\"1\" stroke-dasharray=\"2\"/><text x=\"${chartW + 8}\" y=\"${(h / 2) + 4}\" fill=\"#64748b\" font-size=\"10\" font-family=\"monospace\">0.0</text>`;\r\n\r\n                let histHtml = '';\r\n                for (let i = 0; i < displayData.length; i++) {\r\n                    const d = displayData[i];\r\n                    if (d.ao != null) {\r\n                        const prevAo = i > 0 && displayData[i - 1].ao != null ? displayData[i - 1].ao : 0;\r\n                        const isGrowing = Math.abs(d.ao) > Math.abs(prevAo);\r\n                        const isPositive = d.ao >= 0;\r\n\r\n                        let color = '';\r\n                        if (isPositive && isGrowing) color = '#4ade80'; // Green growing\r\n                        else if (isPositive && !isGrowing) color = '#22c55e'; // Green shrinking\r\n                        else if (!isPositive && isGrowing) color = '#ef4444'; // Red growing\r\n                        else color = '#f87171'; // Red shrinking\r\n\r\n                        const yStart = d.ao >= 0 ? getY(d.ao) : h / 2, barH = Math.abs(getY(d.ao) - (h / 2));\r\n                        histHtml += `<rect x=\"${i * candleW + 2}\" y=\"${yStart}\" width=\"${candleW - 4}\" height=\"${barH}\" fill=\"${color}\" />`;\r\n                    }\r\n                }\r\n                document.getElementById('ao-hist-layer').innerHTML = histHtml;\r\n            }\r\n\r\n            function renderPatternChart() {\r\n                if (!ohlcData.length) return;\r\n                const w = patternContainer.clientWidth, h = patternContainer.clientHeight;\r\n                patternState.padR = 55; patternState.padB = 40; patternState.padT = 20;\r\n                const chartW = w - patternState.padR; patternState.chartH = h - patternState.padB - patternState.padT;\r\n\r\n                const displayData = ohlcData.slice(patternOffset, patternOffset + patternVisibleCount);\r\n                if (displayData.length === 0) return;\r\n\r\n                let highs = displayData.map(d => d.high), lows = displayData.map(d => d.low);\r\n                patternState.maxP = Math.max(...highs) + patternVerticalScrollShift;\r\n                patternState.minP = Math.min(...lows) + patternVerticalScrollShift;\r\n                patternState.range = patternState.maxP - patternState.minP || 1;\r\n                patternState.candleW = chartW / displayData.length;\r\n                const getY = (p) => (h - patternState.padB) - ((p - patternState.minP) / patternState.range) * patternState.chartH;\r\n\r\n                let gridHtml = '';\r\n                for (let i = 0; i <= 5; i++) {\r\n                    const p = patternState.minP + (patternState.range * (i / 5));\r\n                    gridHtml += `<line x1=\"0\" y1=\"${getY(p)}\" x2=\"${chartW}\" y2=\"${getY(p)}\" stroke=\"#1e293b\" stroke-width=\"1\" stroke-dasharray=\"2\"/><text x=\"${chartW + 8}\" y=\"${getY(p) + 4}\" class=\"price-text\" fill=\"#fbbf24\">${p.toFixed(2)}</text>`;\r\n                }\r\n                document.getElementById('pattern-grid-layer').innerHTML = gridHtml;\r\n\r\n                let candleHtml = '', timeHtml = '', signalHtml = '';\r\n                const timeStep = Math.ceil(patternVisibleCount / 8);\r\n\r\n                displayData.forEach((d, i) => {\r\n                    const x = i * patternState.candleW, midX = x + (patternState.candleW / 2);\r\n                    if (i % timeStep === 0) timeHtml += `<text x=\"${midX}\" y=\"${h - 15}\" class=\"time-text\">${d.date}</text>`;\r\n\r\n                    if (d.is_future) return;\r\n\r\n                    const color = d.close >= d.open ? \"#26a69a\" : \"#ef5350\";\r\n                    const bodyT = getY(Math.max(d.open, d.close)), bodyB = getY(Math.min(d.open, d.close));\r\n\r\n                    candleHtml += `<line x1=\"${midX}\" y1=\"${getY(d.high)}\" x2=\"${midX}\" y2=\"${getY(d.low)}\" stroke=\"${color}\" stroke-width=\"1.5\" />`;\r\n                    candleHtml += `<rect x=\"${x + (patternState.candleW * 0.15)}\" y=\"${bodyT}\" width=\"${patternState.candleW * 0.7}\" height=\"${Math.max(Math.abs(bodyT - bodyB), 1.5)}\" fill=\"${color}\" />`;\r\n\r\n                    if (showCandleSignals && d.candle_signal && d.candle_signal.signal !== 'neutral') {\r\n                        const isBull = d.candle_signal.signal === 'bullish';\r\n                        const sigY = isBull ? getY(d.low) + 15 : getY(d.high) - 5;\r\n                        const sigColor = isBull ? '#4ade80' : '#ef5350';\r\n                        signalHtml += `<text x=\"${midX}\" y=\"${sigY}\" fill=\"${sigColor}\" font-size=\"12\" font-weight=\"bold\" text-anchor=\"middle\">${isBull ? '▲' : '▼'}</text>`;\r\n                    }\r\n                });\r\n\r\n                document.getElementById('pattern-candle-layer').innerHTML = candleHtml;\r\n                document.getElementById('pattern-time-layer').innerHTML = timeHtml;\r\n                document.getElementById('pattern-signal-layer').innerHTML = signalHtml;\r\n\r\n                let patternDrawHtml = '';\r\n                const lastCandle = ohlcData[ohlcData.length - 1];\r\n\r\n                // Auto Trendline (NEW TOGGLE)\r\n                if (showAutoTrendline && lastCandle && lastCandle.trendline) {\r\n                    const t = lastCandle.trendline;\r\n                    const startX = (t.x1 - patternOffset) * patternState.candleW + patternState.candleW / 2;\r\n                    const endX = (t.x2 - patternOffset) * patternState.candleW + patternState.candleW / 2;\r\n                    const color = t.type === 'uptrend' ? '#4ade80' : (t.type === 'downtrend' ? '#ef5350' : '#fbbf24');\r\n\r\n                    patternDrawHtml += `<line x1=\"${startX}\" y1=\"${getY(t.y1)}\" x2=\"${endX}\" y2=\"${getY(t.y2)}\" stroke=\"${color}\" stroke-width=\"3\" stroke-dasharray=\"8,4\" opacity=\"0.6\" />`;\r\n                    patternDrawHtml += `<text x=\"${endX}\" y=\"${getY(t.y2) - 10}\" fill=\"${color}\" font-weight=\"bold\" font-size=\"12\">${t.type.toUpperCase()}</text>`;\r\n                }\r\n\r\n                // Market Phase Badge\r\n                const histData = ohlcData.filter(d => !d.is_future);\r\n                const lastHistCandle = histData.length > 0 ? histData[histData.length - 1] : lastCandle;\r\n                if (lastHistCandle && lastHistCandle.phase) {\r\n                    const phaseColor = lastHistCandle.phase === 'Uptrend' ? '#26a69a' : (lastHistCandle.phase === 'Downtrend' ? '#ef5350' : '#8E9BAE');\r\n                    patternDrawHtml += `<g transform=\"translate(20, 20)\"><rect width=\"130\" height=\"26\" rx=\"4\" fill=\"#0f172a\" stroke=\"${phaseColor}\" stroke-width=\"1\"/><text x=\"65\" y=\"18\" fill=\"${phaseColor}\" font-size=\"11\" font-weight=\"bold\" font-family=\"monospace\" text-anchor=\"middle\">PHASE: ${lastHistCandle.phase.toUpperCase()}</text></g>`;\r\n                }\r\n\r\n                // Auto S/R Lines\r\n                if (showPatternSR && lastCandle && lastCandle.sr_levels) {\r\n                    lastCandle.sr_levels.resistance.forEach(res => {\r\n                        const y = getY(res);\r\n                        if (y >= 0 && y <= patternState.chartH) {\r\n                            patternDrawHtml += `<line x1=\"0\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"#ef5350\" stroke-width=\"1.5\" stroke-dasharray=\"6,4\" opacity=\"0.8\"/><rect x=\"${chartW - 75}\" y=\"${y - 10}\" width=\"75\" height=\"20\" fill=\"#0f172a\" stroke=\"#ef5350\" stroke-width=\"1\"/><text x=\"${chartW - 37}\" y=\"${y + 4}\" fill=\"#ef5350\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\" text-anchor=\"middle\">RES: ${res.toFixed(1)}</text>`;\r\n                        }\r\n                    });\r\n                    lastCandle.sr_levels.support.forEach(sup => {\r\n                        const y = getY(sup);\r\n                        if (y >= 0 && y <= patternState.chartH) {\r\n                            patternDrawHtml += `<line x1=\"0\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"#26a69a\" stroke-width=\"1.5\" stroke-dasharray=\"6,4\" opacity=\"0.8\"/><rect x=\"${chartW - 75}\" y=\"${y - 10}\" width=\"75\" height=\"20\" fill=\"#0f172a\" stroke=\"#26a69a\" stroke-width=\"1\"/><text x=\"${chartW - 37}\" y=\"${y + 4}\" fill=\"#26a69a\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\" text-anchor=\"middle\">SUP: ${sup.toFixed(1)}</text>`;\r\n                        }\r\n                    });\r\n                }\r\n\r\n                // Auto Fib (NEW)\r\n                if (showAutoFib && highs.length > 0) {\r\n                    const diff = patternState.maxP - patternState.minP;\r\n                    const levels = [\r\n                        { ratio: 0, color: '#787b86' }, { ratio: 0.236, color: '#f44336' }, { ratio: 0.382, color: '#81c784' },\r\n                        { ratio: 0.5, color: '#4caf50' }, { ratio: 0.618, color: '#009688' }, { ratio: 0.786, color: '#64b5f6' }, { ratio: 1, color: '#787b86' }\r\n                    ];\r\n\r\n                    const highIdx = displayData.findIndex(d => d.high === patternState.maxP);\r\n                    const lowIdx = displayData.findIndex(d => d.low === patternState.minP);\r\n                    const highX = highIdx * patternState.candleW + patternState.candleW / 2;\r\n                    const lowX = lowIdx * patternState.candleW + patternState.candleW / 2;\r\n\r\n                    patternDrawHtml += `<line x1=\"${highX}\" y1=\"${getY(patternState.maxP)}\" x2=\"${lowX}\" y2=\"${getY(patternState.minP)}\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-dasharray=\"2,4\" opacity=\"0.3\" />`;\r\n\r\n                    levels.forEach(level => {\r\n                        const price = patternState.minP + (diff * level.ratio);\r\n                        const y = getY(price);\r\n                        patternDrawHtml += `<line x1=\"0\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"${level.color}\" stroke-width=\"1\" stroke-dasharray=\"4,4\" opacity=\"0.7\" />`;\r\n                        patternDrawHtml += `<text x=\"5\" y=\"${y - 4}\" fill=\"${level.color}\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\">${(level.ratio * 100).toFixed(1)}% (${price.toFixed(2)})</text>`;\r\n                    });\r\n                }\r\n\r\n                // Pivot Points (NEW)\r\n                if (showPivotPoints && lastCandle && lastCandle.pivot_points) {\r\n                    const pp = lastCandle.pivot_points;\r\n                    const levels = [\r\n                        { name: 'R2', price: pp.R2, color: '#ef5350' },\r\n                        { name: 'R1', price: pp.R1, color: '#ef5350' },\r\n                        { name: 'P', price: pp.P, color: '#60a5fa' },\r\n                        { name: 'S1', price: pp.S1, color: '#26a69a' },\r\n                        { name: 'S2', price: pp.S2, color: '#26a69a' }\r\n                    ];\r\n                    levels.forEach(lvl => {\r\n                        const y = getY(lvl.price);\r\n                        if (y >= 0 && y <= patternState.chartH) {\r\n                            patternDrawHtml += `<line x1=\"0\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"${lvl.color}\" stroke-width=\"1.5\" stroke-dasharray=\"2,2\" opacity=\"0.9\"/>`;\r\n                            patternDrawHtml += `<rect x=\"${chartW - 65}\" y=\"${y - 10}\" width=\"65\" height=\"20\" fill=\"#0f172a\" stroke=\"${lvl.color}\" stroke-width=\"1\"/>`;\r\n                            patternDrawHtml += `<text x=\"${chartW - 32}\" y=\"${y + 4}\" fill=\"${lvl.color}\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\" text-anchor=\"middle\">${lvl.name}: ${lvl.price.toFixed(1)}</text>`;\r\n                        }\r\n                    });\r\n                }\r\n\r\n                // Manual Drawings\r\n                const renderPatternManualDrawing = (l) => {\r\n                    if (l.type === 'horizontal') {\r\n                        const y = getY(l.price); patternDrawHtml += `<line x1=\"0\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"#a855f7\" stroke-width=\"2\" stroke-dasharray=\"4\"/>`;\r\n                    } else if (l.type === 'trend') {\r\n                        const startX = (l.startIdx - patternOffset) * patternState.candleW + patternState.candleW / 2, endX = (l.endIdx - patternOffset) * patternState.candleW + patternState.candleW / 2;\r\n                        patternDrawHtml += `<line x1=\"${startX}\" y1=\"${getY(l.startPrice)}\" x2=\"${endX}\" y2=\"${getY(l.endPrice)}\" stroke=\"#a855f7\" stroke-width=\"2\" />`;\r\n                    } else if (l.type === 'fib') {\r\n                        const startX = (l.startIdx - patternOffset) * patternState.candleW + patternState.candleW / 2, endX = (l.endIdx - patternOffset) * patternState.candleW + patternState.candleW / 2;\r\n                        const diff = l.endPrice - l.startPrice; const levels = [{ ratio: 0, color: '#787b86' }, { ratio: 0.236, color: '#f44336' }, { ratio: 0.382, color: '#81c784' }, { ratio: 0.5, color: '#4caf50' }, { ratio: 0.618, color: '#009688' }, { ratio: 0.786, color: '#64b5f6' }, { ratio: 1, color: '#787b86' }];\r\n                        patternDrawHtml += `<line x1=\"${startX}\" y1=\"${getY(l.startPrice)}\" x2=\"${endX}\" y2=\"${getY(l.endPrice)}\" stroke=\"#ffffff\" stroke-width=\"1\" stroke-dasharray=\"2\" opacity=\"0.3\" />`;\r\n                        levels.forEach(level => { const price = l.startPrice + (diff * level.ratio), y = getY(price); patternDrawHtml += `<line x1=\"${startX}\" y1=\"${y}\" x2=\"${chartW}\" y2=\"${y}\" stroke=\"${level.color}\" stroke-width=\"1.5\" />`; });\r\n                    }\r\n                };\r\n                drawnLines.forEach(renderPatternManualDrawing);\r\n                if (tempTrendline && activeDragContainer === patternContainer) renderPatternManualDrawing(tempTrendline);\r\n                if (tempFib && activeDragContainer === patternContainer) renderPatternManualDrawing(tempFib);\r\n\r\n                // Geometric Patterns & Channels (NEW TOGGLE)\r\n                if (showAutoPatterns && lastCandle && lastCandle.patterns) {\r\n                    lastCandle.patterns.forEach((p, index) => {\r\n                        const getX = (idx) => (idx - patternOffset) * patternState.candleW + (patternState.candleW / 2);\r\n                        const ux1 = getX(p.upper.x1), uy1 = getY(p.upper.y1), ux2 = getX(p.upper.x2), uy2 = getY(p.upper.y2);\r\n                        const lx1 = getX(p.lower.x1), ly1 = getY(p.lower.y1), lx2 = getX(p.lower.x2), ly2 = getY(p.lower.y2);\r\n\r\n                        const isBullish = p.name.includes('Bullish'), isBearish = p.name.includes('Bearish');\r\n                        const pColor = isBullish ? '#4ade80' : (isBearish ? '#ef5350' : '#fbbf24');\r\n                        const predictionText = isBullish ? 'PREDICTION: BULLISH ↗' : (isBearish ? 'PREDICTION: BEARISH ↘' : 'PREDICTION: CONSOLIDATION →');\r\n\r\n                        patternDrawHtml += `<line x1=\"${ux1}\" y1=\"${uy1}\" x2=\"${ux2}\" y2=\"${uy2}\" stroke=\"${pColor}\" stroke-width=\"2\" stroke-dasharray=\"6,4\" opacity=\"0.9\" />`;\r\n                        patternDrawHtml += `<line x1=\"${lx1}\" y1=\"${ly1}\" x2=\"${lx2}\" y2=\"${ly2}\" stroke=\"${pColor}\" stroke-width=\"2\" stroke-dasharray=\"6,4\" opacity=\"0.9\" />`;\r\n\r\n                        const labelY = 30 + (index * 45);\r\n                        patternDrawHtml += `<g transform=\"translate(${chartW - 220}, ${labelY - 15})\"><rect width=\"210\" height=\"40\" rx=\"6\" fill=\"#0f172a\" stroke=\"${pColor}\" stroke-width=\"1\" opacity=\"0.85\"/><text x=\"105\" y=\"15\" fill=\"#fff\" font-size=\"12\" font-family=\"Inter, sans-serif\" font-weight=\"bold\" text-anchor=\"middle\">${p.name}</text><text x=\"105\" y=\"30\" fill=\"${pColor}\" font-size=\"10\" font-family=\"monospace\" font-weight=\"bold\" text-anchor=\"middle\">${predictionText}</text></g>`;\r\n                    });\r\n                }\r\n                document.getElementById('pattern-drawing-layer').innerHTML = patternDrawHtml;\r\n            }\r\n\r\n            // Fullscreen Logic\r\n            function toggleFullScreen(element) {\r\n                const isMobile = window.innerWidth <= 768;\r\n\r\n                if (isMobile) {\r\n                    if (element.classList.contains('rotate-mobile')) {\r\n                        element.classList.remove('rotate-mobile');\r\n                        document.body.style.overflow = '';\r\n                        document.body.classList.remove('fullscreen-active');\r\n                    } else {\r\n                        element.classList.add('rotate-mobile');\r\n                        document.body.style.overflow = 'hidden';\r\n                        document.body.classList.add('fullscreen-active');\r\n                    }\r\n                    setTimeout(renderAll, 100);\r\n                    return;\r\n                }\r\n\r\n                // Desktop Logic\r\n                const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;\r\n                if (!isFullscreen) {\r\n                    const req = element.requestFullscreen || element.webkitRequestFullscreen || element.mozRequestFullScreen || element.msRequestFullscreen;\r\n                    if (req) { try { req.call(element); } catch (e) { console.log(e); } }\r\n                } else {\r\n                    const ext = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;\r\n                    if (ext) { try { ext.call(document); } catch (e) { console.log(e); } }\r\n                }\r\n                setTimeout(renderAll, 100);\r\n            }\r\n\r\n            function exitFullScreen(btn) {\r\n                const element = btn.closest('.chart-card');\r\n                const isMobile = window.innerWidth <= 768;\r\n\r\n                if (isMobile && element.classList.contains('rotate-mobile')) {\r\n                    element.classList.remove('rotate-mobile');\r\n                    document.body.style.overflow = '';\r\n                    document.body.classList.remove('fullscreen-active');\r\n                    setTimeout(renderAll, 100);\r\n                    return;\r\n                }\r\n\r\n                const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;\r\n                if (isFullscreen) {\r\n                    const ext = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;\r\n                    if (ext) { try { ext.call(document); } catch (e) { console.log(e); } }\r\n                }\r\n                setTimeout(renderAll, 100);\r\n            }\r\n\r\n            // Sync standard browser fullscreen state with body class\r\n            function handleStandardFullscreenChange() {\r\n                const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;\r\n                if (isFullscreen) {\r\n                    document.body.classList.add('fullscreen-active');\r\n                } else {\r\n                    const hasMobileRotated = document.querySelector('.rotate-mobile');\r\n                    if (!hasMobileRotated) {\r\n                        document.body.classList.remove('fullscreen-active');\r\n                    }\r\n                }\r\n                setTimeout(renderAll, 100);\r\n            }\r\n            document.addEventListener('fullscreenchange', handleStandardFullscreenChange);\r\n            document.addEventListener('webkitfullscreenchange', handleStandardFullscreenChange);\r\n\r\n            document.getElementById('btn-fullscreen-main').onclick = () => toggleFullScreen(document.querySelectorAll('.chart-card')[0]);\r\n            document.getElementById('btn-fullscreen-pattern').onclick = () => toggleFullScreen(document.querySelectorAll('.chart-card')[1]);\r\n\r\n            function updateTrendSuggestion() {\r\n                if (!ohlcData || ohlcData.length === 0) return;\r\n\r\n                const histData = ohlcData.filter(d => !d.is_future);\r\n                const futData = ohlcData.filter(d => d.is_future);\r\n\r\n                if (histData.length === 0 || futData.length === 0) return;\r\n\r\n                const lastHist = histData[histData.length - 1];\r\n                const lastFut = futData[futData.length - 1];\r\n\r\n                const ema9Hist = lastHist.ema9;\r\n                const ema9Fut = lastFut.ema9;\r\n                const ema21Hist = lastHist.ema21;\r\n                const ema21Fut = lastFut.ema21;\r\n                const sma20Hist = lastHist.sma20;\r\n                const sma20Fut = lastFut.sma20;\r\n                const sma50Hist = lastHist.sma50;\r\n                const sma50Fut = lastFut.sma50;\r\n\r\n                const suggestionEl = document.getElementById('ai-trend-suggestion');\r\n                const textEl = document.getElementById('trend-summary-text');\r\n                const ema9El = document.getElementById('ema9-projection');\r\n                const ema21El = document.getElementById('ema21-projection');\r\n                const sma20El = document.getElementById('sma20-projection');\r\n                const sma50El = document.getElementById('sma50-projection');\r\n\r\n                if (!suggestionEl) return;\r\n\r\n                let ema9Trend = 'flat', ema21Trend = 'flat', sma20Trend = 'flat', sma50Trend = 'flat';\r\n                let ema9Text = 'Consolidating', ema21Text = 'Consolidating', sma20Text = 'Consolidating', sma50Text = 'Consolidating';\r\n\r\n                const checkTrend = (histVal, futVal) => {\r\n                    if (histVal && futVal) {\r\n                        const diff = futVal - histVal;\r\n                        const pct = diff / histVal;\r\n                        if (pct > 0.0002) return { trend: 'up', text: '↗ Uptrend' };\r\n                        if (pct < -0.0002) return { trend: 'down', text: '↘ Downtrend' };\r\n                    }\r\n                    return { trend: 'flat', text: 'Consolidating' };\r\n                };\r\n\r\n                const resEma9 = checkTrend(ema9Hist, ema9Fut);\r\n                ema9Trend = resEma9.trend; ema9Text = resEma9.text;\r\n\r\n                const resEma21 = checkTrend(ema21Hist, ema21Fut);\r\n                ema21Trend = resEma21.trend; ema21Text = resEma21.text;\r\n\r\n                const resSma20 = checkTrend(sma20Hist, sma20Fut);\r\n                sma20Trend = resSma20.trend; sma20Text = resSma20.text;\r\n\r\n                const resSma50 = checkTrend(sma50Hist, sma50Fut);\r\n                sma50Trend = resSma50.trend; sma50Text = resSma50.text;\r\n\r\n                const updateEl = (el, label, text, trend) => {\r\n                    if (el) {\r\n                        el.innerText = `${label}: ${text}`;\r\n                        el.style.color = trend === 'up' ? '#26a69a' : (trend === 'down' ? '#ef5350' : '#8E9BAE');\r\n                    }\r\n                };\r\n\r\n                updateEl(ema9El, 'EMA 9', ema9Text, ema9Trend);\r\n                updateEl(ema21El, 'EMA 21', ema21Text, ema21Trend);\r\n                updateEl(sma20El, 'SMA 20', sma20Text, sma20Trend);\r\n                updateEl(sma50El, 'SMA 50', sma50Text, sma50Trend);\r\n\r\n                const trends = [ema9Trend, ema21Trend, sma20Trend, sma50Trend];\r\n                const ups = trends.filter(t => t === 'up').length;\r\n                const downs = trends.filter(t => t === 'down').length;\r\n\r\n                let overallText = 'Consolidating Range 🔄';\r\n                let badgeColor = 'rgba(234, 179, 8, 0.1)';\r\n                let badgeText = '#eab308';\r\n                let badgeBorder = 'rgba(234, 179, 8, 0.2)';\r\n\r\n                if (ups === 4) {\r\n                    overallText = 'Strong Bullish Trend Forecasted 🚀';\r\n                    badgeColor = 'rgba(38, 166, 154, 0.1)';\r\n                    badgeText = '#26a69a';\r\n                    badgeBorder = 'rgba(38, 166, 154, 0.2)';\r\n                } else if (downs === 4) {\r\n                    overallText = 'Strong Bearish Trend Forecasted ⚠️';\r\n                    badgeColor = 'rgba(239, 83, 80, 0.1)';\r\n                    badgeText = '#ef5350';\r\n                    badgeBorder = 'rgba(239, 83, 80, 0.2)';\r\n                } else if (ups >= 2 && ups > downs) {\r\n                    overallText = 'Bullish Trend Bias 📈';\r\n                    badgeColor = 'rgba(34, 197, 94, 0.1)';\r\n                    badgeText = '#22c55e';\r\n                    badgeBorder = 'rgba(34, 197, 94, 0.2)';\r\n                } else if (downs >= 2 && downs > ups) {\r\n                    overallText = 'Bearish Trend Bias 📉';\r\n                    badgeColor = 'rgba(239, 83, 80, 0.1)';\r\n                    badgeText = '#ef5350';\r\n                    badgeBorder = 'rgba(239, 83, 80, 0.2)';\r\n                }\r\n\r\n                textEl.innerText = overallText;\r\n                \r\n                const badge = suggestionEl.querySelector('span');\r\n                if (badge) {\r\n                    badge.style.background = badgeColor;\r\n                    badge.style.color = badgeText;\r\n                    badge.style.borderColor = badgeBorder;\r\n                }\r\n\r\n                suggestionEl.style.display = 'flex';\r\n\r\n                // Calculate dynamic Technical Quant Score (1 to 100)\r\n                let score = 50;\r\n\r\n                // 1. Moving average trend slopes (forecasted future vs current)\r\n                if (ema9Trend === 'up') score += 10;\r\n                else if (ema9Trend === 'down') score -= 10;\r\n\r\n                if (ema21Trend === 'up') score += 10;\r\n                else if (ema21Trend === 'down') score -= 10;\r\n\r\n                if (sma20Trend === 'up') score += 10;\r\n                else if (sma20Trend === 'down') score -= 10;\r\n\r\n                if (sma50Trend === 'up') score += 10;\r\n                else if (sma50Trend === 'down') score -= 10;\r\n\r\n                // 2. Alignment & crossovers\r\n                if (ema9Hist && ema21Hist) {\r\n                    if (ema9Hist > ema21Hist) score += 5;\r\n                    else score -= 5;\r\n                }\r\n                if (sma20Hist && sma50Hist) {\r\n                    if (sma20Hist > sma50Hist) score += 5;\r\n                    else score -= 5;\r\n                }\r\n\r\n                // 3. Price position relative to key moving averages\r\n                const currentPrice = lastHist.close;\r\n                if (currentPrice && sma50Hist) {\r\n                    if (currentPrice > sma50Hist) score += 10;\r\n                    else score -= 10;\r\n                }\r\n                if (currentPrice && sma20Hist) {\r\n                    if (currentPrice > sma20Hist) score += 5;\r\n                    else score -= 5;\r\n                }\r\n\r\n                // Clamp score between 1 and 100\r\n                score = Math.max(1, Math.min(100, Math.round(score)));\r\n\r\n                // Rotate the needle (from -90deg to +90deg)\r\n                const degrees = ((score / 100) * 180) - 90;\r\n                const needleEl = document.getElementById('tech-needle');\r\n                if (needleEl) needleEl.style.transform = `rotate(${degrees}deg)`;\r\n\r\n                // Update score text\r\n                const scoreTextEl = document.getElementById('tech-score-text');\r\n                if (scoreTextEl) scoreTextEl.innerText = `${score}/100`;\r\n\r\n                // Determine evaluation state and meaning\r\n                let evaluationState = \"\";\r\n                let evaluationClass = \"\";\r\n                let panelBorderColor = \"\";\r\n                let meaningExplanation = \"\";\r\n\r\n                if (score > 50) {\r\n                    evaluationState = \"Bullish\";\r\n                    evaluationClass = \"highlight-good\";\r\n                    panelBorderColor = \"#00FF9D\";\r\n                    meaningExplanation = `A score of <strong>${score}</strong> indicates a <strong>Bullish</strong> momentum. Immediate upward projections are supported by rising indicators and positive moving average alignment, suggesting a favorable outlook for long positions.`;\r\n                } else if (score < 50) {\r\n                    evaluationState = \"Bearish\";\r\n                    evaluationClass = \"highlight-bad\";\r\n                    panelBorderColor = \"#ff4d4d\";\r\n                    meaningExplanation = `A score of <strong>${score}</strong> indicates a <strong>Bearish</strong> pressure. Downward projections are reinforced by falling moving averages and bearish crossovers, suggesting increased downside risk or short setup opportunities.`;\r\n                } else {\r\n                    evaluationState = \"Neutral\";\r\n                    evaluationClass = \"highlight-neutral\";\r\n                    panelBorderColor = \"#f59e0b\";\r\n                    meaningExplanation = `A score of <strong>50</strong> represents a <strong>Neutral</strong> consolidation phase. Short-term indicators are flat or conflicting, suggesting range-bound volatility with no clear directional bias.`;\r\n                }\r\n\r\n                // Update evaluation explanation and description\r\n                const summaryTextEl = document.getElementById('tech-summary-text');\r\n                if (summaryTextEl) {\r\n                    summaryTextEl.innerHTML = `\r\n                        The AI Technical Score of the asset is currently evaluated at <span class=\"${evaluationClass}\">${score}/100</span>, indicating a <strong>${evaluationState}</strong> posture.\r\n                        ${meaningExplanation}\r\n                        <div style=\"font-size: 0.82rem; color: #8E9BAE; margin-top: 10px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 8px;\">\r\n                            <strong>Meter Definition:</strong> This indicator measures technical trend health from 1 to 100. Scores below 50 reflect bearish momentum (sell pressure dominates), scores above 50 signal bullish momentum (buy pressure dominates), and exactly 50 represents consolidation.\r\n                        </div>\r\n                    `;\r\n                }\r\n\r\n                // Update panel color and display\r\n                const panelEl = document.getElementById('tech-health-panel');\r\n                if (panelEl) {\r\n                    panelEl.style.borderLeftColor = panelBorderColor;\r\n                    panelEl.style.display = 'flex';\r\n                }\r\n            }\r\n\r\n            let typingTimer = null;\r\n            function typeWriterEffect(elementId, text) {\r\n                const element = document.getElementById(elementId);\r\n                if (!element) return;\r\n                \r\n                if (typingTimer) {\r\n                    clearInterval(typingTimer);\r\n                }\r\n\r\n                let formattedText = text\r\n                    .replace(/\\*\\*(.*?)\\*\\*/g, '<strong style=\"color: #38bdf8;\">$1</strong>')\r\n                    .replace(/\\n/g, '<br>');\r\n\r\n                element.innerHTML = '';\r\n                \r\n                let index = 0;\r\n                typingTimer = setInterval(() => {\r\n                    if (index >= formattedText.length) {\r\n                        clearInterval(typingTimer);\r\n                        element.innerHTML = formattedText;\r\n                        return;\r\n                    }\r\n                    \r\n                    if (formattedText[index] === '<') {\r\n                        const closeIdx = formattedText.indexOf('>', index);\r\n                        if (closeIdx !== -1) {\r\n                            index = closeIdx + 1;\r\n                        } else {\r\n                            index++;\r\n                        }\r\n                    } else {\r\n                        index += 3;\r\n                    }\r\n                    \r\n                    element.innerHTML = formattedText.substring(0, index) + '<span style=\"border-right: 2px solid #38bdf8; animation: blink 0.75s step-end infinite;\">&nbsp;</span>';\r\n                }, 10);\r\n            }\r\n\r\n            function copySummaryText() {\r\n                const element = document.getElementById('ai-summary-text');\r\n                if (!element) return;\r\n                const text = element.innerText;\r\n                \r\n                navigator.clipboard.writeText(text).then(() => {\r\n                    const btn = document.getElementById('copy-summary-btn');\r\n                    const originalHTML = btn.innerHTML;\r\n                    btn.innerHTML = '✅ Copied!';\r\n                    btn.style.color = '#26a69a';\r\n                    btn.style.borderColor = 'rgba(38, 166, 154, 0.4)';\r\n                    setTimeout(() => {\r\n                        btn.innerHTML = originalHTML;\r\n                        btn.style.color = '';\r\n                        btn.style.borderColor = '';\r\n                    }, 2000);\r\n                }).catch(err => {\r\n                    console.error('Failed to copy: ', err);\r\n                });\r\n            }\r\n\r\n            function generateAITechnicalScript() {\r\n                if (!ohlcData || ohlcData.length === 0) return;\r\n\r\n                const histData = ohlcData.filter(d => !d.is_future);\r\n                const futData = ohlcData.filter(d => d.is_future);\r\n\r\n                if (histData.length === 0) return;\r\n\r\n                const lastHist = histData[histData.length - 1];\r\n                const lastFut = futData.length > 0 ? futData[futData.length - 1] : lastHist;\r\n\r\n                const ticker = currentTicker;\r\n                const timeframe = currentTimeframe;\r\n                const currentPrice = lastHist.close;\r\n                \r\n                const rsi = lastHist.rsi;\r\n                const macd = lastHist.macd;\r\n                const macdSignal = lastHist.signal;\r\n                const macdHist = lastHist.hist;\r\n                \r\n                const sma20Hist = lastHist.sma20;\r\n                const sma50Hist = lastHist.sma50;\r\n                const ema9Hist = lastHist.ema9;\r\n                const ema9Fut = lastFut.ema9;\r\n                const ema21Hist = lastHist.ema21;\r\n                const ema21Fut = lastFut.ema21;\r\n                \r\n                const metaCandle = ohlcData[ohlcData.length - 1];\r\n                const patterns = metaCandle.patterns || [];\r\n                const sr_levels = metaCandle.sr_levels;\r\n\r\n                let overview = \"\";\r\n                if (sma20Hist && sma50Hist) {\r\n                    if (currentPrice > sma20Hist && sma20Hist > sma50Hist) {\r\n                        overview = `**Market Structure Overview:**\\n${ticker} is exhibiting a solid bullish market structure on the ${timeframe} timeframe, trading at a price of **${currentPrice.toFixed(2)}**. The asset is holding above both its 20-period SMA (${sma20Hist.toFixed(2)}) and 50-period SMA (${sma50Hist.toFixed(2)}), with the shorter SMA riding above the longer SMA, indicating strong buying momentum.`;\r\n                    } else if (currentPrice < sma20Hist && sma20Hist < sma50Hist) {\r\n                        overview = `**Market Structure Overview:**\\n${ticker} is currently in a confirmed bearish phase on the ${timeframe} timeframe, trading at a price of **${currentPrice.toFixed(2)}**. The price remains capped under its 20-period SMA (${sma20Hist.toFixed(2)}) and 50-period SMA (${sma50Hist.toFixed(2)}). With the shorter SMA trending below the longer SMA, sellers remain in clear control of the primary trend.`;\r\n                    } else {\r\n                        overview = `**Market Structure Overview:**\\n${ticker} is trading in a consolidation pattern on the ${timeframe} timeframe, with a last close price of **${currentPrice.toFixed(2)}**. The price action is oscillating around its 20-period SMA (${sma20Hist.toFixed(2)}) and 50-period SMA (${sma50Hist.toFixed(2)}), signaling lack of directional dominance.`;\r\n                    }\r\n                } else {\r\n                    overview = `**Market Structure Overview:**\\n${ticker} is currently trading at a price of **${currentPrice.toFixed(2)}** on the ${timeframe} timeframe. Indicators are being processed.`;\r\n                }\r\n\r\n                let maScript = \"\";\r\n                if (ema9Fut && ema9Hist && ema21Fut && ema21Hist) {\r\n                    const ema9Diff = ema9Fut - ema9Hist;\r\n                    const ema21Diff = ema21Fut - ema21Hist;\r\n                    if (ema9Diff > 0 && ema21Diff > 0) {\r\n                        maScript = `\\n\\n**Moving Average Projections:**\\nThe short-term EMA 9 and EMA 21 are both projecting positive slopes into the future. EMA 9 is forecasted to rise from ${ema9Hist.toFixed(2)} to ${ema9Fut.toFixed(2)}, indicating that immediate upward momentum is expected to accelerate.`;\r\n                    } else if (ema9Diff < 0 && ema21Diff < 0) {\r\n                        maScript = `\\n\\n**Moving Average Projections:**\\nThe short-term EMA 9 and EMA 21 are projecting negative slopes. EMA 9 is forecasted to drift lower from ${ema9Hist.toFixed(2)} to ${ema9Fut.toFixed(2)}, pointing to sustained near-term downward pressure.`;\r\n                    } else {\r\n                        maScript = `\\n\\n**Moving Average Projections:**\\nThe short-term EMAs (EMA 9 and EMA 21) are flattening out. EMA 9 is projected to move from ${ema9Hist.toFixed(2)} to ${ema9Fut.toFixed(2)}, signaling immediate consolidation.`;\r\n                    }\r\n                }\r\n\r\n                let oscScript = \"\\n\\n**Momentum Indicators:**\\n\";\r\n                if (rsi != null) {\r\n                    if (rsi > 70) {\r\n                        oscScript += `Relative Strength Index (RSI) is currently at **${rsi.toFixed(2)}**, placing the asset in overbought territory. This suggests a potential near-term cooldown or pullback risk. `;\r\n                    } else if (rsi < 30) {\r\n                        oscScript += `Relative Strength Index (RSI) is at **${rsi.toFixed(2)}**, placing the asset in oversold territory, indicating high exhaustion and a potential rebound opportunity. `;\r\n                    } else {\r\n                        oscScript += `RSI is currently neutral at **${rsi.toFixed(2)}**, indicating balanced buying and selling pressure. `;\r\n                    }\r\n                }\r\n                \r\n                if (macd != null && macdSignal != null && macdHist != null) {\r\n                    const isCrossover = macd > macdSignal;\r\n                    if (isCrossover && macdHist > 0) {\r\n                        oscScript += `The MACD indicator shows a bullish momentum bias, with the MACD line hovering above the signal line and the histogram demonstrating expanding green momentum bars (${macdHist.toFixed(2)}).`;\r\n                    } else if (!isCrossover && macdHist < 0) {\r\n                        oscScript += `The MACD indicator reinforces the bearish trend, with the MACD line staying below the signal line and the histogram printing expanding red momentum bars (${macdHist.toFixed(2)}).`;\r\n                    } else {\r\n                        oscScript += `The MACD lines are converging with a narrowing histogram (${macdHist.toFixed(2)}), pointing to a transitional phase in momentum.`;\r\n                    }\r\n                }\r\n\r\n                let levelsScript = \"\";\r\n                if (sr_levels && (sr_levels.support.length > 0 || sr_levels.resistance.length > 0)) {\r\n                    levelsScript = `\\n\\n**Key Support & Resistance Levels:**\\n`;\r\n                    if (sr_levels.resistance.length > 0) {\r\n                        levelsScript += `Immediate resistance ceilings are identified at: **${sr_levels.resistance.map(r => r.toFixed(2)).join(', ')}**. `;\r\n                    }\r\n                    if (sr_levels.support.length > 0) {\r\n                        levelsScript += `On the downside, structural support floors are established at: **${sr_levels.support.map(s => s.toFixed(2)).join(', ')}**. `;\r\n                    }\r\n                }\r\n                \r\n                if (patterns && patterns.length > 0) {\r\n                    const pattern = patterns[0];\r\n                    levelsScript += `Additionally, a **${pattern.name}** chart formation has been detected by the pattern engine, projecting a bias towards ${pattern.name.includes('Bullish') ? 'upward breakout' : (pattern.name.includes('Bearish') ? 'downward breakdown' : 'range-bound consolidation')}.`;\r\n                }\r\n\r\n                let outlookScript = \"\";\r\n                if (futData.length > 0) {\r\n                    const finalFutPrice = lastFut.close;\r\n                    const netChange = finalFutPrice - currentPrice;\r\n                    const pctChange = (netChange / currentPrice) * 100;\r\n                    \r\n                    outlookScript = `\\n\\n**AI Quantitative Forecast:**\\nOver the next 10 predicted candles, the AI forecasting model projects the price of ${ticker} to move from ${currentPrice.toFixed(2)} towards a target of **${finalFutPrice.toFixed(2)}** (${pctChange >= 0 ? '+' : ''}${pctChange.toFixed(2)}%). `;\r\n                    \r\n                    if (pctChange > 0.5) {\r\n                        outlookScript += `The predictive model advises a **BULLISH** stance, indicating potential long setups with entry zones near support floors, keeping target profit levels aligned with the forecasted targets.`;\r\n                    } else if (pctChange < -0.5) {\r\n                        outlookScript += `The model advises a **BEARISH** tactical stance, recommending short setups on rallies towards resistance levels or staying defensive in cash positions.`;\r\n                    } else {\r\n                        outlookScript += `The model projects **CONSOLIDATION** and range-bound trading, recommending range-bound scalp strategies between the support and resistance limits.`;\r\n                    }\r\n                }\r\n\r\n                const fullScript = `${overview}${maScript}${oscScript}${levelsScript}${outlookScript}`;\r\n\r\n                document.getElementById('ai-summary-section').style.display = 'block';\r\n                typeWriterEffect('ai-summary-text', fullScript);\r\n            }\r\n\r\n            // ==========================================\r\n            // VIRTUAL TRADING PORTAL INTEGRATED JS\r\n            // ==========================================\r\n            let chartTradeAction = 'BUY';\r\n            let activeStockPrice = 0;\r\n            const isIndianStock = currentTicker.endsWith('.NS') || currentTicker.endsWith('.BO') || currentTicker === 'INR=X';\r\n            const curSym = isIndianStock ? '₹' : '$';\r\n\r\n            // Fetch user balance and holdings details\r\n            async function loadChartTradePortfolio() {\r\n                try {\r\n                    const response = await fetch('/api/trading/portfolio');\r\n                    const data = await response.json();\r\n\r\n                    if (response.ok && !data.error) {\r\n                        const cash = data.virtualBalance;\r\n                        document.getElementById('virtual-cash-display').innerText = `₹${cash.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\r\n\r\n                        // Filter holdings for the current stock ticker\r\n                        const holding = data.holdings.find(h => h.ticker === currentTicker);\r\n                        if (holding) {\r\n                            document.getElementById('virtual-holding-display').innerText = `${holding.shares} Shares`;\r\n                            document.getElementById('virtual-avg-price-display').innerText = `${curSym}${holding.averageBuyPrice.toFixed(2)}`;\r\n                        } else {\r\n                            document.getElementById('virtual-holding-display').innerText = `0 Shares`;\r\n                            document.getElementById('virtual-avg-price-display').innerText = `${curSym}0.00`;\r\n                        }\r\n                    }\r\n                } catch (err) {\r\n                    console.error(\"Failed to load portfolio stats in chart:\", err);\r\n                }\r\n            }\r\n\r\n            // Set BUY vs SELL\r\n            function setChartTradeAction(action) {\r\n                chartTradeAction = action;\r\n                const buyBtn = document.getElementById('trade-btn-buy');\r\n                const sellBtn = document.getElementById('trade-btn-sell');\r\n                const submitBtn = document.getElementById('chart-trade-submit-btn');\r\n\r\n                if (action === 'BUY') {\r\n                    buyBtn.style.background = '#26a69a';\r\n                    buyBtn.style.color = '#000';\r\n                    sellBtn.style.background = 'transparent';\r\n                    sellBtn.style.color = '#8E9BAE';\r\n                    submitBtn.style.background = '#26a69a';\r\n                    submitBtn.style.boxShadow = '0 4px 15px rgba(38,166,154,0.3)';\r\n                } else {\r\n                    buyBtn.style.background = 'transparent';\r\n                    buyBtn.style.color = '#8E9BAE';\r\n                    sellBtn.style.background = '#ff0055';\r\n                    sellBtn.style.color = '#fff';\r\n                    submitBtn.style.background = '#ff0055';\r\n                    submitBtn.style.boxShadow = '0 4px 15px rgba(255,0,85,0.3)';\r\n                }\r\n\r\n                submitBtn.innerText = `${action} ${currentTicker}`;\r\n                recalcChartTradeEstimate();\r\n            }\r\n\r\n            // Recalculate transaction estimate\r\n            function recalcChartTradeEstimate() {\r\n                if (activeStockPrice <= 0) {\r\n                    // Try to get price from ohlcData in memory if not already set\r\n                    if (ohlcData && ohlcData.length > 0) {\r\n                        const histData = ohlcData.filter(d => !d.is_future);\r\n                        if (histData.length > 0) {\r\n                            activeStockPrice = histData[histData.length - 1].close;\r\n                        }\r\n                    }\r\n                }\r\n\r\n                const qtyInput = document.getElementById('trade-qty-input');\r\n                let qty = parseInt(qtyInput.value);\r\n                if (isNaN(qty) || qty <= 0) {\r\n                    qty = 1;\r\n                    qtyInput.value = 1;\r\n                }\r\n\r\n                const subtotal = activeStockPrice * qty;\r\n                document.getElementById('chart-trade-currency').innerText = isIndianStock ? 'INR' : 'USD';\r\n                document.getElementById('chart-trade-estimate-price').innerText = `${curSym}${activeStockPrice.toFixed(2)} each`;\r\n                document.getElementById('chart-trade-estimate-total').innerText = `${curSym}${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;\r\n            }\r\n\r\n            // Submit virtual trade request\r\n            async function executeChartTrade() {\r\n                const qtyInput = document.getElementById('trade-qty-input');\r\n                const qty = parseInt(qtyInput.value);\r\n                if (isNaN(qty) || qty <= 0) {\r\n                    alert(\"Please select a valid quantity of shares.\");\r\n                    return;\r\n                }\r\n\r\n                const submitBtn = document.getElementById('chart-trade-submit-btn');\r\n                const originalText = submitBtn.innerText;\r\n                submitBtn.disabled = true;\r\n                submitBtn.innerText = 'EXECUTING...';\r\n\r\n                try {\r\n                    const response = await fetch('/api/trading/trade', {\r\n                        method: 'POST',\r\n                        headers: { 'Content-Type': 'application/json' },\r\n                        body: JSON.stringify({\r\n                            ticker: currentTicker,\r\n                            action: chartTradeAction,\r\n                            shares: qty\r\n                        })\r\n                    });\r\n\r\n                    const data = await response.json();\r\n                    if (response.ok && data.success) {\r\n                        alert(data.message);\r\n                        loadChartTradePortfolio();\r\n                    } else {\r\n                        alert(data.error || 'Failed to complete transaction.');\r\n                    }\r\n                } catch (err) {\r\n                    console.error(\"Trade failed:\", err);\r\n                    alert(\"Connectivity error during transaction.\");\r\n                } finally {\r\n                    submitBtn.disabled = false;\r\n                    submitBtn.innerText = originalText;\r\n                }\r\n            }\r\n\r\n            // AI News & Sentiment Terminal Integration\r\n            async function loadSentimentTerminal() {\r\n                const listEl = document.getElementById('sentiment-news-list');\r\n                const labelEl = document.getElementById('sentiment-overall-label');\r\n                const iconEl = document.getElementById('sentiment-overall-icon');\r\n                const indexEl = document.getElementById('sentiment-index-val');\r\n                const needleEl = document.getElementById('sentiment-gauge-needle');\r\n                const driversEl = document.getElementById('sentiment-drivers-container');\r\n                const updatedEl = document.getElementById('sentiment-last-updated');\r\n\r\n                if (!listEl) return;\r\n\r\n                try {\r\n                    const res = await fetch(`/api/sentiment?ticker=${currentTicker}`);\r\n                    const data = await res.json();\r\n\r\n                    if (res.ok && !data.error) {\r\n                        const score = data.sentimentScore;\r\n                        const overall = data.overallSentiment;\r\n                        const drivers = data.keyDrivers || [];\r\n                        const articles = data.articles || [];\r\n\r\n                        // 1. Overall sentiment styling\r\n                        labelEl.innerText = overall.toUpperCase();\r\n                        if (overall === 'Bullish') {\r\n                            labelEl.style.color = '#00FF9D';\r\n                            iconEl.style.color = '#00FF9D';\r\n                            iconEl.innerText = '📈';\r\n                        } else if (overall === 'Bearish') {\r\n                            labelEl.style.color = '#ff0055';\r\n                            iconEl.style.color = '#ff0055';\r\n                            iconEl.innerText = '📉';\r\n                        } else {\r\n                            labelEl.style.color = '#8e9bae';\r\n                            iconEl.style.color = '#8e9bae';\r\n                            iconEl.innerText = '📡';\r\n                        }\r\n\r\n                        // 2. Score index value\r\n                        const prefix = score > 0 ? '+' : '';\r\n                        indexEl.innerText = `${prefix}${score.toFixed(2)}`;\r\n\r\n                        // 3. Gauge rotation: map -1 to +1 into a rotation\r\n                        // 0 is neutral (pointing straight up: 0deg rotation). \r\n                        // -1 is bearish (pointing left: -90deg rotation).\r\n                        // +1 is bullish (pointing right: 90deg rotation).\r\n                        const deg = score * 90;\r\n                        needleEl.style.transform = `rotate(${deg}deg)`;\r\n\r\n                        // 4. Drivers container\r\n                        if (drivers.length > 0) {\r\n                            driversEl.innerHTML = drivers.map(d => `\r\n                                <span style=\"font-size: 0.75rem; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.3); color: #c084fc; padding: 3px 8px; border-radius: 12px; text-transform: capitalize;\">\r\n                                    ${d}\r\n                                </span>\r\n                            `).join('');\r\n                        } else {\r\n                            driversEl.innerHTML = `<span style=\"font-size: 0.75rem; color: #64748b;\">Neutral catalysts</span>`;\r\n                        }\r\n\r\n                        // 5. Render articles list\r\n                        if (articles.length > 0) {\r\n                            listEl.innerHTML = articles.map(a => {\r\n                                const isUp = a.sentiment === 'Bullish';\r\n                                const isDown = a.sentiment === 'Bearish';\r\n                                const tagColor = isUp ? 'rgba(0,255,157,0.1)' : (isDown ? 'rgba(255,0,85,0.1)' : 'rgba(255,255,255,0.05)');\r\n                                const tagText = isUp ? '#00ff9d' : (isDown ? '#ff0055' : '#8e9bae');\r\n                                const dateStr = a.publishTime ? new Date(a.publishTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Recent';\r\n\r\n                                return `\r\n                                    <div style=\"padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; gap: 8px;\">\r\n                                        <div style=\"display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;\">\r\n                                            <a href=\"${a.link}\" target=\"_blank\" style=\"color: #f8fafc; text-decoration: none; font-weight: 600; font-size: 0.9rem; line-height: 1.4; transition: color 0.2s;\" onmouseover=\"this.style.color='#38bdf8'\" onmouseout=\"this.style.color='#f8fafc'\">\r\n                                                ${a.title}\r\n                                            </a>\r\n                                            <span style=\"font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; background: ${tagColor}; color: ${tagText}; text-transform: uppercase; flex-shrink: 0;\">\r\n                                                ${a.sentiment}\r\n                                            </span>\r\n                                        </div>\r\n                                        <div style=\"display: flex; justify-content: space-between; font-size: 0.75rem; color: #64748b;\">\r\n                                            <span>${a.publisher}</span>\r\n                                            <span>${dateStr}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                `;\r\n                            }).join('');\r\n                        } else {\r\n                            listEl.innerHTML = `<div style=\"text-align: center; color: #64748b; padding: 20px; font-size: 0.9rem;\">No news articles found for ${currentTicker}.</div>`;\r\n                        }\r\n\r\n                        // 6. Update last checked time\r\n                        updatedEl.innerText = `UPDATED: ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;\r\n                    } else {\r\n                        throw new Error(data.error || 'Invalid sentiment data');\r\n                    }\r\n                } catch (err) {\r\n                    console.error(\"Sentiment terminal load error:\", err);\r\n                    listEl.innerHTML = `\r\n                        <div style=\"text-align: center; color: #ff0055; padding: 20px; font-size: 0.9rem;\">\r\n                            ⚠️ News feed temporarily unavailable.\r\n                        </div>\r\n                    `;\r\n                    labelEl.innerText = \"OFFLINE\";\r\n                    labelEl.style.color = \"#ff4d4d\";\r\n                }\r\n            }\r\n\r\n            // Hook into the OHLC fetch to get price on load\r\n            const originalFetchOHLCData = fetchOHLCData;\r\n            fetchOHLCData = async function() {\r\n                await originalFetchOHLCData();\r\n                if (ohlcData && ohlcData.length > 0) {\r\n                    const histData = ohlcData.filter(d => !d.is_future);\r\n                    if (histData.length > 0) {\r\n                        activeStockPrice = histData[histData.length - 1].close;\r\n                        recalcChartTradeEstimate();\r\n                    }\r\n                }\r\n                loadChartTradePortfolio();\r\n                loadSentimentTerminal();\r\n            };\r\n\r\n            window.addEventListener('resize', renderAll);\r\n            fetchOHLCData();\r\n        </script>\r\n</body>\r\n\r\n</html>"