rap !important;\r\n            line-height: 36px !important;\r\n        }\r\n\r\n        .rotate-mobile h3 span,\r\n        .chart-card:fullscreen h3 span,\r\n        .chart-card:-webkit-full-screen h3 span {\r\n            display: none !important;\r\n        }\r\n\r\n        /* Sidebar styling for fullscreen: Grid Layout (Desktop) */\r\n        .chart-card:fullscreen .toolbar,\r\n        .chart-card:-webkit-full-screen .toolbar {\r\n            position: absolute !important;\r\n            top: 70px !important;\r\n            left: 15px !important;\r\n            width: 320px !important;\r\n            max-height: calc(100vh - 90px) !important;\r\n            background: rgba(13, 17, 23, 0.95) !important;\r\n            backdrop-filter: blur(10px) !important;\r\n            border: 1px solid var(--border) !important;\r\n            border-radius: 12px !important;\r\n            padding: 12px !important;\r\n            display: grid !important;\r\n            grid-template-columns: 1fr 1fr !important;\r\n            align-items: center !important;\r\n            gap: 8px !important;\r\n            z-index: 99999 !important;\r\n            overflow-y: auto !important;\r\n            overflow-x: hidden !important;\r\n            transform: translateX(-350px) !important;\r\n            /* Collapsed by default */\r\n            transition: transform 0.3s ease !important;\r\n            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;\r\n        }\r\n\r\n        /* Slide in sidebar when expanded on desktop fullscreen */\r\n        .chart-card:fullscreen .toolbar.open,\r\n        .chart-card:-webkit-full-screen .toolbar.open {\r\n            transform: translateX(0) !important;\r\n        }\r\n\r\n        /* Desktop specific sidebar element controls */\r\n        .chart-card:fullscreen .toolbar .tool-btn,\r\n        .chart-card:-webkit-full-screen .toolbar .tool-btn {\r\n            width: 100% !important;\r\n            text-align: left !important;\r\n            padding: 8px 12px !important;\r\n            border-radius: 6px !important;\r\n            flex-shrink: 0 !important;\r\n        }\r\n\r\n        .chart-card:fullscreen .toolbar .tool-checkbox,\r\n        .chart-card:-webkit-full-screen .toolbar .tool-checkbox {\r\n            width: 100% !important;\r\n            box-sizing: border-box !important;\r\n            padding: 6px 8px !important;\r\n            flex-shrink: 0 !important;\r\n            margin-left: 0 !important;\r\n        }\r\n\r\n        .chart-card:fullscreen .toolbar #btn-fullscreen-main,\r\n        .chart-card:-webkit-full-screen .toolbar #btn-fullscreen-main {\r\n            grid-column: span 2 !important;\r\n        }\r\n\r\n        .chart-card:fullscreen .toolbar span,\r\n        .chart-card:-webkit-full-screen .toolbar span {\r\n            grid-column: span 2 !important;\r\n            margin-top: 4px !important;\r\n            margin-bottom: 2px !important;\r\n        }\r\n\r\n        .chart-card:fullscreen .toolbar div[style*=\"width: 1px\"],\r\n        .chart-card:-webkit-full-screen .toolbar div[style*=\"width: 1px\"],\r\n        .chart-card:fullscreen .toolbar div[style*=\"width:1px\"],\r\n        .chart-card:-webkit-full-screen .toolbar div[style*=\"width:1px\"] {\r\n            grid-column: span 2 !important;\r\n            width: 100% !important;\r\n            height: 1px !important;\r\n            margin: 6px 0 !important;\r\n            background: #30363d !important;\r\n            flex-shrink: 0 !important;\r\n        }\r\n\r\n        /* ========================================================================= */\r\n        /* ROTATED MOBILE SIDEBAR TOOLBAR: Fixed columns fitting screen height/width */\r\n        /* ========================================================================= */\r\n        .rotate-mobile .toolbar {\r\n            position: absolute !important;\r\n            top: 70px !important;\r\n            left: 15px !important;\r\n            width: calc(100dvh - 100px) !important;\r\n            /* Card's width runs physically vertically */\r\n            height: 290px !important;\r\n            /* Card's height runs physically horizontally (fits within physical width) */\r\n            max-height: none !important;\r\n            background: rgba(13, 17, 23, 0.96) !important;\r\n            backdrop-filter: blur(15px) !important;\r\n            border: 1px solid var(--border) !important;\r\n            border-radius: 12px !important;\r\n            padding: 10px !important;\r\n            display: flex !important;\r\n            flex-direction: row !important;\r\n            /* Stack along card's X-axis -> physical vertical columns */\r\n            flex-wrap: wrap !important;\r\n            /* Wrap along card's Y-axis -> physical horizontal rows */\r\n            align-content: flex-start !important;\r\n            justify-content: flex-start !important;\r\n            align-items: center !important;\r\n            gap: 6px 8px !important;\r\n            z-index: 99999 !important;\r\n            overflow-x: hidden !important;\r\n            overflow-y: hidden !important;\r\n            /* Entirely fits on screen, no scrolling needed! */\r\n            transform: translateY(-400px) !important;\r\n            /* Slides completely off-screen along card's Y-axis (physically to the right) */\r\n            transition: transform 0.3s ease !important;\r\n            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;\r\n        }\r\n\r\n        /* Slide in sidebar when expanded in rotated mobile view */\r\n        .rotate-mobile .toolbar.open {\r\n            transform: translateY(0) !important;\r\n        }\r\n\r\n        /* Rotate items physically vertically using card coordinate alignment */\r\n        .rotate-mobile .toolbar .tool-btn,\r\n        .rotate-mobile .toolbar .tool-checkbox {\r\n            width: 120px !important;\r\n            /* Card's X-axis dimension -> physical height of item */\r\n            height: 34px !important;\r\n            /* Card's Y-axis dimension -> physical width of item */\r\n            text-align: left !important;\r\n            padding: 4px 8px !important;\r\n            border-radius: 6px !important;\r\n            flex-shrink: 0 !important;\r\n            box-sizing: border-box !important;\r\n            margin: 0 !important;\r\n            display: flex !important;\r\n            align-items: center !important;\r\n            font-size: 0.72rem !important;\r\n        }\r\n\r\n        .rotate-mobile .toolbar span {\r\n            width: 100% !important;\r\n            /* Spans full height of column, forcing a column break to start new section */\r\n            margin: 6px 0 !important;\r\n            color: #8E9BAE !important;\r\n            font-size: 0.7rem !important;\r\n            font-weight: bold !important;\r\n            text-transform: uppercase !important;\r\n            display: flex !important;\r\n            align-items: center !important;\r\n        }\r\n\r\n        /* Vertical spacer separating columns physically */\r\n        .rotate-mobile .toolbar div[style*=\"width: 1px\"],\r\n        .rotate-mobile .toolbar div[style*=\"width:1px\"] {\r\n            width: 100% !important;\r\n            /* Spans full height of column, forcing a column break to start new section */\r\n            height: 1px !important;\r\n            margin: 4px 0 !important;\r\n            background: #30363d !important;\r\n            flex-shrink: 0 !important;\r\n        }\r\n\r\n        .rotate-mobile #svg-container {\r\n            height: calc(100vw - 24px) !important;\r\n            flex: none !important;\r\n            width: 100% !important;\r\n        }\r\n\r\n        .rotate-mobile #pattern-container {\r\n            flex: 1 1 0 !important;\r\n            height: auto !important;\r\n            width: 100% !important;\r\n        }\r\n\r\n        .rotate-mobile .sub-chart {\r\n            height: 120px !important;\r\n            flex-shrink: 0 !important;\r\n        }\r\n\r\n        /* Hide navbar/header and sidebar when chart is in full screen or mobile rotated view */\r\n        body.fullscreen-active .navbar,\r\n        body.fullscreen-active .price-ticker-wrapper,\r\n        body.fullscreen-active .ticker-sidebar,\r\n        body.fullscreen-active .side-panel,\r\n        body.fullscreen-active .side-panel.right,\r\n        body.fullscreen-active .strategy-header {\r\n            display: none !important;\r\n        }\r\n\r\n        body.fullscreen-active .main-wrapper {\r\n            display: block !important;\r\n            padding: 0 !important;\r\n            margin: 0 !important;\r\n            height: 100vh !important;\r\n            width: 100vw !important;\r\n        }\r\n\r\n        body.fullscreen-active .content-panel {\r\n            background: transparent !important;\r\n            border: none !important;\r\n            box-shadow: none !important;\r\n            padding: 0 !important;\r\n            overflow: visible !important;\r\n            backdrop-filter: none !important;\r\n            filter: none !important;\r\n        }\r\n\r\n        /* Ensure viewport scrolling is entirely locked when mobile full screen / rotated canvas is open */\r\n        body.fullscreen-active {\r\n            position: fixed !important;\r\n            top: 0 !important;\r\n            left: 0 !important;\r\n            width: 100% !important;\r\n            height: 100% !important;\r\n            overflow: hidden !important;\r\n        }\r\n        @keyframes pulse-green {\r\n            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(38, 166, 154, 0.7); }\r\n            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(38, 166, 154, 0); }\r\n            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(38, 166, 154, 0); }\r\n        }\r\n        @keyframes blink {\r\n            from, to { border-color: transparent }\r\n            50% { border-color: #38bdf8; }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n    <link rel=\"stylesheet\" href=\"/css/header.css\" crossorigin=\"anonymous\">\r\n\r\n<nav class=\"navbar\">\r\n    <button id=\"mobile-menu-btn\" class=\"hamburger-btn\">☰</button>\r\n    <div class=\"nav-logo\" onclick=\"window.location.href='/'\">\r\n        <img src=\"/images/finorapulse-logo-full.png\" alt=\"FinoraPulse Logo\" class=\"logo-full\">\r\n    </div>\r\n\r\n    <div class=\"nav-center\">\r\n        <div class=\"nav-links\">\r\n            <a href=\"/\" style=\"color:white;\">Home</a>\r\n            <a href=\"/predict?ticker=RELIANCE.NS\" style=\"color:var(--text-muted, #8E9BAE);\">Predict Price</a>\r\n            <a href=\"/macro\" style=\"color:var(--text-muted, #8E9BAE);\">Macro Explorer</a>\r\n            <a href=\"/heatmap\" style=\"color:var(--text-muted, #8E9BAE);\">Heatmap Explorer</a>\r\n            <a href=\"/calculator\" style=\"color:var(--text-muted, #8E9BAE);\">Pro Calculators</a>\r\n            <a href=\"/trade-history\" style=\"color:var(--text-muted, #8E9BAE);\">Practice Portfolio</a>\r\n            <a href=\"#\" id=\"openSuggestionBtn\" style=\"color:var(--text-muted, #8E9BAE);\">💡 Suggestion</a>\r\n        </div>\r\n\r\n        <form action=\"/predict\" method=\"GET\" class=\"nav-search\">\r\n            <div class=\"search-input-wrapper\">\r\n                <input type=\"text\" name=\"ticker\" id=\"stockSearch\" placeholder=\"Search Asset (e.g. AAPL, BTC-USD)...\"\r\n                    autocomplete=\"off\" required>\r\n                <div id=\"searchSuggestions\" class=\"suggestions-box\"></div>\r\n            </div>\r\n            <button type=\"submit\" class=\"btn\">Search</button>\r\n        </form>\r\n    </div>\r\n\r\n    <div class=\"nav-auth\">\r\n        \r\n            <span style=\"margin-right: 15px; font-size: 0.85rem; color: var(--text-muted, #8E9BAE);\">ID: <span\r\n                    style=\"color:white;\">\r\n                    ___USER_NAME_PLACEHOLDER___\r\n                </span></span>\r\n            <a href=\"/logout\" class=\"btn\"\r\n                style=\"background: var(--border, #334155); color: var(--text-muted, #8E9BAE);\">Logout</a>\r\n            \r\n    </div>\r\n</nav>\r\n\r\n\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n        const mobileBtn = document.getElementById('mobile-menu-btn');\r\n\r\n        // Contextual Sidebar Logic\r\n        if (mobileBtn) {\r\n            mobileBtn.addEventListener('click', (e) => {\r\n                e.preventDefault();\r\n                e.stopPropagation();\r\n                // Find any .ticker-sidebar on the page\r\n                const sidebar = document.querySelector('.ticker-sidebar');\r\n                if (sidebar) {\r\n                    sidebar.classList.toggle('open');\r\n                }\r\n            });\r\n        }\r\n\r\n        // Close sidebar if clicked outside\r\n        document.addEventListener('click', (e) => {\r\n            const sidebar = document.querySelector('.ticker-sidebar.open');\r\n            if (sidebar && !sidebar.contains(e.target) && e.target !== mobileBtn) {\r\n                sidebar.classList.remove('open');\r\n            }\r\n        });\r\n    });\r\n\r\n    // 1. Synchronize Top Ticker\r\n    function updateHeaderMarketWatch() {\r\n        fetch('/api/market').then(res => res.json()).then(data => {\r\n            document.querySelectorAll('#header-ticker [data-ticker]').forEach(el => {\r\n                const ticker = el.getAttribute('data-ticker');\r\n                if (data[ticker]) {\r\n                    const priceEl = el.querySelector('.price-val');\r\n                    const changeEl = el.querySelector('.change-val');\r\n\r\n                    const isIndian = ticker.includes('.NS') || ticker.includes('.BO') || ticker === 'INR=X' || ticker === '^NSEI';\r\n                    const isEuro = ticker.includes('EUR');\r\n                    const isPound = ticker.includes('GBP');\r\n                    const isYen = ticker.includes('JPY');\r\n\r\n                    let sym = \"$\";\r\n                    if (isIndian) sym = \"₹\";\r\n                    if (isEuro) sym = \"€\";\r\n                    if (isPound) sym = \"£\";\r\n                    if (isYen) sym = \"¥\";\r\n                    if (ticker.includes('^')) sym = \"\";\r\n\r\n                    const change = data[ticker].change;\r\n                    const isUp = change >= 0;\r\n\r\n                    // FORCE COLORS VIA JAVASCRIPT\r\n                    const textColor = isUp ? '#00FF41' : '#ff4d4d';\r\n\r\n                    if (priceEl) {\r\n                        priceEl.innerText = sym + data[ticker].price.toFixed(2);\r\n                        priceEl.style.color = textColor; // Apply color to price\r\n                    }\r\n                    if (changeEl) {\r\n                        changeEl.innerText = (isUp ? '▲ ' : '▼ ') + Math.abs(change).toFixed(2) + '%';\r\n                        changeEl.style.color = textColor; // Apply color to change %\r\n                    }\r\n                }\r\n            });\r\n        }).catch(err => console.log(\"Market sync paused...\"));\r\n    }\r\n\r\n    updateHeaderMarketWatch();\r\n    // Set to 15 minutes (900,000 milliseconds)\r\n    setInterval(updateHeaderMarketWatch, 900000);\r\n\r\n    // ... (Keep your Search Bar Auto-Suggest code the same below this) ...\r\n    // 2. Search Bar Auto-Suggest\r\n    const searchInput = document.getElementById('stockSearch');\r\n    const suggestionsBox = document.getElementById('searchSuggestions');\r\n\r\n    if (searchInput && suggestionsBox) {\r\n        searchInput.addEventListener('input', async (e) => {\r\n            const query = e.target.value;\r\n            if (query.length < 2) { suggestionsBox.style.display = 'none'; return; }\r\n\r\n            try {\r\n                const res = await fetch(`/api/search-suggest?q=${query}`);\r\n                const suggestions = await res.json();\r\n\r\n                if (suggestions.length > 0) {\r\n                    suggestionsBox.innerHTML = suggestions.map(s => `\r\n                        <div class=\"suggestion-item\" onclick=\"window.location.href='/predict?ticker=${s.symbol}'\">\r\n                            <strong>${s.symbol}</strong> - ${s.name}\r\n                        </div>\r\n                    `).join('');\r\n                    suggestionsBox.style.display = 'block';\r\n                } else {\r\n                    suggestionsBox.style.display = 'none';\r\n                }\r\n            } catch (err) { console.error(\"Search error\", err); }\r\n        });\r\n\r\n        document.addEventListener('click', (e) => {\r\n            if (!searchInput.contains(e.target)) suggestionsBox.style.display = 'none';\r\n        });\r\n    }\r\n\r\n    // 3. Suggestion Modal Logic\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n        const suggestionModal = document.getElementById('suggestionModal');\r\n        const openSuggestionBtn = document.getElementById('openSuggestionBtn');\r\n        const closeSuggestionBtn = document.getElementById('closeSuggestionBtn');\r\n        const submitSuggestionBtn = document.getElementById('submitSuggestionBtn');\r\n        const suggestionText = document.getElementById('suggestionText');\r\n        const suggestionStatus = document.getElementById('suggestionStatus');\r\n\r\n        if (openSuggestionBtn && suggestionModal) {\r\n            openSuggestionBtn.addEventListener('click', (e) => {\r\n                e.preventDefault();\r\n                suggestionModal.style.display = 'flex';\r\n                suggestionStatus.style.display = 'none';\r\n                suggestionText.value = '';\r\n            });\r\n\r\n            closeSuggestionBtn.addEventListener('click', () => {\r\n                suggestionModal.style.display = 'none';\r\n            });\r\n\r\n            window.addEventListener('click', (e) => {\r\n                if (e.target === suggestionModal) {\r\n                    suggestionModal.style.display = 'none';\r\n                }\r\n            });\r\n\r\n            submitSuggestionBtn.addEventListener('click', async () => {\r\n                const text = suggestionText.value.trim();\r\n                if (!text) return;\r\n\r\n                submitSuggestionBtn.disabled = true;\r\n                submitSuggestionBtn.innerText = 'Submitting...';\r\n\r\n                try {\r\n                    const response = await fetch('/api/suggestion', {\r\n                        method: 'POST',\r\n                        headers: { 'Content-Type': 'application/json' },\r\n                        body: JSON.stringify({ text })\r\n                    });\r\n                    const data = await response.json();\r\n\r\n                    suggestionStatus.style.display = 'block';\r\n                    if (data.success) {\r\n                        suggestionStatus.style.color = '#00FF41';\r\n                        suggestionStatus.innerText = data.message;\r\n                        setTimeout(() => {\r\n                            suggestionModal.style.display = 'none';\r\n                        }, 2000);\r\n                    } else {\r\n                        suggestionStatus.style.color = '#f43f5e';\r\n                        suggestionStatus.innerText = data.error || 'Failed to submit.';\r\n                    }\r\n                } catch (err) {\r\n                    suggestionStatus.style.display = 'block';\r\n                    suggestionStatus.style.color = '#f43f5e';\r\n                    suggestionStatus.innerText = 'An error occurred.';\r\n                } finally {\r\n                    submitSuggestionBtn.disabled = false;\r\n                    submitSuggestionBtn.innerText = 'Submit';\r\n                }\r\n            });\r\n        }\r\n\r\n        // About Us Modal Logic\r\n        const aboutModal = document.getElementById('aboutUsModal');\r\n        const closeAboutBtn = document.getElementById('closeAboutUsBtn');\r\n\r\n        if (aboutModal) {\r\n            document.addEventListener('click', (e) => {\r\n                if (e.target && (e.target.id === 'openAboutUsBtn' || e.target.closest('#openAboutUsBtn'))) {\r\n                    e.preventDefault();\r\n                    aboutModal.style.display = 'flex';\r\n                }\r\n            });\r\n\r\n            if (closeAboutBtn) {\r\n                closeAboutBtn.addEventListener('click', () => {\r\n                    aboutModal.style.display = 'none';\r\n                });\r\n            }\r\n\r\n            window.addEventListener('click', (e) => {\r\n                if (e.target === aboutModal) {\r\n                    aboutModal.style.display = 'none';\r\n                }\r\n            });\r\n        }\r\n    });\r\n</script>\r\n\r\n<!-- Suggestion Modal -->\r\n<div id=\"suggestionModal\" class=\"modal-overlay\"\r\n    style=\"display:none; align-items:center; justify-content:center; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.8); z-index:9999; backdrop-filter: blur(5px);\">\r\n    <div class=\"modal-content\"\r\n        style=\"position:relative; width:90%; max-width:550px; background:rgba(10, 15, 25, 0.95); border:1px solid #0ff; border-radius:12px; padding:35px; box-shadow:0 0 25px rgba(0, 255, 255, 0.2); font-family: 'Courier New', Courier, monospace; color:#b0c4de;\">\r\n        <span id=\"closeSuggestionBtn\"\r\n            style=\"position:absolute; top:15px; right:20px; font-size:1.8rem; color:#ff0055; cursor:pointer; font-weight:bold; transition: 0.3s;\"\r\n            onmouseover=\"this.style.textShadow='0 0 10px #ff0055'\"\r\n            onmouseout=\"this.style.textShadow='none'\">&times;</span>\r\n\r\n        <h2\r\n            style=\"margin-top:0; margin-bottom: 20px; color:#0ff; text-align:center; font-size:2rem; letter-spacing:3px; font-weight:normal; text-shadow:0 0 10px rgba(0,255,255,0.5);\">\r\n            Suggestion</h2>\r\n\r\n        <p style=\"font-size:0.95rem; line-height:1.6; margin-bottom:20px; color:#a0aab5; text-align:center;\">\r\n            Help us improve FinoraPulse. Leave your review or suggestion below.\r\n        </p>\r\n\r\n        <textarea id=\"suggestionText\" rows=\"6\" placeholder=\"Write your review or suggestion here...\"\r\n            style=\"width:100%; padding:15px; background:rgba(0, 0, 0, 0.6); border:1px solid #334155; color:#0ff; border-radius:8px; outline:none; box-sizing:border-box; resize:vertical; margin-bottom:20px; font-family:inherit; font-size:0.95rem; transition: 0.3s; box-shadow: inset 0 0 5px rgba(0,0,0,0.5);\"\r\n            onfocus=\"this.style.borderColor='#0ff'; this.style.boxShadow='0 0 10px rgba(0, 255, 255, 0.2)'\"\r\n            onblur=\"this.style.borderColor='#334155'; this.style.boxShadow='inset 0 0 5px rgba(0,0,0,0.5)'\"></textarea>\r\n\r\n        <button id=\"submitSuggestionBtn\" class=\"btn\"\r\n            style=\"width:100%; background:transparent; border:1px solid #0ff; color:#0ff; padding:12px; cursor:pointer; font-family:inherit; font-weight:bold; font-size:1.1rem; border-radius:6px; transition:0.3s; margin-bottom: 5px; text-transform:uppercase; letter-spacing:1px;\"\r\n            onmouseover=\"this.style.background='rgba(0, 255, 255, 0.1)'; this.style.boxShadow='0 0 15px rgba(0, 255, 255, 0.3)'\"\r\n            onmouseout=\"this.style.background='transparent'; this.style.boxShadow='none'\">Submit</button>\r\n        <p id=\"suggestionStatus\"\r\n            style=\"display:none; margin-top:10px; margin-bottom:0; font-weight:bold; text-align:center; font-size:1rem;\">\r\n        </p>\r\n    </div>\r\n</div>\r\n\r\n<!-- About Us Modal (Popup) -->\r\n<div id=\"aboutUsModal\" class=\"about-modal-overlay\"\r\n    style=\"display: none; align-items: center; justify-content: center; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.85); z-index: 10000; backdrop-filter: blur(5px);\">\r\n    <div class=\"about-modal-content\"\r\n        style=\"position: relative; width: 90%; max-width: 580px; background: rgba(10, 15, 25, 0.95); border: 1px solid #00E5FF; border-radius: 16px; padding: 35px; box-shadow: 0 0 30px rgba(0, 229, 255, 0.25); font-family: 'Inter', sans-serif; color: #b0c4de;\">\r\n\r\n        <!-- Close Button (Red 'X') -->\r\n        <span id=\"closeAboutUsBtn\"\r\n            style=\"position: absolute; top: 15px; right: 20px; font-size: 1.8rem; color: #ff0055; cursor: pointer; font-weight: bold; transition: 0.3s;\"\r\n            onmouseover=\"this.style.textShadow='0 0 10px #ff0055'\"\r\n            onmouseout=\"this.style.textShadow='none'\">&times;</span>\r\n\r\n        <!-- Title -->\r\n        <h2\r\n            style=\"margin-top: 0; margin-bottom: 20px; color: #00E5FF; text-align: center; font-size: 2rem; font-weight: normal; letter-spacing: 2px; text-shadow: 0 0 15px rgba(0, 229, 255, 0.5);\">\r\n            About Us</h2>\r\n\r\n        <!-- Content -->\r\n        <p style=\"font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; color: #94a3b8; text-align: justify;\">\r\n            Welcome to FinoraPulse, your go-to AI-powered quantitative terminal for stock market analysis and\r\n            predictions. Whether you need real-time technical charting, macro data, heatmaps, or simulated trading, we\r\n            make it quick, easy, and secure.\r\n        </p>\r\n\r\n        <!-- Our Mission -->\r\n        <h3\r\n            style=\"color: #00E5FF; text-align: center; font-size: 1.4rem; font-weight: normal; letter-spacing: 1px; margin-top: 25px; margin-bottom: 15px; text-shadow: 0 0 10px rgba(0, 229, 255, 0.3);\">\r\n            Our Mission</h3>\r\n        <p style=\"font-size: 0.95rem; line-height: 1.6; margin-bottom: 15px; color: #94a3b8; text-align: justify;\">\r\n            FinoraPulse was founded with a simple mission – to make algorithmic stock analytics and trading simulation\r\n            accessible to everyone. We noticed that many financial analytics platforms were either too complicated,\r\n            slow, or locked behind expensive paywalls. That’s why we built FinoraPulse – a fast, user-friendly, and\r\n            all-in-one market quant terminal.\r\n        </p>\r\n        <p style=\"font-size: 0.95rem; line-height: 1.6; margin-bottom: 25px; color: #94a3b8; text-align: justify;\">\r\n            At FinoraPulse, we provide a fast, secure, and efficient way to analyze global assets. Whether you need to\r\n            monitor Indian or US equities, scan macroeconomic patterns, or practice trading strategy, our platform makes\r\n            the process seamless and hassle-free.\r\n        </p>\r\n\r\n        <!-- Divider -->\r\n        <div style=\"border-top: 1px dashed rgba(255, 255, 255, 0.08); margin-bottom: 25px; width: 100%;\"></div>\r\n\r\n        <!-- Founder Details -->\r\n        <div style=\"display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;\">\r\n            <div>\r\n                <h4\r\n                    style=\"margin: 0; color: #00E5FF; font-size: 1.6rem; font-weight: normal; letter-spacing: 1px; text-shadow: 0 0 10px rgba(0, 229, 255, 0.3);\">\r\n                    Kartik M G</h4>\r\n                <div style=\"color: #94a3b8; font-size: 0.95rem; margin-top: 4px;\">Founder & Developer</div>\r\n\r\n                <!-- Email contact -->\r\n                <div\r\n                    style=\"margin-top: 15px; display: flex; align-items: center; gap: 8px; color: #00FF9D; font-size: 0.9rem; font-weight: 600;\">\r\n                    <span style=\"font-size: 1.1rem; color: #00FF9D;\">✉</span>\r\n                    <a href=\"mailto:finorapulse@gmail.com\" style=\"color: #00FF9D; text-decoration: none;\"\r\n                        onmouseover=\"this.style.textDecoration='underline'\"\r\n                        onmouseout=\"this.style.textDecoration='none'\">finorapulse@gmail.com</a>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Circular Avatar -->\r\n            <div\r\n                style=\"width: 100px; height: 100px; border-radius: 50%; border: 3px solid #00E5FF; box-shadow: 0 0 15px rgba(0, 229, 255, 0.4); overflow: hidden; background: #1a2035; flex-shrink: 0; display: flex; align-items: center; justify-content: center;\">\r\n                <img src=\"/images/kartikmg.png\" alt=\"Kartik M G\" style=\"width: 100%; height: 100%; object-fit: cover;\">\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n</div>\r\n\r\n<!-- Floating AI Chatbot Toggle Button -->\r\n<button id=\"chat-trigger-btn\" class=\"chat-trigger-btn\" title=\"Open Finora AI Assistant\">\r\n    <span class=\"chat-icon\">🤖</span>\r\n    <span class=\"pulse-ring\"></span>\r\n</button>\r\n\r\n<!-- Sleek Glassmorphic Chat Window -->\r\n<div id=\"chat-window\" class=\"chat-window\" style=\"display: none;\">\r\n    <div class=\"chat-header\">\r\n        <div class=\"chat-header-title\">\r\n            <span class=\"chat-bot-avatar\">🤖</span>\r\n            <div>\r\n                <strong style=\"color: #fff; font-size: 0.95rem;\">Finora AI Analyst</strong>\r\n                <div class=\"chat-status\"><span class=\"status-dot\"></span> Online</div>\r\n            </div>\r\n        </div>\r\n        <button id=\"chat-close-btn\" class=\"chat-close-btn\">&times;</button>\r\n    </div>\r\n\r\n    <div class=\"chat-messages\" id=\"chat-messages-container\">\r\n        <div class=\"chat-bubble bot-message\">\r\n            Hi! I am **Finora AI**, your virtual quant terminal assistant.\r\n            I can run real-time technical analysis or pull macro economic summaries.\r\n\r\n            How can I help you today?\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Quick Action Prompts -->\r\n    <div class=\"chat-suggestions\">\r\n        <button onclick=\"sendQuickPrompt('Analyze current asset')\">📈 Analyze Current Asset</button>\r\n        <button onclick=\"sendQuickPrompt('GDP of India')\">🇮🇳 Macro India</button>\r\n        <button onclick=\"sendQuickPrompt('Macro indicators for USA')\">🇺🇸 Macro USA</button>\r\n    </div>\r\n\r\n    <div class=\"chat-input-area\">\r\n        <input type=\"text\" id=\"chat-user-input\" placeholder=\"Ask about stocks, crypto, or macro metrics...\"\r\n            autocomplete=\"off\">\r\n        <button id=\"chat-send-btn\">Send</button>\r\n    </div>\r\n</div>\r\n\r\n<style>\r\n    /* Floating trigger button */\r\n    .chat-trigger-btn {\r\n        display: none !important; /* Temporarily disabled */\r\n        position: fixed;\r\n        bottom: 25px;\r\n        right: 25px;\r\n        width: 60px;\r\n        height: 60px;\r\n        border-radius: 50%;\r\n        background: linear-gradient(135deg, #00f0ff, #a855f7);\r\n        border: none;\r\n        box-shadow: 0 4px 20px rgba(0, 240, 255, 0.4);\r\n        cursor: pointer;\r\n        z-index: 9999;\r\n        display: flex;\r\n        align-items: center;\r\n        justify-content: center;\r\n        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);\r\n    }\r\n\r\n    .chat-trigger-btn:hover {\r\n        transform: scale(1.1);\r\n    }\r\n\r\n    .chat-icon {\r\n        font-size: 1.8rem;\r\n    }\r\n\r\n    .pulse-ring {\r\n        position: absolute;\r\n        width: 100%;\r\n        height: 100%;\r\n        border-radius: 50%;\r\n        border: 2px solid #00f0ff;\r\n        animation: chat-pulse 2s infinite;\r\n        opacity: 0;\r\n        top: 0;\r\n        left: 0;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    @keyframes chat-pulse {\r\n        0% {\r\n            transform: scale(1);\r\n            opacity: 0.6;\r\n        }\r\n\r\n        100% {\r\n            transform: scale(1.4);\r\n            opacity: 0;\r\n        }\r\n    }\r\n\r\n    /* Chat window container */\r\n    .chat-window {\r\n        position: fixed;\r\n        bottom: 100px;\r\n        right: 25px;\r\n        width: 380px;\r\n        height: 500px;\r\n        background: rgba(13, 17, 23, 0.96);\r\n        backdrop-filter: blur(15px);\r\n        border: 1px solid rgba(0, 240, 255, 0.2);\r\n        border-radius: 16px;\r\n        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6), 0 0 25px rgba(0, 240, 255, 0.1);\r\n        display: flex;\r\n        flex-direction: column;\r\n        z-index: 9999;\r\n        overflow: hidden;\r\n        animation: chat-slide-in 0.3s ease-out;\r\n    }\r\n\r\n    @keyframes chat-slide-in {\r\n        from {\r\n            transform: translateY(20px);\r\n            opacity: 0;\r\n        }\r\n\r\n        to {\r\n            transform: translateY(0);\r\n            opacity: 1;\r\n        }\r\n    }\r\n\r\n    /* Chat Header */\r\n    .chat-header {\r\n        background: linear-gradient(90deg, rgba(13, 17, 23, 0.9), rgba(168, 85, 247, 0.15));\r\n        border-bottom: 1px solid rgba(255, 255, 255, 0.08);\r\n        padding: 15px 20px;\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n        flex-shrink: 0;\r\n    }\r\n\r\n    .chat-header-title {\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 12px;\r\n    }\r\n\r\n    .chat-bot-avatar {\r\n        font-size: 1.5rem;\r\n    }\r\n\r\n    .chat-status {\r\n        font-size: 0.75rem;\r\n        color: #8E9BAE;\r\n        display: flex;\r\n        align-items: center;\r\n        gap: 5px;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .status-dot {\r\n        width: 6px;\r\n        height: 6px;\r\n        background: #00FF9D;\r\n        border-radius: 50%;\r\n        display: inline-block;\r\n        box-shadow: 0 0 8px #00FF9D;\r\n    }\r\n\r\n    .chat-close-btn {\r\n        background: transparent;\r\n        border: none;\r\n        color: #8E9BAE;\r\n        font-size: 1.5rem;\r\n        cursor: pointer;\r\n        transition: color 0.2s;\r\n    }\r\n\r\n    .chat-close-btn:hover {\r\n        color: #ff4d4d;\r\n    }\r\n\r\n    /* Messages container */\r\n    .chat-messages {\r\n        flex-grow: 1;\r\n        padding: 20px;\r\n        overflow-y: auto;\r\n        display: flex;\r\n        flex-direction: column;\r\n        gap: 15px;\r\n        scroll-behavior: smooth;\r\n    }\r\n\r\n    /* Scrollbar */\r\n    .chat-messages::-webkit-scrollbar {\r\n        width: 5px;\r\n    }\r\n\r\n    .chat-messages::-webkit-scrollbar-track {\r\n        background: rgba(0, 0, 0, 0.1);\r\n    }\r\n\r\n    .chat-messages::-webkit-scrollbar-thumb {\r\n        background: rgba(255, 255, 255, 0.15);\r\n        border-radius: 5px;\r\n    }\r\n\r\n    /* Bubble styles */\r\n    .chat-bubble {\r\n        max-width: 85%;\r\n        padding: 12px 16px;\r\n        border-radius: 12px;\r\n        font-size: 0.9rem;\r\n        line-height: 1.5;\r\n        white-space: pre-line;\r\n    }\r\n\r\n    .bot-message {\r\n        align-self: flex-start;\r\n        background: rgba(30, 41, 59, 0.6);\r\n        border: 1px solid rgba(255, 255, 255, 0.05);\r\n        color: #e2e8f0;\r\n        border-bottom-left-radius: 2px;\r\n    }\r\n\r\n    .bot-message strong {\r\n        color: #00f0ff;\r\n    }\r\n\r\n    .bot-message h3,\r\n    .bot-message h4 {\r\n        margin-top: 5px;\r\n        margin-bottom: 5px;\r\n        color: #a855f7;\r\n        font-size: 0.95rem;\r\n    }\r\n\r\n    .bot-message ul,\r\n    .bot-message ol {\r\n        margin: 5px 0;\r\n        padding-left: 20px;\r\n    }\r\n\r\n    .bot-message code {\r\n        background: rgba(0, 0, 0, 0.4);\r\n        padding: 2px 5px;\r\n        border-radius: 4px;\r\n        font-family: monospace;\r\n        color: #fbbf24;\r\n    }\r\n\r\n    .user-message {\r\n        align-self: flex-end;\r\n        background: linear-gradient(135deg, rgba(0, 240, 255, 0.2), rgba(168, 85, 247, 0.2));\r\n        border: 1px solid rgba(0, 240, 255, 0.3);\r\n        color: #fff;\r\n        border-bottom-right-radius: 2px;\r\n    }\r\n\r\n    /* Suggestions */\r\n    .chat-suggestions {\r\n        padding: 0 20px 10px 20px;\r\n        display: flex;\r\n        gap: 8px;\r\n        overflow-x: auto;\r\n        flex-shrink: 0;\r\n    }\r\n\r\n    .chat-suggestions::-webkit-scrollbar {\r\n        display: none;\r\n    }\r\n\r\n    .chat-suggestions button {\r\n        background: rgba(255, 255, 255, 0.04);\r\n        border: 1px solid rgba(255, 255, 255, 0.08);\r\n        color: #cbd5e1;\r\n        padding: 6px 12px;\r\n        border-radius: 20px;\r\n        font-size: 0.75rem;\r\n        cursor: pointer;\r\n        white-space: nowrap;\r\n        transition: all 0.2s;\r\n    }\r\n\r\n    .chat-suggestions button:hover {\r\n        background: rgba(0, 240, 255, 0.1);\r\n        border-color: rgba(0, 240, 255, 0.3);\r\n        color: #fff;\r\n    }\r\n\r\n    /* Input area */\r\n    .chat-input-area {\r\n        padding: 15px 20px;\r\n        border-top: 1px solid rgba(255, 255, 255, 0.08);\r\n        display: flex;\r\n        gap: 10px;\r\n        align-items: center;\r\n        background: rgba(8, 10, 12, 0.5);\r\n        flex-shrink: 0;\r\n    }\r\n\r\n    .chat-input-area input {\r\n        flex-grow: 1;\r\n        background: rgba(0, 0, 0, 0.4);\r\n        border: 1px solid rgba(255, 255, 255, 0.1);\r\n        border-radius: 8px;\r\n        padding: 10px 15px;\r\n        color: #fff;\r\n        font-size: 0.88rem;\r\n        outline: none;\r\n        transition: border-color 0.2s;\r\n    }\r\n\r\n    .chat-input-area input:focus {\r\n        border-color: #00f0ff;\r\n    }\r\n\r\n    .chat-input-area button {\r\n        background: linear-gradient(135deg, #00f0ff, #a855f7);\r\n        color: #0d1117;\r\n        font-weight: bold;\r\n        border: none;\r\n        padding: 10px 18px;\r\n        border-radius: 8px;\r\n        cursor: pointer;\r\n        font-size: 0.88rem;\r\n        transition: opacity 0.2s;\r\n    }\r\n\r\n    .chat-input-area button:hover {\r\n        opacity: 0.9;\r\n    }\r\n\r\n    /* Loading dots */\r\n    .chat-typing-indicator {\r\n        display: flex;\r\n        gap: 4px;\r\n        padding: 5px;\r\n        align-self: flex-start;\r\n    }\r\n\r\n    .chat-typing-indicator span {\r\n        width: 8px;\r\n        height: 8px;\r\n        background: #00f0ff;\r\n        border-radius: 50%;\r\n        animation: typing-bounce 1.4s infinite ease-in-out both;\r\n    }\r\n\r\n    .chat-typing-indicator span:nth-child(1) {\r\n        animation-delay: -0.32s;\r\n    }\r\n\r\n    .chat-typing-indicator span:nth-child(2) {\r\n        animation-delay: -0.16s;\r\n    }\r\n\r\n    @keyframes typing-bounce {\r\n\r\n        0%,\r\n        80%,\r\n        100% {\r\n            transform: scale(0);\r\n        }\r\n\r\n        40% {\r\n            transform: scale(1);\r\n        }\r\n    }\r\n\r\n    /* Mobile Responsive */\r\n    @media screen and (max-width: 480px) {\r\n        .chat-window {\r\n            bottom: 0;\r\n            right: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            border-radius: 0;\r\n            border: none;\r\n        }\r\n    }\r\n</style>\r\n\r\n<script>\r\n    document.addEventListener('DOMContentLoaded', () => {\r\n        const triggerBtn = document.getElementById('chat-trigger-btn');\r\n        const chatWindow = document.getElementById('chat-window');\r\n        const closeBtn = document.getElementById('chat-close-btn');\r\n        const sendBtn = document.getElementById('chat-send-btn');\r\n        const inputField = document.getElementById('chat-user-input');\r\n        const messagesContainer = document.getElementById('chat-messages-container');\r\n\r\n        if (!triggerBtn || !chatWindow) return;\r\n\r\n        // Toggle chat window visibility\r\n        triggerBtn.addEventListener('click', () => {\r\n            if (chatWindow.style.display === 'none') {\r\n                chatWindow.style.display = 'flex';\r\n                messagesContainer.scrollTop = messagesContainer.scrollHeight;\r\n                inputField.focus();\r\n            } else {\r\n                chatWindow.style.display = 'none';\r\n            }\r\n        });\r\n\r\n        closeBtn.addEventListener('click', () => {\r\n            chatWindow.style.display = 'none';\r\n        });\r\n\r\n        // Send message event handler\r\n        const sendMessage = async () => {\r\n            const text = inputField.value.trim();\r\n            if (!text) return;\r\n\r\n            // Render user message bubble\r\n            appendMessage(text, 'user');\r\n            inputField.value = '';\r\n\r\n            // Render bot typing indicator\r\n            const typingIndicator = appendTypingIndicator();\r\n\r\n            try {\r\n                // Determine ticker context from window URL search parameters or page elements\r\n                const urlParams = new URLSearchParams(window.location.search);\r\n                const ctxTicker = urlParams.get('ticker') || (typeof currentTicker !== 'undefined' ? currentTicker : '');\r\n                const ctxTimeframe = urlParams.get('timeframe') || (typeof currentTimeframe !== 'undefined' ? currentTimeframe : '1d');\r\n\r\n                const response = await fetch('/api/chat', {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify({\r\n                        message: text,\r\n                        contextTicker: ctxTicker,\r\n                        contextTimeframe: ctxTimeframe\r\n                    })\r\n                });\r\n\r\n                const data = await response.json();\r\n                typingIndicator.remove();\r\n\r\n                if (data.response) {\r\n                    appendMessage(data.response, 'bot');\r\n                } else {\r\n                    appendMessage('⚠️ Error: Empty response from AI assistant.', 'bot');\r\n                }\r\n            } catch (err) {\r\n                console.error(\"Chat error:\", err);\r\n                typingIndicator.remove();\r\n                appendMessage('❌ Connection error. Please verify the server is running.', 'bot');\r\n            }\r\n        };\r\n\r\n        sendBtn.addEventListener('click', sendMessage);\r\n        inputField.addEventListener('keypress', (e) => {\r\n            if (e.key === 'Enter') {\r\n                sendMessage();\r\n            }\r\n        });\r\n\r\n        // Helper: format markdown in message text\r\n        const formatMarkdown = (text) => {\r\n            return text\r\n                .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\r\n                .replace(/### (.*?)\\n/g, '<h3>$1</h3>')\r\n                .replace(/#### (.*?)\\n/g, '<h4>$1</h4>')\r\n                .replace(/`([^`]+)`/g, '<code>$1</code>')\r\n                .replace(/^- (.*?)\\n/gm, '• $1<br>');\r\n        };\r\n\r\n        const appendMessage = (text, sender) => {\r\n            const bubble = document.createElement('div');\r\n            bubble.classList.add('chat-bubble');\r\n            bubble.classList.add(sender === 'user' ? 'user-message' : 'bot-message');\r\n\r\n            if (sender === 'bot') {\r\n                bubble.innerHTML = formatMarkdown(text);\r\n            } else {\r\n                bubble.textContent = text;\r\n            }\r\n\r\n            messagesContainer.appendChild(bubble);\r\n            messagesContainer.scrollTop = messagesContainer.scrollHeight;\r\n        };\r\n\r\n        const appendTypingIndicator = () => {\r\n            const container = document.createElement('div');\r\n            container.classList.add('chat-bubble', 'bot-message', 'chat-typing-indicator');\r\n            container.innerHTML = '<span></span><span></span><span></span>';\r\n            messagesContainer.appendChild(container);\r\n            messagesContainer.scrollTop = messagesContainer.scrollHeight;\r\n            return container;\r\n        };\r\n\r\n        // Expose function for quick prompts\r\n        window.sendQuickPrompt = (promptText) => {\r\n            if (promptText === 'Analyze current asset') {\r\n                const urlParams = new URLSearchParams(window.location.search);\r\n                const ctxTicker = urlParams.get('ticker') || (typeof currentTicker !== 'undefined' ? currentTicker : 'RELIANCE.NS');\r\n                inputField.value = `Analyze ${ctxTicker}`;\r\n            } else {\r\n                inputField.value = promptText;\r\n            }\r\n            sendMessage();\r\n        };\r\n    });\r\n</script>\r\n\r\n        <div class=\"main-wrapper\">\r\n            <aside class=\"ticker-sidebar\">\r\n    <div class=\"sidebar-header\">Global Market Watch</div>\r\n    <div class=\"accordion-container\">\r\n        \r\n        <div class=\"acc-item\">\r\n            <button class=\"acc-btn\" onclick=\"toggleAcc('equities')\">📈 Equities <span class=\"arrow\">▾</span></button>\r\n            <div id=\"equities\" class=\"acc-content\"></div>\r\n        </div>\r\n\r\n        <div class=\"acc-item\">\r\n            <button class=\"acc-btn\" onclick=\"toggleAcc('crypto')\">🪙 Crypto <span class=\"arrow\">▾</span></button>\r\n            <div id=\"crypto\" class=\"acc-content\"></div>\r\n        </div>\r\n        \r\n        <div class=\"acc-item\">\r\n            <button class=\"acc-btn\" onclick=\"toggleAcc('forex')\">💱 Forex <span class=\"arrow\">▾</span></button>\r\n            <div id=\"forex\" class=\"acc-content\"></div>\r\n        </div>\r\n        \r\n        <div class=\"acc-item\">\r\n            <button class=\"acc-btn\" onclick=\"toggleAcc('commodities')\">🛢️ Commodities <span class=\"arrow\">▾</span></button>\r\n            <div id=\"commodities\" class=\"acc-content\"></div>\r\n        </div>\r\n\r\n        <div class=\"acc-item\">\r\n            <button class=\"acc-btn\" onclick=\"toggleAcc('indices')\">📊 Indices <span class=\"arrow\">▾</span></button>\r\n            <div id=\"indices\" class=\"acc-content\"></div>\r\n        </div>\r\n        \r\n        <div class=\"acc-item\">\r\n            <button class=\"acc-btn\" onclick=\"toggleAcc('etfs')\">🧺 ETFs <span class=\"arrow\">▾</span></button>\r\n            <div id=\"etfs\" class=\"acc-content\"></div>\r\n        </div>\r\n        \r\n        <div class=\"acc-item\">\r\n            <button class=\"acc-btn\" onclick=\"toggleAcc('bonds')\">📜 Bonds & Rates <span class=\"arrow\">▾</span></button>\r\n            <div id=\"bonds\" class=\"acc-content\"></div>\r\n        </div>\r\n\r\n    </div>\r\n</aside>\r\n\r\n<script>\r\n    // 1. ACCORDION CLICK LOGIC\r\n    function toggleAcc(id) {\r\n        const content = document.getElementById(id);\r\n        const allContent = document.querySelectorAll('.acc-content');\r\n        allContent.forEach(item => { if(item.id !== id) item.classList.remove('show'); });\r\n        content.classList.toggle('show');\r\n    }\r\n\r\n    function toggleNestedAcc(id, event) {\r\n        if(event) event.stopPropagation(); \r\n        const content = document.getElementById(id);\r\n        const allContent = document.querySelectorAll('.nested-acc-content');\r\n        allContent.forEach(item => { if(item.id !== id) item.classList.remove('nested-show'); });\r\n        content.classList.toggle('nested-show');\r\n    }\r\n\r\n    // 2. MASSIVE DATA ARRAYS\r\n    const globalEquities = [\r\n        { country: \"USA\", flag: \"🇺🇸\", id: \"eq-usa\", companies: [ { t: \"AAPL\", n: \"Apple Inc.\" }, { t: \"MSFT\", n: \"Microsoft\" }, { t: \"NVDA\", n: \"NVIDIA Corp\" }, { t: \"AMZN\", n: \"Amazon\" }, { t: \"META\", n: \"Meta Platforms\" }, { t: \"GOOGL\", n: \"Alphabet\" }, { t: \"TSLA\", n: \"Tesla Inc.\" }, { t: \"BRK-B\", n: \"Berkshire\" }, { t: \"LLY\", n: \"Eli Lilly\" }, { t: \"AVGO\", n: \"Broadcom\" }, { t: \"JPM\", n: \"JPMorgan\" }, { t: \"V\", n: \"Visa\" }, { t: \"UNH\", n: \"UnitedHealth\" }, { t: \"MA\", n: \"Mastercard\" }, { t: \"XOM\", n: \"Exxon Mobil\" }, { t: \"JNJ\", n: \"Johnson & Johnson\" }, { t: \"PG\", n: \"Procter & Gamble\" }, { t: \"HD\", n: \"Home Depot\" }, { t: \"COST\", n: \"Costco\" }, { t: \"MRK\", n: \"Merck\" } ] },\r\n        { country: \"India\", flag: \"🇮🇳\", id: \"eq-india\", companies: [ { t: \"RELIANCE.NS\", n: \"Reliance\" }, { t: \"TCS.NS\", n: \"TCS\" }, { t: \"HDFCBANK.NS\", n: \"HDFC Bank\" }, { t: \"ICICIBANK.NS\", n: \"ICICI Bank\" }, { t: \"INFY.NS\", n: \"Infosys\" }, { t: \"SBIN.NS\", n: \"State Bank\" }, { t: \"BHARTIARTL.NS\", n: \"Bharti Airtel\" }, { t: \"ITC.NS\", n: \"ITC Ltd\" }, { t: \"HINDUNILVR.NS\", n: \"HUL\" }, { t: \"L&T.NS\", n: \"Larsen & Toubro\" }, { t: \"BAJFINANCE.NS\", n: \"Bajaj Finance\" }, { t: \"HCLTECH.NS\", n: \"HCL Tech\" } ] },\r\n        { country: \"UK\", flag: \"🇬🇧\", id: \"eq-uk\", companies: [ { t: \"AZN.L\", n: \"AstraZeneca\" }, { t: \"SHEL.L\", n: \"Shell\" }, { t: \"HSBA.L\", n: \"HSBC\" }, { t: \"ULVR.L\", n: \"Unilever\" }, { t: \"BP.L\", n: \"BP\" } ] },\r\n        { country: \"Canada\", flag: \"🇨🇦\", id: \"eq-can\", companies: [ { t: \"RY.TO\", n: \"Royal Bank of Canada\" }, { t: \"TD.TO\", n: \"TD Bank\" }, { t: \"SHOP.TO\", n: \"Shopify\" } ] },\r\n        { country: \"Australia\", flag: \"🇦🇺\", id: \"eq-aus\", companies: [ { t: \"BHP.AX\", n: \"BHP Group\" }, { t: \"CBA.AX\", n: \"Commonwealth Bank\" }, { t: \"CSL.AX\", n: \"CSL Limited\" } ] },\r\n        { country: \"Germany\", flag: \"🇩🇪\", id: \"eq-ger\", companies: [ { t: \"SAP.DE\", n: \"SAP\" }, { t: \"SIE.DE\", n: \"Siemens\" }, { t: \"ALV.DE\", n: \"Allianz\" } ] },\r\n        { country: \"Japan\", flag: \"🇯🇵\", id: \"eq-jpn\", companies: [ { t: \"7203.T\", n: \"Toyota\" }, { t: \"6758.T\", n: \"Sony\" }, { t: \"8306.T\", n: \"MUFG\" } ] },\r\n        { country: \"China\", flag: \"🇨🇳\", id: \"eq-chn\", companies: [ { t: \"0700.HK\", n: \"Tencent\" }, { t: \"9988.HK\", n: \"Alibaba\" }, { t: \"3690.HK\", n: \"Meituan\" } ] }\r\n    ];\r\n\r\n    const globalCrypto = [\r\n        { t: \"BTC-USD\", n: \"Bitcoin (BTC)\" }, { t: \"ETH-USD\", n: \"Ethereum (ETH)\" }, { t: \"USDT-USD\", n: \"Tether (USDT)\" }, \r\n        { t: \"BNB-USD\", n: \"BNB (BNB)\" }, { t: \"SOL-USD\", n: \"Solana (SOL)\" }, { t: \"XRP-USD\", n: \"XRP (XRP)\" }, \r\n        { t: \"USDC-USD\", n: \"USDC (USDC)\" }, { t: \"ADA-USD\", n: \"Cardano (ADA)\" }, { t: \"AVAX-USD\", n: \"Avalanche (AVAX)\" }, \r\n        { t: \"DOGE-USD\", n: \"Dogecoin (DOGE)\" }, { t: \"TRX-USD\", n: \"TRON (TRX)\" }, { t: \"DOT-USD\", n: \"Polkadot (DOT)\" }, \r\n        { t: \"LINK-USD\", n: \"Chainlink (LINK)\" }, { t: \"MATIC-USD\", n: \"Polygon (MATIC)\" }\r\n    ];\r\n\r\n    const globalForex = [\r\n        { category: \"Major Pairs\", id: \"fx-majors\", pairs: [ { t: \"EURUSD=X\", n: \"EUR / USD\" }, { t: \"GBPUSD=X\", n: \"GBP / USD\" }, { t: \"USDJPY=X\", n: \"USD / JPY\" }, { t: \"USDCHF=X\", n: \"USD / CHF\" }, { t: \"AUDUSD=X\", n: \"AUD / USD\" }, { t: \"USDCAD=X\", n: \"USD / CAD\" } ] },\r\n        { category: \"Minor Crosses\", id: \"fx-minors\", pairs: [ { t: \"EURGBP=X\", n: \"EUR / GBP\" }, { t: \"EURJPY=X\", n: \"EUR / JPY\" }, { t: \"GBPJPY=X\", n: \"GBP / JPY\" }, { t: \"EURCHF=X\", n: \"EUR / CHF\" }, { t: \"EURAUD=X\", n: \"EUR / AUD\" } ] },\r\n        { category: \"Exotic Pairs\", id: \"fx-exotics\", pairs: [ { t: \"INR=X\", n: \"USD / INR\" }, { t: \"USDCNY=X\", n: \"USD / CNY\" }, { t: \"USDMXN=X\", n: \"USD / MXN\" }, { t: \"USDZAR=X\", n: \"USD / ZAR\" }, { t: \"USDSGD=X\", n: \"USD / SGD\" } ] }\r\n    ];\r\n\r\n    const globalCommodities = [\r\n        { category: \"Metals\", id: \"com-metals\", assets: [ { t: \"GC=F\", n: \"Gold\" }, { t: \"SI=F\", n: \"Silver\" }, { t: \"HG=F\", n: \"Copper\" }, { t: \"PL=F\", n: \"Platinum\" } ] },\r\n        { category: \"Energy\", id: \"com-energy\", assets: [ { t: \"CL=F\", n: \"Crude Oil (WTI)\" }, { t: \"BZ=F\", n: \"Brent Crude\" }, { t: \"NG=F\", n: \"Natural Gas\" } ] },\r\n        { category: \"Agriculture\", id: \"com-agri\", assets: [ { t: \"ZC=F\", n: \"Corn\" }, { t: \"ZW=F\", n: \"Wheat\" }, { t: \"ZS=F\", n: \"Soybeans\" }, { t: \"KC=F\", n: \"Coffee\" } ] }\r\n    ];\r\n\r\n    const globalIndices = [\r\n        { category: \"Americas\", id: \"idx-am\", assets: [ { t: \"^GSPC\", n: \"S&P 500\" }, { t: \"^DJI\", n: \"Dow Jones\" }, { t: \"^IXIC\", n: \"Nasdaq\" }, { t: \"^VIX\", n: \"Volatility Index\" } ] },\r\n        { category: \"Asia-Pacific\", id: \"idx-ap\", assets: [ { t: \"^NSEI\", n: \"Nifty 50\" }, { t: \"^BSESN\", n: \"Sensex\" }, { t: \"^N225\", n: \"Nikkei 225\" }, { t: \"000001.SS\", n: \"Shanghai Comp\" } ] },\r\n        { category: \"Europe\", id: \"idx-eu\", assets: [ { t: \"^FTSE\", n: \"FTSE 100\" }, { t: \"^GDAXI\", n: \"DAX\" }, { t: \"^FCHI\", n: \"CAC 40\" } ] }\r\n    ];\r\n\r\n    const globalETFs = [\r\n        { category: \"Broad Market\", id: \"etf-broad\", assets: [ { t: \"SPY\", n: \"S&P 500 ETF\" }, { t: \"QQQ\", n: \"Invesco QQQ\" }, { t: \"DIA\", n: \"Dow Jones ETF\" } ] },\r\n        { category: \"Sectors\", id: \"etf-sector\", assets: [ { t: \"XLK\", n: \"Tech Sector\" }, { t: \"XLF\", n: \"Financial Sector\" }, { t: \"XLV\", n: \"Healthcare\" } ] }\r\n    ];\r\n\r\n    const globalBonds = [\r\n        { category: \"US Treasuries\", id: \"bnd-us\", assets: [ { t: \"^TNX\", n: \"US 10-Year Yield\" }, { t: \"^TYX\", n: \"US 30-Year Yield\" }, { t: \"^FVX\", n: \"US 5-Year Yield\" } ] },\r\n        { category: \"Global Yields\", id: \"bnd-global\", assets: [ { t: \"IN10YT=RR\", n: \"India 10-Year\" }, { t: \"GB10YT=RR\", n: \"UK 10-Year\" }, { t: \"DE10YT=RR\", n: \"Germany 10-Year\" } ] }\r\n    ];\r\n\r\n    // 3. INJECTION LOGIC\r\n    function renderSidebarData() {\r\n        const eqContainer = document.getElementById('equities');\r\n        if(eqContainer) {\r\n            eqContainer.innerHTML = globalEquities.map(region => `\r\n                <div class=\"nested-acc-item\">\r\n                    <button class=\"nested-acc-btn\" onclick=\"toggleNestedAcc('${region.id}', event)\">${region.flag} ${region.country} <span class=\"arrow\">▾</span></button>\r\n                    <div id=\"${region.id}\" class=\"nested-acc-content\">${region.companies.map(c => `<a href=\"/predict?ticker=${c.t}\">${c.n}</a>`).join('')}</div>\r\n                </div>\r\n            `).join('');\r\n        }\r\n\r\n        const cryptoContainer = document.getElementById('crypto');\r\n        if(cryptoContainer) { cryptoContainer.innerHTML = globalCrypto.map(c => `<a href=\"/predict?ticker=${c.t}\">${c.n}</a>`).join(''); }\r\n\r\n        const forexContainer = document.getElementById('forex');\r\n        if(forexContainer) {\r\n            forexContainer.innerHTML = globalForex.map(group => `\r\n                <div class=\"nested-acc-item\">\r\n                    <button class=\"nested-acc-btn\" onclick=\"toggleNestedAcc('${group.id}', event)\">${group.category} <span class=\"arrow\">▾</span></button>\r\n                    <div id=\"${group.id}\" class=\"nested-acc-content\">${group.pairs.map(p => `<a href=\"/predict?ticker=${p.t}\">${p.n}</a>`).join('')}</div>\r\n                </div>\r\n            `).join('');\r\n        }\r\n\r\n        const commoditiesContainer = document.getElementById('commodities');\r\n        if(commoditiesContainer) {\r\n            commoditiesContainer.innerHTML = globalCommodities.map(group => `\r\n                <div class=\"nested-acc-item\">\r\n                    <button class=\"nested-acc-btn\" onclick=\"toggleNestedAcc('${group.id}', event)\">${group.category} <span class=\"arrow\">▾</span></button>\r\n                    <div id=\"${group.id}\" class=\"nested-acc-content\">${group.assets.map(a => `<a href=\"/predict?ticker=${a.t}\">${a.n}</a>`).join('')}</div>\r\n                </div>\r\n            `).join('');\r\n        }\r\n\r\n        const indicesContainer = document.getElementById('indices');\r\n        if(indicesContainer) {\r\n            indicesContainer.innerHTML = globalIndices.map(group => `\r\n                <div class=\"nested-acc-item\">\r\n                    <button class=\"nested-acc-btn\" onclick=\"toggleNestedAcc('${group.id}', event)\">${group.category} <span class=\"arrow\">▾</span></button>\r\n                    <div id=\"${group.id}\" class=\"nested-acc-content\">${group.assets.map(a => `<a href=\"/predict?ticker=${a.t}\">${a.n}</a>`).join('')}</div>\r\n                </div>\r\n            `).join('');\r\n        }\r\n\r\n        const etfsContainer = document.getElementById('etfs');\r\n        if(etfsContainer) {\r\n            etfsContainer.innerHTML = globalETFs.map(group => `\r\n                <div class=\"nested-acc-item\">\r\n                    <button class=\"nested-acc-btn\" onclick=\"toggleNestedAcc('${group.id}', event)\">${group.category} <span class=\"arrow\">▾</span></button>\r\n                    <div id=\"${group.id}\" class=\"nested-acc-content\">${group.assets.map(a => `<a href=\"/predict?ticker=${a.t}\">${a.n}</a>`).join('')}</div>\r\n                </div>\r\n            `).join('');\r\n        }\r\n\r\n        const bondsContainer = document.getElementById('bonds');\r\n        if(bondsContainer) {\r\n            bondsContainer.innerHTML = globalBonds.map(group => `\r\n                <div class=\"nested-acc-item\">\r\n                    <button class=\"nested-acc-btn\" onclick=\"toggleNestedAcc('${group.id}', event)\">${group.category} <span class=\"arrow\">▾</span></button>\r\n                    <div id=\"${group.id}\" class=\"nested-acc-content\">${group.assets.map(a => `<a href=\"/predict?ticker=${a.t}\">${a.n}</a>`).join('')}</div>\r\n                </div>\r\n            `).join('');\r\n        }\r\n    }\r\n\r\n    // FIRE ON LOAD\r\n    document.addEventListener('DOMContentLoaded', renderSidebarData);\r\n</script>\r\n\r\n                <main class=\"content-panel\">\r\n                    <div class=\"strategy-header\">\r\n                        <div>\r\n                            <a href=\"/predict?ticker=RELIANCE.NS\"\r\n                                style=\"color: #8E9BAE; text-decoration: none; font-size: 0.85rem; display: flex; align-items: center; gap: 5px; margin-bottom: 10px;\">\r\n                                ← Back to AI Prediction\r\n                            </a>\r\n                            <h1 style=\"margin: 0; font-size: 2.2rem;\">Pro Chart: <span class=\"accent\">\r\n                                    RELIANCE.NS\r\n                                </span></h1>\r\n                            <p style=\"margin: 5px 0 0 0; color: #8E9BAE; font-size: 0.9rem;\">Timeframe: <strong\r\n                                    id=\"timeframe-label\" style=\"color: #fff;\">\r\n                                    1wk\r\n                                </strong></p>\r\n                        </div>\r\n                        <div class=\"tf-btn-group\">\r\n                            <button class=\"tf-btn \" onclick=\"changeTimeframe('5m', this)\">5 Min</button>\r\n                            <button class=\"tf-btn \" onclick=\"changeTimeframe('1d', this)\">1 Day</button>\r\n                            <button class=\"tf-btn active\" onclick=\"changeTimeframe('1wk', this)\">1 Week</button>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- AI Technical Health Score Panel -->\r\n                    <div class=\"tech-health-panel\" id=\"tech-health-panel\" style=\"display: none;\">\r\n                        <div class=\"tech-health-gauge\">\r\n                            <div class=\"tech-gauge-bg\">\r\n                                <div class=\"tech-gauge-inner\"></div>\r\n                                <div id=\"tech-needle\" class=\"tech-gauge-needle\" style=\"transform: rotate(0deg);\"></div>\r\n                            </div>\r\n                            <div class=\"tech-health-score-value\" id=\"tech-score-text\">0/100</div>\r\n                        </div>\r\n                        <div class=\"tech-health-text\">\r\n                            <div class=\"tech-health-title\">✨ AI Technical Evaluation</div>\r\n                            <div class=\"tech-health-summary\" id=\"tech-summary-text\">\r\n                                Analyzing technical indicators...\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"chart-card\" style=\"padding-bottom: 25px;\">\r\n                        <button class=\"close-fullscreen-btn\" onclick=\"exitFullScreen(this)\"\r\n                            title=\"Close Full Screen\">×</button>\r\n                        <button class=\"menu-toggle-btn\" onclick=\"toggleSidebarMenu(this)\"\r\n                            title=\"Toggle Drawing Tools\">☰</button>\r\n                        <div\r\n                            style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;\">\r\n                            <h3 style=\"margin: 0; color: #e2e8f0;\">Advanced Technical Canvas <span\r\n                                    style=\"font-size: 0.75rem; color: #64748b; font-weight: normal; margin-left: 10px;\">(Hold\r\n                                    Ctrl to Zoom)</span></h3>\r\n\r\n                            <div class=\"toolbar\">\r\n                                <button class=\"tool-btn\" id=\"btn-fullscreen-main\"\r\n                                    style=\"color: #fff; background: rgba(255,255,255,0.1);\">⛶ Full View</button>\r\n                                <button class=\"tool-btn active\" id=\"tool-pan\">✋ Pan</button>\r\n                                <button class=\"tool-btn\" id=\"tool-hz\">➖ S/R Line</button>\r\n                                <button class=\"tool-btn\" id=\"tool-trend\">📈 Trendline</button>\r\n                                <button class=\"tool-btn\" id=\"tool-fib\">📐 Fibonacci</button>\r\n                                <button class=\"tool-btn\" id=\"tool-clear\" style=\"color: #ef5350;\">🗑️ Clear</button>\r\n\r\n                                <div style=\"width: 1px; height: 20px; background: #30363d; margin: 0 5px;\"></div>\r\n\r\n                                <label class=\"tool-checkbox\" style=\"color: #38bdf8;\"><input type=\"checkbox\"\r\n                                        id=\"toggle-sma20\"> SMA 20</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #f59e0b;\"><input type=\"checkbox\"\r\n                                        id=\"toggle-sma50\"> SMA 50</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #22d3ee; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-ema9\"> EMA 9</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #818cf8; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-ema21\"> EMA 21</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #fbbf24; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-vwap\"> VWAP</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #a78bfa; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-ichimoku\"> Ichimoku</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #4ade80; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-supertrend\"> SuperTrend</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #f43f5e; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-fvg\"> FVG</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #00E5FF; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-bb\"> Bollinger Bands</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #f472b6; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-psar\"> Trend Dots</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #cbd5e1; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-vpvr\"> Vol Profile</label>\r\n                                <label class=\"tool-checkbox\" style=\"color: #4ade80; margin-left: 5px;\"><input\r\n                                        type=\"checkbox\" id=\"toggle-candlesignals\"> Signals</label>\r\n\r\n                                <div style=\"width: 1px; height: 20px; background: #30363d; margin: 0 5px;\"></div>\r\n\r\n                                <span\r\n                                    style=\"color: #8E9BAE; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;\">Oscillator:</span>\r\n                                <button class=\"tool-btn active\" id=\"tab-rsi\"\r\n                                    style=\"color: #a855f7; border-color: rgba(168, 85, 247, 0.4); background: rgba(168, 85, 247, 0.1);\">RSI</button>\r\n                                <button class=\"tool-btn\" id=\"tab-macd\" style=\"color: #4ade80;\">MACD</button>\r\n                                <button class=\"tool-btn\" id=\"tab-stoch\" style=\"color: #fbbf24;\">Stoch</button>\r\n                                <button class=\"tool-btn\" id=\"tab-atr\" style=\"color: #38bdf8;\">ATR</button>\r\n                                <button class=\"tool-btn\" id=\"tab-ao\" style=\"color: #f472b6;\">AO</button>\r\n                                <button class=\"tool-btn\" id=\"tab-none\" style=\"color: #ef5350;\">Off</button>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <!-- AI Trend Suggestion Alert Box -->\r\n                        <div id=\"ai-trend-suggestion\" style=\"margin-bottom: 15px; padding: 12px 20px; border-radius: 8px; background: rgba(15, 23, 42, 0.6); border: 1px solid #1e293b; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; display: none;\">\r\n                            <div style=\"display: flex; align-items: center; gap: 10px;\">\r\n                                <span style=\"font-size: 0.75rem; font-weight: 800; padding: 4px 8px; border-radius: 4px; background: rgba(38, 166, 154, 0.1); color: #26a69a; border: 1px solid rgba(38, 166, 154, 0.2); letter-spacing: 0.5px;\">AI FORECAST GAUGE</span>\r\n                                <span id=\"trend-summary-text\" style=\"font-size: 0.95rem; font-weight: bold; color: #fff;\">Analyzing trend projections...</span>\r\n                            </div>\r\n                            <div style=\"display: flex; gap: 15px; flex-wrap: wrap;\">\r\n                                <span id=\"ema9-projection\" style=\"font-family: monospace; font-size: 0.82rem; font-weight: bold; color: #22d3ee; margin-right: 5px;\">EMA 9: --</span>\r\n                                <span id=\"ema21-projection\" style=\"font-family: monospace; font-size: 0.82rem; font-weight: bold; color: #818cf8; margin-right: 5px;\">EMA 21: --</span>\r\n                                <span id=\"sma20-projection\" style=\"font-family: monospace; font-size: 0.82rem; font-weight: bold; color: #38bdf8; margin-right: 5px;\">SMA 20: --</span>\r\n                                <span id=\"sma50-projection\" style=\"font-family: monospace; font-size: 0.82rem; font-weight: bold; color: #f59e0b;\">SMA 50: --</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div id=\"svg-container\">\r\n                            <div id=\"tech-chart-loading\" class=\"chart-loading-overlay\">\r\n                                <div class=\"loading-pulse\">Calculating Technical Indicators...</div>\r\n                            </div>\r\n                            <svg id=\"main-svg\" style=\"width: 100%; height: 100%; display: block;\">\r\n                                <g id=\"grid-layer\"></g>\r\n                                <g id=\"volume-layer\" opacity=\"0.15\"></g>\r\n                                <g id=\"overlay-layer\"></g>\r\n                                <g id=\"candle-layer\" style=\"shape-rendering: crispEdges;\"></g>\r\n                                <g id=\"signal-layer\"></g>\r\n                                <g id=\"drawing-layer\"></g>\r\n                                <g id=\"time-layer\"></g>\r\n                                <line id=\"cross-h\" class=\"crosshair\" x1=\"0\" y1=\"0\" x2=\"100%\" y2=\"0\" />\r\n                                <line id=\"cross-v\" class=\"crosshair\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"100%\" />\r\n                            </svg>\r\n                        </div>\r\n\r\n                        <div id=\"rsi-container\" class=\"sub-chart\" style=\"display: block;\">\r\n                            <svg id=\"rsi-svg\" style=\"width: 100%; height: 100%; display: block;\">\r\n                                <g id=\"rsi-grid-layer\"></g>\r\n                                <g id=\"rsi-line-layer\"></g>\r\n                            </svg>\r\n                        </div>\r\n\r\n                        <div id=\"macd-container\" class=\"sub-chart\" style=\"display: none;\">\r\n                            <svg id=\"macd-svg\" style=\"width: 100%; height: 100%; display: block;\">\r\n                                <g id=\"macd-grid-layer\"></g>\r\n                                <g id=\"macd-hist-layer\" style=\"shape-rendering: crispEdges;\"></g>\r\n                                <g id=\"macd-line-layer\"></g>\r\n                            </svg>\r\n                        </div>\r\n\r\n                        <div id=