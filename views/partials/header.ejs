            <a href="/predict?ticker=RELIANCE.NS" style="color:var(--text-muted, #8E9BAE);">Predict Price</a>
            <a href="/macro" style="color:var(--text-muted, #8E9BAE);">Macro Explorer</a>
            <a href="/heatmap" style="color:var(--text-muted, #8E9BAE);">Heatmap Explorer</a>
            <a href="/calculator" style="color:var(--text-muted, #8E9BAE);">Pro Calculators</a>
            <a href="/trade-history" style="color:var(--text-muted, #8E9BAE);">Practice Portfolio</a>
            <a href="#" id="openSuggestionBtn" style="color:var(--text-muted, #8E9BAE);">💡 Suggestion</a>
        </div>

        <form action="/predict" method="GET" class="nav-search">
            <div>
                <input type="text" name="ticker" id="stockSearch" placeholder="Search Asset (e.g. AAPL, BTC-USD)..."
