    <span class="chat-icon">🤖</span>
    <span class="pulse-ring"></span>
</button>

<!-- Sleek Glassmorphic Chat Window -->
<div id="chat-window" class="chat-window" style="display: none;">
    <div class="chat-header">
        <div class="chat-header-title">
            <span class="chat-bot-avatar">🤖</span>
            <div>
                <strong style="color: #fff; font-size: 0.95rem;">Finora AI Analyst</strong>
                <div class="chat-status"><span class="status-dot"></span> Online</div>
            </div>
        </div>
        <button id="chat-close-btn" class="chat-close-btn">&times;</button>
    </div>

    <div class="chat-messages" id="chat-messages-container">
        <div class="chat-bubble bot-message">
            Hi! I am **Finora AI**, your virtual quant terminal assistant.
            I can run real-time technical analysis or pull macro economic summaries.

            How can I help you today?
        </div>
    </div>

    <!-- Quick Action Prompts -->
    <div class="chat-suggestions">
        <button onclick="sendQuickPrompt('Analyze current asset')">📈 Analyze Current Asset</button>
        <button onclick="sendQuickPrompt('GDP of India')">🇮🇳 Macro India</button>
        <button onclick="sendQuickPrompt('Macro indicators for USA')">🇺🇸 Macro USA</button>
    </div>

    <div class="chat-input-area">
        <input type="text" id="chat-user-input" placeholder="Ask about stocks, crypto, or macro metrics..."
            autocomplete="off">
        <button id="chat-send-btn">Send</button>
    </div>
</div>

<style>
    /* Floating trigger button */
    .chat-trigger-btn {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #00f0ff, #a855f7);
        border: none;
        box-shadow: 0 4px 20px rgba(0, 240, 255, 0.4);
        cursor: pointer;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .chat-trigger-btn:hover {
        transform: scale(1.1);
    }

    .chat-icon {
        font-size: 1.8rem;
    }

    .pulse-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px solid #00f0ff;
        animation: chat-pulse 2s infinite;
        opacity: 0;
        top: 0;
        left: 0;
        box-sizing: border-box;
    }

    @keyframes chat-pulse {
        0% {
            transform: scale(1);
            opacity: 0.6;
        }

        100% {
            transform: scale(1.4);
            opacity: 0;
        }
    }

    /* Chat window container */
    .chat-window {
        position: fixed;
        bottom: 100px;
        right: 25px;
        width: 380px;
        height: 500px;
        background: rgba(13, 17, 23, 0.96);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(0, 240, 255, 0.2);
        border-radius: 16px;
