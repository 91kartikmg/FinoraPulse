    .chat-input-area button:hover {
        opacity: 0.9;
    }

    /* Loading dots */
    .chat-typing-indicator {
        display: flex;
        gap: 4px;
        padding: 5px;
        align-self: flex-start;
    }

    .chat-typing-indicator span {
        width: 8px;
        height: 8px;
        background: #00f0ff;
        border-radius: 50%;
        animation: typing-bounce 1.4s infinite ease-in-out both;
    }

    .chat-typing-indicator span:nth-child(1) {
        animation-delay: -0.32s;
    }

    .chat-typing-indicator span:nth-child(2) {
        animation-delay: -0.16s;
    }

    @keyframes typing-bounce {

        0%,
        80%,
        100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }

    /* Mobile Responsive */
    @media screen and (max-width: 480px) {
        .chat-window {
            bottom: 0;
            right: 0;
            width: 100%;
            height: 100%;
            border-radius: 0;
            border: none;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const triggerBtn = document.getElementById('chat-trigger-btn');
        const chatWindow = document.getElementById('chat-window');
        const closeBtn = document.getElementById('chat-close-btn');
        const sendBtn = document.getElementById('chat-send-btn');
        const inputField = document.getElementById('chat-user-input');
        const messagesContainer = document.getElementById('chat-messages-container');

        if (!triggerBtn || !chatWindow) return;

        // Toggle chat window visibility
        triggerBtn.addEventListener('click', () => {
            if (chatWindow.style.display === 'none') {
                chatWindow.style.display = 'flex';
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
                inputField.focus();
            } else {
                chatWindow.style.display = 'none';
            }
        });

        closeBtn.addEventListener('click', () => {
            chatWindow.style.display = 'none';
        });

        // Send message event handler
        const sendMessage = async () => {
            const text = inputField.value.trim();
            if (!text) return;

            // Render user message bubble
            appendMessage(text, 'user');
            inputField.value = '';

            // Render bot typing indicator
            const typingIndicator = appendTypingIndicator();

            try {
                // Determine ticker context from window URL search parameters or page elements
                const urlParams = new URLSearchParams(window.location.search);
                const ctxTicker = urlParams.get('ticker') || (typeof currentTicker !== 'undefined' ? currentTicker : '');
                const ctxTimeframe = urlParams.get('timeframe') || (typeof currentTimeframe !== 'undefined' ? currentTimeframe : '1d');

                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        message: text,
                        contextTicker: ctxTicker,
                        contextTimeframe: ctxTimeframe
                    })
                });

                const data = await response.json();
                typingIndicator.remove();

                if (data.response) {
                    appendMessage(data.response, 'bot');
                } else {
                    appendMessage('⚠️ Error: Empty response from AI assistant.', 'bot');
                }
            } catch (err) {
                console.error("Chat error:", err);
                typingIndicator.remove();
                appendMessage('❌ Connection error. Please verify the server is running.', 'bot');
            }
        };

        sendBtn.addEventListener('click', sendMessage);
        inputField.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        // Helper: format markdown in message text
        const formatMarkdown = (text) => {
            return text
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/### (.*?)\n/g, '<h3>$1</h3>')
                .replace(/#### (.*?)\n/g, '<h4>$1</h4>')
                .replace(/`([^`]+)`/g, '<code>$1</code>')
                .replace(/^- (.*?)\n/gm, '• $1<br>');
        };

        const appendMessage = (text, sender) => {
            const bubble = document.createElement('div');
            bubble.classList.add('chat-bubble');
            bubble.classList.add(sender === 'user' ? 'user-message' : 'bot-message');

            if (sender === 'bot') {
                bubble.innerHTML = formatMarkdown(text);
            } else {
                bubble.textContent = text;
            }

            messagesContainer.appendChild(bubble);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        };

        const appendTypingIndicator = () => {
            const container = document.createElement('div');
            container.classList.add('chat-bubble', 'bot-message', 'chat-typing-indicator');
            container.innerHTML = '<span></span><span></span><span></span>';
            messagesContainer.appendChild(container);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            return container;
        };

        // Expose function for quick prompts
        window.sendQuickPrompt = (promptText) => {
            if (promptText === 'Analyze current asset') {
                const urlParams = new URLSearchParams(window.location.search);
                const ctxTicker = urlParams.get('ticker') || (typeof currentTicker !== 'undefined' ? currentTicker : 'RELIANCE.NS');
                inputField.value = `Analyze ${ctxTicker}`;
            } else {
                inputField.value = promptText;
            }
            sendMessage();
        };
    });
</script>