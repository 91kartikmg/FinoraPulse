<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Pro Interactive Technical Chart: <%= ticker %> (<%= timeframe %>) | FinoraPulse</title>
    <meta name="title" content="Pro Interactive Technical Chart: <%= ticker %> (<%= timeframe %>) | FinoraPulse">
    <meta name="description"
        content="Perform real-time charting and technical analysis for <%= ticker %> on <%= timeframe %> timeframe. Access SMA, EMA, VWAP, Ichimoku Clouds, Bollinger Bands, and automatic candle signals.">
    <meta name="keywords"
        content="<%= ticker %> technical analysis, <%= ticker %> chart, <%= ticker %> <%= timeframe %>, FinoraPulse charts, stock indicators, Ichimoku, Bollinger Bands, VWAP, algorithmic chart">
    <meta name="author" content="Kartik M G (FinoraPulse.com)">
    <meta name="robots" content="index, follow">
    <meta name="language" content="English">

    <link rel="canonical" href="https://finorapulse.com/technical?ticker=<%= ticker %>&timeframe=<%= timeframe %>">

    <meta property="og:type" content="website">
    <meta property="og:url" content="https://finorapulse.com/technical?ticker=<%= ticker %>&timeframe=<%= timeframe %>">
    <meta property="og:title" content="Pro Interactive Technical Chart: <%= ticker %> (<%= timeframe %>)">
    <meta property="og:description"
        content="Interactive charting terminal for <%= ticker %> on <%= timeframe %> timeframe. Standard & advanced overlays with automatic candlestick pattern detection.">
    <meta property="og:image" content="https://finorapulse.com/images/finorapulse-og-banner.jpg">
    <meta property="og:site_name" content="FinoraPulse">
    <meta property="og:locale" content="en_US">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url"
        content="https://finorapulse.com/technical?ticker=<%= ticker %>&timeframe=<%= timeframe %>">
    <meta property="twitter:title" content="Pro Chart: <%= ticker %> (<%= timeframe %>) | FinoraPulse">
    <meta property="twitter:description"
        content="Interactive charting terminal for <%= ticker %> on <%= timeframe %> timeframe. Standard & advanced overlays with automatic candlestick pattern detection.">
    <meta property="twitter:image" content="https://finorapulse.com/images/finorapulse-og-banner.jpg">

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@500;800&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/header.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/home.css" crossorigin="anonymous">
    <link rel="icon" type="image/x-icon" href="/favicon.png">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "FinoraPulse Advanced Technical Charting Canvas",
      "url": "https://finorapulse.com/technical?ticker=<%= ticker %>&timeframe=<%= timeframe %>",
      "description": "Premium multi-overlay charting interface for <%= ticker %> on <%= timeframe %> timeframe. Features pattern recognition, trendlines, and pivot support/resistance analysis.",
      "applicationCategory": "FinancialApplication",
      "operatingSystem": "Web Browser",
      "author": {
        "@type": "Person",
        "name": "Kartik M G"
      },
      "publisher": {
        "@type": "Organization",
        "name": "FinoraPulse",
        "logo": {
          "@type": "ImageObject",
          "url": "https://finorapulse.com/images/finorapulse-log.png"
        }
      }
    }
    </script>

    <style>
        .strategy-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .chart-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        .crosshair {
            stroke: #475569;
            stroke-dasharray: 4;
            pointer-events: none;
        }

        .price-text {
            fill: #94a3b8;
            font-size: 11px;
            font-family: monospace;
        }

        .time-text {
            fill: #64748b;
            font-size: 10px;
            text-anchor: middle;
        }

        #svg-container {
            position: relative;
            height: 450px;
            width: 100%;
            cursor: crosshair;
            user-select: none;
            overflow: hidden;
        }

        .sub-chart {
            height: 220px;
            width: 100%;
            user-select: none;
            overflow: hidden;
            border-top: 1px dashed #334155;
            margin-top: 15px;
            padding-top: 15px;
            display: none;
        }

        .toolbar {
            display: flex;
            gap: 8px;
            background: #0d1117;
            padding: 6px;
            border-radius: 8px;
            border: 1px solid var(--border);
            align-items: center;
            flex-wrap: wrap;
        }

        .tool-btn {
            background: transparent;
            border: 1px solid transparent;
            color: #8E9BAE;
            padding: 4px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 600;
            transition: all 0.2s;
        }

        .tool-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
        }

        .tool-btn.active {
            background: rgba(56, 189, 248, 0.1);
            border-color: #38bdf8;
            color: #38bdf8;
        }

        .tool-checkbox {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.8rem;
            font-weight: bold;
            cursor: pointer;
        }

        .chart-card:fullscreen,
        .chart-card:-webkit-full-screen {
            padding: 15px !important;
            width: 100vw !important;
            height: 100vh !important;
            margin: 0 !important;
            border-radius: 0 !important;
            border: none !important;
            display: flex !important;
            flex-direction: column !important;
            background: #0d1117 !important;
            overflow: hidden !important;
            z-index: 9999 !important;
        }

        .close-fullscreen-btn {
            display: none;
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(239, 83, 80, 0.2);
            color: #ef5350;
            border: 1px solid rgba(239, 83, 80, 0.4);
            border-radius: 50%;
            width: 36px;
            height: 36px;
            font-size: 22px;
            font-weight: bold;
            cursor: pointer;
            z-index: 100000;
            align-items: center;
            justify-content: center;
            line-height: 1;
            padding-bottom: 4px;
        }

        .close-fullscreen-btn:hover {
            background: rgba(239, 83, 80, 0.4);
            color: #fff;
        }

        /* 3-Bar / Hamburger Menu Toggle Button */
        .menu-toggle-btn {
            display: none;
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(56, 189, 248, 0.2);
            color: #38bdf8;
            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 8px;
            width: 36px;
            height: 36px;
            font-size: 20px;
            font-weight: bold;
            cursor: pointer;
            z-index: 100000;
            align-items: center;
            justify-content: center;
            line-height: 1;
            transition: all 0.2s ease;
        }

        .menu-toggle-btn:hover {
            background: rgba(56, 189, 248, 0.4);
            color: #fff;
        }

        .chart-card:fullscreen .close-fullscreen-btn,
        .chart-card:-webkit-full-screen .close-fullscreen-btn,
        .rotate-mobile .close-fullscreen-btn {
            display: flex !important;
        }

        .chart-card:fullscreen .menu-toggle-btn,
        .chart-card:-webkit-full-screen .menu-toggle-btn,
        .rotate-mobile .menu-toggle-btn {
            display: flex !important;
        }

        .chart-card:fullscreen #svg-container,
        .chart-card:-webkit-full-screen #svg-container,
        .chart-card:fullscreen #pattern-container,
        .chart-card:-webkit-full-screen #pattern-container,
        .fake-fullscreen #svg-container,
        .fake-fullscreen #pattern-container {
            flex: 1 1 0 !important;
            height: auto !important;
        }

        @media screen and (max-width: 768px) {

            .chart-card:fullscreen .sub-chart,
            .chart-card:-webkit-full-screen .sub-chart,
            .fake-fullscreen .sub-chart {
                height: 120px !important;
            }
        }

        .rotate-mobile {
            position: fixed !important;
            top: 50% !important;
            left: 50% !important;
            width: 100vh !important;
            height: 100vw !important;
            width: 100dvh !important;
            height: 100dvw !important;
            transform: translate(-50%, -50%) rotate(90deg) !important;
            z-index: 99999 !important;
            padding: 12px !important;
            margin: 0 !important;
            border-radius: 0 !important;
            border: none !important;
            display: flex !important;
            flex-direction: column !important;
            background: #0d1117 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            box-sizing: border-box !important;
        }

        /* Shift button positions in mobile rotated orientation to clear status bars, safe areas, notches, and browser URL bar overlaps */
        .rotate-mobile .menu-toggle-btn {
            top: 26px !important;
            left: 26px !important;
        }

        .rotate-mobile .close-fullscreen-btn {
            top: 26px !important;
            right: 26px !important;
            left: auto !important;
            bottom: auto !important;
            z-index: 100000 !important;
        }

        .rotate-mobile h3,
        .chart-card:fullscreen h3,
        .chart-card:-webkit-full-screen h3 {
            display: block !important;
            margin: 0 !important;
            padding-left: 70px !important;
            /* Make room for menu button */
            font-size: 1.1rem !important;
            white-space: nowrap !important;
            line-height: 36px !important;
        }

        .rotate-mobile h3 span,
        .chart-card:fullscreen h3 span,
        .chart-card:-webkit-full-screen h3 span {
            display: none !important;
        }

        /* Sidebar styling for fullscreen: Grid Layout (Desktop) */
        .chart-card:fullscreen .toolbar,
        .chart-card:-webkit-full-screen .toolbar {
            position: absolute !important;
            top: 70px !important;
            left: 15px !important;
            width: 320px !important;
            max-height: calc(100vh - 90px) !important;
            background: rgba(13, 17, 23, 0.95) !important;
            backdrop-filter: blur(10px) !important;
            border: 1px solid var(--border) !important;
            border-radius: 12px !important;
            padding: 12px !important;
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            align-items: center !important;
            gap: 8px !important;
            z-index: 99999 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            transform: translateX(-350px) !important; /* Collapsed by default */
            transition: transform 0.3s ease !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;
        }

        /* Slide in sidebar when expanded on desktop fullscreen */
        .chart-card:fullscreen .toolbar.open,
        .chart-card:-webkit-full-screen .toolbar.open {
            transform: translateX(0) !important;
        }

        /* Desktop specific sidebar element controls */
        .chart-card:fullscreen .toolbar .tool-btn,
        .chart-card:-webkit-full-screen .toolbar .tool-btn {
            width: 100% !important;
            text-align: left !important;
            padding: 8px 12px !important;
            border-radius: 6px !important;
            flex-shrink: 0 !important;
        }

        .chart-card:fullscreen .toolbar .tool-checkbox,
        .chart-card:-webkit-full-screen .toolbar .tool-checkbox {
            width: 100% !important;
            box-sizing: border-box !important;
            padding: 6px 8px !important;
            flex-shrink: 0 !important;
            margin-left: 0 !important;
        }

        .chart-card:fullscreen .toolbar #btn-fullscreen-main,
        .chart-card:-webkit-full-screen .toolbar #btn-fullscreen-main {
            grid-column: span 2 !important;
        }

        .chart-card:fullscreen .toolbar span,
        .chart-card:-webkit-full-screen .toolbar span {
            grid-column: span 2 !important;
            margin-top: 4px !important;
            margin-bottom: 2px !important;
        }

        .chart-card:fullscreen .toolbar div[style*="width: 1px"],
        .chart-card:-webkit-full-screen .toolbar div[style*="width: 1px"],
        .chart-card:fullscreen .toolbar div[style*="width:1px"],
        .chart-card:-webkit-full-screen .toolbar div[style*="width:1px"] {
            grid-column: span 2 !important;
            width: 100% !important;
            height: 1px !important;
            margin: 6px 0 !important;
            background: #30363d !important;
            flex-shrink: 0 !important;
        }

        /* ========================================================================= */
        /* ROTATED MOBILE SIDEBAR TOOLBAR: Fixed columns fitting screen height/width */
        /* ========================================================================= */
        .rotate-mobile .toolbar {
            position: absolute !important;
            top: 70px !important;
            left: 15px !important;
            width: calc(100dvh - 100px) !important; /* Card's width runs physically vertically */
            height: 290px !important; /* Card's height runs physically horizontally (fits within physical width) */
            max-height: none !important;
            background: rgba(13, 17, 23, 0.96) !important;
            backdrop-filter: blur(15px) !important;
            border: 1px solid var(--border) !important;
            border-radius: 12px !important;
            padding: 10px !important;
            display: flex !important;
            flex-direction: row !important; /* Stack along card's X-axis -> physical vertical columns */
            flex-wrap: wrap !important; /* Wrap along card's Y-axis -> physical horizontal rows */
            align-content: flex-start !important;
            justify-content: flex-start !important;
            align-items: center !important;
            gap: 6px 8px !important;
            z-index: 99999 !important;
            overflow-x: hidden !important;
            overflow-y: hidden !important; /* Entirely fits on screen, no scrolling needed! */
            transform: translateY(-400px) !important; /* Slides completely off-screen along card's Y-axis (physically to the right) */
            transition: transform 0.3s ease !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;
        }

        /* Slide in sidebar when expanded in rotated mobile view */
        .rotate-mobile .toolbar.open {
            transform: translateY(0) !important;
        }

        /* Rotate items physically vertically using card coordinate alignment */
        .rotate-mobile .toolbar .tool-btn,
        .rotate-mobile .toolbar .tool-checkbox {
            width: 120px !important; /* Card's X-axis dimension -> physical height of item */
            height: 34px !important; /* Card's Y-axis dimension -> physical width of item */
            text-align: left !important;
            padding: 4px 8px !important;
            border-radius: 6px !important;
            flex-shrink: 0 !important;
            box-sizing: border-box !important;
            margin: 0 !important;
            display: flex !important;
            align-items: center !important;
            font-size: 0.72rem !important;
        }

        .rotate-mobile .toolbar span {
            width: 100% !important; /* Spans full height of column, forcing a column break to start new section */
            margin: 6px 0 !important;
            color: #8E9BAE !important;
            font-size: 0.7rem !important;
            font-weight: bold !important;
            text-transform: uppercase !important;
            display: flex !important;
            align-items: center !important;
        }

        /* Vertical spacer separating columns physically */
        .rotate-mobile .toolbar div[style*="width: 1px"],
        .rotate-mobile .toolbar div[style*="width:1px"] {
            width: 100% !important; /* Spans full height of column, forcing a column break to start new section */
            height: 1px !important;
            margin: 4px 0 !important;
            background: #30363d !important;
            flex-shrink: 0 !important;
        }

        .rotate-mobile #svg-container {
            height: calc(100vw - 24px) !important;
            flex: none !important;
            width: 100% !important;
        }

        .rotate-mobile #pattern-container {
            flex: 1 1 0 !important;
            height: auto !important;
            width: 100% !important;
        }

        .rotate-mobile .sub-chart {
            height: 120px !important;
            flex-shrink: 0 !important;
        }

        /* Hide navbar/header and sidebar when chart is in full screen or mobile rotated view */
        body.fullscreen-active .navbar,
        body.fullscreen-active .price-ticker-wrapper,
        body.fullscreen-active .ticker-sidebar,
        body.fullscreen-active .side-panel,
        body.fullscreen-active .side-panel.right,
        body.fullscreen-active .strategy-header {
            display: none !important;
        }

        body.fullscreen-active .main-wrapper {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            height: 100vh !important;
            width: 100vw !important;
        }

        body.fullscreen-active .content-panel {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            overflow: visible !important;
            backdrop-filter: none !important;
            filter: none !important;
        }

        /* Ensure viewport scrolling is entirely locked when mobile full screen / rotated canvas is open */
        body.fullscreen-active {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            overflow: hidden !important;
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="main-wrapper">
            <%- include('partials/sidebar') %>

                <main class="content-panel">
                    <div class="strategy-header">
                        <div>
                            <a href="/predict?ticker=<%= ticker %>"
                                style="color: #8E9BAE; text-decoration: none; font-size: 0.85rem; display: flex; align-items: center; gap: 5px; margin-bottom: 10px;">
                                ← Back to AI Prediction
                            </a>
                            <h1 style="margin: 0; font-size: 2.2rem;">Pro Chart: <span class="accent">
                                    <%= ticker %>
                                </span></h1>
                            <p style="margin: 5px 0 0 0; color: #8E9BAE; font-size: 0.9rem;">Timeframe: <strong
                                    style="color: #fff;">
                                    <%= timeframe %>
                                </strong></p>
                        </div>
                    </div>

                    <div class="chart-card" style="padding-bottom: 25px;">
                        <button class="close-fullscreen-btn" onclick="exitFullScreen(this)"
                            title="Close Full Screen">×</button>
                        <button class="menu-toggle-btn" onclick="toggleSidebarMenu(this)"
                            title="Toggle Drawing Tools">☰</button>
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                            <h3 style="margin: 0; color: #e2e8f0;">Advanced Technical Canvas <span
                                    style="font-size: 0.75rem; color: #64748b; font-weight: normal; margin-left: 10px;">(Hold
                                    Ctrl to Zoom)</span></h3>

                            <div class="toolbar">
                                <button class="tool-btn" id="btn-fullscreen-main"
                                    style="color: #fff; background: rgba(255,255,255,0.1);">⛶ Full View</button>
                                <button class="tool-btn active" id="tool-pan">✋ Pan</button>
                                <button class="tool-btn" id="tool-hz">➖ S/R Line</button>
                                <button class="tool-btn" id="tool-trend">📈 Trendline</button>
                                <button class="tool-btn" id="tool-fib">📐 Fibonacci</button>
                                <button class="tool-btn" id="tool-clear" style="color: #ef5350;">🗑️ Clear</button>

                                <div style="width: 1px; height: 20px; background: #30363d; margin: 0 5px;"></div>

                                <label class="tool-checkbox" style="color: #38bdf8;"><input type="checkbox"
                                        id="toggle-sma20"> SMA 20</label>
                                <label class="tool-checkbox" style="color: #f59e0b;"><input type="checkbox"
                                        id="toggle-sma50"> SMA 50</label>
                                <label class="tool-checkbox" style="color: #22d3ee; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-ema9"> EMA 9</label>
                                <label class="tool-checkbox" style="color: #818cf8; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-ema21"> EMA 21</label>
                                <label class="tool-checkbox" style="color: #fbbf24; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-vwap"> VWAP</label>
                                <label class="tool-checkbox" style="color: #a78bfa; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-ichimoku"> Ichimoku</label>
                                <label class="tool-checkbox" style="color: #4ade80; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-supertrend"> SuperTrend</label>
                                <label class="tool-checkbox" style="color: #f43f5e; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-fvg"> FVG</label>
                                <label class="tool-checkbox" style="color: #00E5FF; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-bb"> Bollinger Bands</label>
                                <label class="tool-checkbox" style="color: #f472b6; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-psar"> Trend Dots</label>
                                <label class="tool-checkbox" style="color: #cbd5e1; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-vpvr" checked> Vol Profile</label>
                                <label class="tool-checkbox" style="color: #4ade80; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-candlesignals" checked> Signals</label>

                                <div style="width: 1px; height: 20px; background: #30363d; margin: 0 5px;"></div>

                                <span
                                    style="color: #8E9BAE; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">Oscillator:</span>
                                <button class="tool-btn active" id="tab-rsi"
                                    style="color: #a855f7; border-color: rgba(168, 85, 247, 0.4); background: rgba(168, 85, 247, 0.1);">RSI</button>
                                <button class="tool-btn" id="tab-macd" style="color: #4ade80;">MACD</button>
                                <button class="tool-btn" id="tab-stoch" style="color: #fbbf24;">Stoch</button>
                                <button class="tool-btn" id="tab-atr" style="color: #38bdf8;">ATR</button>
                                <button class="tool-btn" id="tab-ao" style="color: #f472b6;">AO</button>
                                <button class="tool-btn" id="tab-none" style="color: #ef5350;">Off</button>
                            </div>
                        </div>

                        <div id="svg-container">
                            <svg id="main-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="grid-layer"></g>
                                <g id="volume-layer" opacity="0.15"></g>
                                <g id="overlay-layer"></g>
                                <g id="candle-layer" style="shape-rendering: crispEdges;"></g>
                                <g id="signal-layer"></g>
                                <g id="drawing-layer"></g>
                                <g id="time-layer"></g>
                                <line id="cross-h" class="crosshair" x1="0" y1="0" x2="100%" y2="0" />
                                <line id="cross-v" class="crosshair" x1="0" y1="0" x2="0" y2="100%" />
                            </svg>
                        </div>

                        <div id="rsi-container" class="sub-chart" style="display: block;">
                            <svg id="rsi-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="rsi-grid-layer"></g>
                                <g id="rsi-line-layer"></g>
                            </svg>
                        </div>

                        <div id="macd-container" class="sub-chart" style="display: none;">
                            <svg id="macd-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="macd-grid-layer"></g>
                                <g id="macd-hist-layer" style="shape-rendering: crispEdges;"></g>
                                <g id="macd-line-layer"></g>
                            </svg>
                        </div>

                        <div id="stoch-container" class="sub-chart" style="display: none;">
                            <svg id="stoch-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="stoch-grid-layer"></g>
                                <g id="stoch-line-layer"></g>
                            </svg>
                        </div>

                        <div id="atr-container" class="sub-chart" style="display: none;">
                            <svg id="atr-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="atr-grid-layer"></g>
                                <g id="atr-line-layer"></g>
                            </svg>
                        </div>

                        <div id="ao-container" class="sub-chart" style="display: none;">
                            <svg id="ao-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="ao-grid-layer"></g>
                                <g id="ao-hist-layer" style="shape-rendering: crispEdges;"></g>
                            </svg>
                        </div>
                    </div>

                    <div class="chart-card">
                        <button class="close-fullscreen-btn" onclick="exitFullScreen(this)"
                            title="Close Full Screen">×</button>
                        <button class="menu-toggle-btn" onclick="toggleSidebarMenu(this)"
                            title="Toggle Drawing Tools">☰</button>
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                            <h3 style="margin: 0; color: #e2e8f0;">Pattern Recognition Canvas <span
                                    style="font-size: 0.75rem; color: #64748b; font-weight: normal; margin-left: 10px;">(Hold
                                    Ctrl to Zoom)</span></h3>
                            <div class="toolbar"
                                style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                <button class="tool-btn" id="btn-fullscreen-pattern"
                                    style="color: #fff; background: rgba(255,255,255,0.1); border: 1px solid transparent; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; font-weight: 600;">⛶
                                    Full View</button>
                                <label class="tool-checkbox"
                                    style="color: #fbbf24; padding: 4px 10px; background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-auto" checked> Auto Patterns
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #26a69a; padding: 4px 10px; background: rgba(38, 166, 154, 0.1); border: 1px solid rgba(38, 166, 154, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-trendline" checked> Auto Trendline
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #a855f7; padding: 4px 10px; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-sr"> Auto S/R
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #f43f5e; padding: 4px 10px; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-fib"> Auto Fib
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #60a5fa; padding: 4px 10px; background: rgba(96, 165, 250, 0.1); border: 1px solid rgba(96, 165, 250, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-pivot"> Pivot Points
                                </label>
                            </div>
                        </div>
                        <div id="pattern-container"
                            style="height: 350px; width: 100%; user-select: none; overflow: hidden; display: block; cursor: crosshair;">
                            <svg id="pattern-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="pattern-grid-layer"></g>
                                <g id="pattern-candle-layer" style="shape-rendering: crispEdges;"></g>
                                <g id="pattern-signal-layer"></g>
                                <g id="pattern-time-layer"></g>
                                <g id="pattern-drawing-layer"></g>
                                <line id="cross-h-pat" class="crosshair" x1="0" y1="0" x2="100%" y2="0" />
                                <line id="cross-v-pat" class="crosshair" x1="0" y1="0" x2="0" y2="100%" />
                            </svg>
                        </div>
                    </div>

                    <div style="height:60px;"></div>
                </main>
                <aside class="side-panel right"></aside>
        </div>

        <script>
            const currentTicker = "<%= ticker %>";
            const currentTimeframe = "<%= timeframe %>";

            let ohlcData = [];

            // State Management
            let visibleCount = 80; let offset = 0; let dragAccumulator = 0;
            let chartState = { minP: 0, maxP: 0, range: 0, candleW: 0, chartH: 0, padT: 20, padB: 40, padR: 55 };

            let patternVisibleCount = 80; let patternOffset = 0; let patternDragAccumulator = 0;
            let patternState = { minP: 0, maxP: 0, range: 0, candleW: 0, chartH: 0, padT: 20, padB: 40, padR: 55 };

            let verticalScrollShift = 0;
            let patternVerticalScrollShift = 0;

            function toggleSidebarMenu(btn) {
                const card = btn.closest('.chart-card');
                const toolbar = card.querySelector('.toolbar');
                toolbar.classList.toggle('open');
            }

            function closeActiveDrawer() {
                document.querySelectorAll('.toolbar').forEach(tb => tb.classList.remove('open'));
            }

            // UI States
            let showSMA20 = false, showSMA50 = false, showEMA9 = false, showEMA21 = false, showVWAP = false;
            let showBB = false, showVPVR = true, showIchimoku = false, showSuperTrend = false, showFVG = false;
            let showPSAR = false, showCandleSignals = true;

            // NEW STATES FOR PATTERN CANVAS
            let showPatternSR = false, showAutoPatterns = true, showAutoTrendline = true, showAutoFib = false, showPivotPoints = false;

            let activeSubChart = 'RSI', activeTool = 'pan';
            let drawnLines = [], tempTrendline = null, tempFib = null;

            const svgContainer = document.getElementById('svg-container');
            const patternContainer = document.getElementById('pattern-container');
            const chartContainers = [svgContainer, patternContainer];

            // Tools
            const tools = { 'tool-pan': 'pan', 'tool-hz': 'hz', 'tool-trend': 'trend', 'tool-fib': 'fib' };
            Object.keys(tools).forEach(id => {
                document.getElementById(id).onclick = (e) => {
                    document.querySelectorAll('#tool-pan, #tool-hz, #tool-trend, #tool-fib').forEach(b => b.classList.remove('active'));
                    e.target.classList.add('active');
                    activeTool = tools[id];
                    const cursorStyle = activeTool === 'pan' ? 'grab' : 'crosshair';
                    svgContainer.style.cursor = cursorStyle; patternContainer.style.cursor = cursorStyle;
                    closeActiveDrawer();
                };
            });

            // Top Chart Listeners
            document.getElementById('tool-clear').onclick = () => { drawnLines = []; renderAll(); closeActiveDrawer(); };
            document.getElementById('toggle-sma20').onchange = (e) => { showSMA20 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-sma50').onchange = (e) => { showSMA50 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-ema9').onchange = (e) => { showEMA9 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-ema21').onchange = (e) => { showEMA21 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-vwap').onchange = (e) => { showVWAP = e.target.checked; renderSVG(); };
            document.getElementById('toggle-ichimoku').onchange = (e) => { showIchimoku = e.target.checked; renderSVG(); };
            document.getElementById('toggle-supertrend').onchange = (e) => { showSuperTrend = e.target.checked; renderSVG(); };
            document.getElementById('toggle-fvg').onchange = (e) => { showFVG = e.target.checked; renderSVG(); };
            document.getElementById('toggle-bb').onchange = (e) => { showBB = e.target.checked; renderSVG(); };
            document.getElementById('toggle-vpvr').onchange = (e) => { showVPVR = e.target.checked; renderSVG(); };
            document.getElementById('toggle-psar').onchange = (e) => { showPSAR = e.target.checked; renderSVG(); };
            document.getElementById('toggle-candlesignals').onchange = (e) => { showCandleSignals = e.target.checked; renderAll(); };

            // Pattern Chart Listeners
            document.getElementById('toggle-pattern-sr').onchange = (e) => { showPatternSR = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-auto').onchange = (e) => { showAutoPatterns = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-trendline').onchange = (e) => { showAutoTrendline = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-fib').onchange = (e) => { showAutoFib = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-pivot').onchange = (e) => { showPivotPoints = e.target.checked; renderPatternChart(); };

            // Checkbox drawer close handler
            document.querySelectorAll('.toolbar input[type="checkbox"]').forEach(cb => {
                cb.addEventListener('change', () => {
                    if (window.innerWidth <= 768) {
                        closeActiveDrawer();
                    }
                });
            });

            document.getElementById('tab-rsi').onclick = () => setSubChart('RSI');
            document.getElementById('tab-macd').onclick = () => setSubChart('MACD');
            document.getElementById('tab-stoch').onclick = () => setSubChart('STOCH');
            document.getElementById('tab-atr').onclick = () => setSubChart('ATR');
            document.getElementById('tab-ao').onclick = () => setSubChart('AO');
            document.getElementById('tab-none').onclick = () => setSubChart('OFF');

            function setSubChart(type) {
                activeSubChart = type;
                const btns = ['tab-rsi', 'tab-macd', 'tab-stoch', 'tab-atr', 'tab-ao', 'tab-none'].map(id => document.getElementById(id));
                const colors = { 'RSI': 'rgba(168, 85, 247,', 'MACD': 'rgba(74, 222, 128,', 'STOCH': 'rgba(251, 191, 36,', 'ATR': 'rgba(56, 189, 248,', 'AO': 'rgba(244, 114, 182,', 'OFF': 'rgba(239, 83, 80,' };

                btns.forEach(btn => { btn.style.borderColor = 'transparent'; btn.style.background = 'transparent'; btn.classList.remove('active'); });
                ['rsi', 'macd', 'stoch', 'atr', 'ao'].forEach(id => document.getElementById(id + '-container').style.display = 'none');

                if (type !== 'OFF') {
                    const activeBtn = document.getElementById('tab-' + type.toLowerCase());
                    const c = colors[type];
                    activeBtn.style.borderColor = c + ' 0.4)'; activeBtn.style.background = c + ' 0.1)'; activeBtn.classList.add('active');
                    document.getElementById(type.toLowerCase() + '-container').style.display = 'block';
                } else {
                    const offBtn = document.getElementById('tab-none');
                    offBtn.style.borderColor = colors['OFF'] + ' 0.4)'; offBtn.style.background = colors['OFF'] + ' 0.1)'; offBtn.classList.add('active');
                }
                closeActiveDrawer();
                renderSVG();
            }

            async function fetchOHLCData() {
                try {
                    const res = await fetch(`/api/chart-svg?ticker=${currentTicker}&timeframe=${currentTimeframe}`);
                    let data = await res.json();

                    if (data.error || !Array.isArray(data)) {
                        document.getElementById('overlay-layer').innerHTML = `<text x="50%" y="50%" fill="#ef5350" font-size="20" font-weight="bold" text-anchor="middle">⚠️ Error: ${data.error || 'Invalid Data'}</text>`;
                        return;
                    }
                    if (data.length > 0 && Array.isArray(data[0])) { data = data.map(d => ({ date: d[0], open: d[1], high: d[2], low: d[3], close: d[4], volume: d[5] })); }

                    ohlcData = data;
                    offset = Math.max(0, ohlcData.length - visibleCount);
                    patternOffset = Math.max(0, ohlcData.length - patternVisibleCount);
                    renderAll();
                } catch (e) {
                    document.getElementById('overlay-layer').innerHTML = `<text x="50%" y="50%" fill="#ef5350" font-size="16" font-weight="bold" text-anchor="middle">Network Error: ${e.message}</text>`;
                }
            }

            function getPriceFromY(y, container) {
                const state = container === svgContainer ? chartState : patternState;
                return state.range === 0 ? 0 : state.minP + state.range * ((container.clientHeight - state.padB - y) / state.chartH);
            }
            function getIndexFromX(x, container) {
                return (container === svgContainer ? offset : patternOffset) + Math.floor(x / (container === svgContainer ? chartState : patternState).candleW);
            }

            // Controls (Mouse & Touch)
            function getLocalCoords(clientX, clientY, container) {
                const isRotated = container.closest('.chart-card').classList.contains('rotate-mobile');
                const rect = container.getBoundingClientRect();
                if (isRotated) {
                    const centerX = rect.left + rect.width / 2;
                    const centerY = rect.top + rect.height / 2;
                    const dx_screen = clientX - centerX;
                    const dy_screen = clientY - centerY;
                    const dx_local = dy_screen;
                    const dy_local = -dx_screen;
                    return { x: container.clientWidth / 2 + dx_local, y: container.clientHeight / 2 + dy_local };
                }
                return { x: clientX - rect.left, y: clientY - rect.top };
            }

            const handleWheel = (e, container) => {
                const isRotated = container.closest('.chart-card').classList.contains('rotate-mobile');
                let deltaX = isRotated ? e.deltaY : e.deltaX;
                let deltaY = isRotated ? -e.deltaX : e.deltaY;

                const isMain = container === svgContainer;
                let currentVis = isMain ? visibleCount : patternVisibleCount;
                let currentOff = isMain ? offset : patternOffset;
                let currentDrag = isMain ? dragAccumulator : patternDragAccumulator;

                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    e.preventDefault(); currentDrag -= deltaX;
                    const candleW = (container.clientWidth - 55) / currentVis;
                    const moves = Math.trunc(currentDrag / candleW);
                    if (moves !== 0) {
                        currentOff = Math.min(Math.max(currentOff - moves, 0), ohlcData.length - currentVis);
                        currentDrag -= (moves * candleW);
                        if (isMain) { offset = currentOff; dragAccumulator = currentDrag; renderSVG(); }
                        else { patternOffset = currentOff; patternDragAccumulator = currentDrag; renderPatternChart(); }
                    }
                    return;
                }

                if (e.ctrlKey || e.metaKey) {
                    e.preventDefault(); const delta = Math.sign(deltaY);
                    const oldVis = currentVis;
                    currentVis = Math.min(Math.max(currentVis + (delta * Math.ceil(currentVis * 0.15)), 10), ohlcData.length);
                    currentOff = Math.min(Math.max(currentOff + Math.floor((oldVis - currentVis) / 2), 0), ohlcData.length - currentVis);
                    if (isMain) { offset = currentOff; visibleCount = currentVis; renderSVG(); }
                    else { patternOffset = currentOff; patternVisibleCount = currentVis; renderPatternChart(); }
                }
            };

            svgContainer.addEventListener('wheel', (e) => handleWheel(e, svgContainer), { passive: false });
            patternContainer.addEventListener('wheel', (e) => handleWheel(e, patternContainer), { passive: false });

            // Double Click to Reset Vertical Shifts
            svgContainer.ondblclick = () => { verticalScrollShift = 0; renderSVG(); };
            patternContainer.ondblclick = () => { patternVerticalScrollShift = 0; renderPatternChart(); };

            // Touch Panning & Pinch-to-Zoom
            chartContainers.forEach(container => {
                let tStartX = 0, tStartY = 0;
                let initialTouchDist = 0;
                let initialVisCount = 0;

                container.addEventListener('touchstart', (e) => {
                    if (e.touches.length === 1) {
                        const coords = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                        tStartX = coords.x;
                        tStartY = coords.y;
                        if (container === svgContainer) dragAccumulator = 0; else patternDragAccumulator = 0;
                    } else if (e.touches.length === 2) {
                        const t1 = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                        const t2 = getLocalCoords(e.touches[1].clientX, e.touches[1].clientY, container);
                        initialTouchDist = Math.hypot(t1.x - t2.x, t1.y - t2.y);
                        initialVisCount = container === svgContainer ? visibleCount : patternVisibleCount;
                    }
                }, { passive: true });

                container.addEventListener('touchmove', (e) => {
                    const isMain = container === svgContainer;

                    if (e.touches.length === 1 && activeTool === 'pan') {
                        const coords = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                        const dx = coords.x - tStartX;
                        const dy = coords.y - tStartY;

                        if (Math.abs(dx) > Math.abs(dy)) {
                            e.preventDefault();
                            tStartX = coords.x;
                            tStartY = coords.y;

                            let cVis = isMain ? visibleCount : patternVisibleCount;
                            let cOff = isMain ? offset : patternOffset;
                            let cDrag = isMain ? dragAccumulator : patternDragAccumulator;

                            cDrag += dx;
                            const cW = (container.clientWidth - 55) / cVis;
                            const moves = Math.trunc(cDrag / cW);
                            if (moves !== 0) {
                                cOff = Math.min(Math.max(cOff - moves, 0), ohlcData.length - cVis);
                                cDrag -= (moves * cW);
                                if (isMain) { offset = cOff; dragAccumulator = cDrag; renderSVG(); }
                                else { patternOffset = cOff; patternDragAccumulator = cDrag; renderPatternChart(); }
                            }
                        }
                    } else if (e.touches.length === 2 && initialTouchDist > 0) {
                        e.preventDefault();
                        const t1 = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                        const t2 = getLocalCoords(e.touches[1].clientX, e.touches[1].clientY, container);
                        const dist = Math.hypot(t1.x - t2.x, t1.y - t2.y);

                        if (dist > 10) {
                            const scale = dist / initialTouchDist;
                            const oldVis = isMain ? visibleCount : patternVisibleCount;
                            let newVis = Math.round(initialVisCount / scale);
                            newVis = Math.min(Math.max(newVis, 10), ohlcData.length);

                            if (newVis !== oldVis) {
                                if (isMain) {
                                    offset = Math.min(Math.max(offset + Math.floor((oldVis - newVis) / 2), 0), ohlcData.length - newVis);
                                    visibleCount = newVis;
                                    renderSVG();
                                } else {
                                    patternOffset = Math.min(Math.max(patternOffset + Math.floor((oldVis - newVis) / 2), 0), ohlcData.length - newVis);
                                    patternVisibleCount = newVis;
                                    renderPatternChart();
                                }
                            }
                        }
                    }
                }, { passive: false });

                container.addEventListener('touchend', (e) => {
                    if (e.touches.length < 2) {
                        initialTouchDist = 0;
                    }
                }, { passive: true });
            });

            // Mouse Panning & Manual Drawing
            let isDragging = false, lastMouseX = 0, lastMouseY = 0, activeDragContainer = null;

            chartContainers.forEach(container => {
                container.onmousedown = (e) => {
                    const coords = getLocalCoords(e.clientX, e.clientY, container);
                    const mx = coords.x, my = coords.y;
                    if (activeTool === 'pan') {
                        isDragging = true;
                        lastMouseX = coords.x;
                        lastMouseY = coords.y;
                        if (container === svgContainer) dragAccumulator = 0; else patternDragAccumulator = 0;
                        container.style.cursor = 'grabbing'; activeDragContainer = container;
                    } else {
                        if (activeTool === 'hz') { drawnLines.push({ type: 'horizontal', price: getPriceFromY(my, container) }); renderAll(); }
                        else if (activeTool === 'trend') { isDragging = true; const sIdx = getIndexFromX(mx, container), sPr = getPriceFromY(my, container); tempTrendline = { type: 'trend', startIdx: sIdx, startPrice: sPr, endIdx: sIdx, endPrice: sPr }; activeDragContainer = container; }
                        else if (activeTool === 'fib') { isDragging = true; const sIdx = getIndexFromX(mx, container), sPr = getPriceFromY(my, container); tempFib = { type: 'fib', startIdx: sIdx, startPrice: sPr, endIdx: sIdx, endPrice: sPr }; activeDragContainer = container; }
                    }
                };

                container.onmousemove = (e) => {
                    const coords = getLocalCoords(e.clientX, e.clientY, container);
                    const mx = coords.x, my = coords.y;
                    if (container === svgContainer) { document.getElementById('cross-h').setAttribute('y1', my); document.getElementById('cross-h').setAttribute('y2', my); document.getElementById('cross-v').setAttribute('x1', mx); document.getElementById('cross-v').setAttribute('x2', mx); }
                    else if (container === patternContainer) { document.getElementById('cross-h-pat').setAttribute('y1', my); document.getElementById('cross-h-pat').setAttribute('y2', my); document.getElementById('cross-v-pat').setAttribute('x1', mx); document.getElementById('cross-v-pat').setAttribute('x2', mx); }

                    if (isDragging && activeDragContainer === container) {
                        const isMain = container === svgContainer;
                        if (activeTool === 'pan') {
                            let cVis = isMain ? visibleCount : patternVisibleCount;
                            let cOff = isMain ? offset : patternOffset;
                            let cDrag = isMain ? dragAccumulator : patternDragAccumulator;

                            const dx = coords.x - lastMouseX;
                            lastMouseX = coords.x;
                            lastMouseY = coords.y;

                            cDrag += dx;
                            const cW = (container.clientWidth - 55) / cVis;
                            const moves = Math.trunc(cDrag / cW);
                            if (moves !== 0) {
                                cOff = Math.min(Math.max(cOff - moves, 0), ohlcData.length - cVis); cDrag -= (moves * cW);
                                if (isMain) { offset = cOff; dragAccumulator = cDrag; renderSVG(); } else { patternOffset = cOff; patternDragAccumulator = cDrag; renderPatternChart(); }
                            }
                        } else {
                            if (activeTool === 'trend' && tempTrendline) { tempTrendline.endIdx = getIndexFromX(mx, container); tempTrendline.endPrice = getPriceFromY(my, container); renderAll(); }
                            else if (activeTool === 'fib' && tempFib) { tempFib.endIdx = getIndexFromX(mx, container); tempFib.endPrice = getPriceFromY(my, container); renderAll(); }
                        }
                    }
                };
            });

            window.addEventListener('mouseup', () => {
                if (isDragging && activeTool === 'trend' && tempTrendline) { drawnLines.push(tempTrendline); tempTrendline = null; renderAll(); }
                if (isDragging && activeTool === 'fib' && tempFib) { drawnLines.push(tempFib); tempFib = null; renderAll(); }
                isDragging = false; activeDragContainer = null;
                const cStyle = activeTool === 'pan' ? 'grab' : 'crosshair';
                svgContainer.style.cursor = cStyle; patternContainer.style.cursor = cStyle;
            });

            function renderAll() { renderSVG(); renderPatternChart(); }

            // Render Logic
            function renderSVG() {
                if (!ohlcData.length) return;
                const w = svgContainer.clientWidth, h = svgContainer.clientHeight;
                chartState.padR = 55; chartState.padB = 40; chartState.padT = 20;
                const chartW = w - chartState.padR; chartState.chartH = h - chartState.padB - chartState.padT;
                const displayData = ohlcData.slice(offset, offset + visibleCount);
                if (displayData.length === 0) return;

                let highs = displayData.map(d => d.high), lows = displayData.map(d => d.low);
                if (showBB) { displayData.forEach(d => { if (d.bbUpper) highs.push(d.bbUpper); if (d.bbLower) lows.push(d.bbLower); }); }

                chartState.maxP = Math.max(...highs) + verticalScrollShift;
                chartState.minP = Math.min(...lows) + verticalScrollShift;
                chartState.range = chartState.maxP - chartState.minP || 1;
                chartState.candleW = chartW / displayData.length;
                const getY = (p) => (h - chartState.padB) - ((p - chartState.minP) / chartState.range) * chartState.chartH;

                let gridHtml = '';
                for (let i = 0; i <= 8; i++) {
                    const p = chartState.minP + (chartState.range * (i / 8));
                    gridHtml += `<line x1="0" y1="${getY(p)}" x2="${chartW}" y2="${getY(p)}" stroke="#1e293b" stroke-width="1"/><text x="${chartW + 8}" y="${getY(p) + 4}" class="price-text">${p.toFixed(2)}</text>`;
                }
                document.getElementById('grid-layer').innerHTML = gridHtml;

                let candleHtml = '', volHtml = '', timeHtml = '', signalHtml = '';
                const maxV = Math.max(...displayData.map(d => d.volume || 0)) || 1;
                const timeStep = Math.ceil(visibleCount / 8);

                displayData.forEach((d, i) => {
                    const x = i * chartState.candleW, midX = x + (chartState.candleW / 2);
                    const color = d.close >= d.open ? "#26a69a" : "#ef5350";
                    const vH = (d.volume / maxV) * 60;
                    volHtml += `<rect x="${x + 2}" y="${h - chartState.padB - vH}" width="${chartState.candleW - 4}" height="${vH}" fill="${color}" />`;

                    const bodyT = getY(Math.max(d.open, d.close)), bodyB = getY(Math.min(d.open, d.close));
                    candleHtml += `<line x1="${midX}" y1="${getY(d.high)}" x2="${midX}" y2="${getY(d.low)}" stroke="${color}" stroke-width="1.5" />`;
                    candleHtml += `<rect x="${x + (chartState.candleW * 0.15)}" y="${bodyT}" width="${chartState.candleW * 0.7}" height="${Math.max(Math.abs(bodyT - bodyB), 1.5)}" fill="${color}" />`;

                    if (i % timeStep === 0) timeHtml += `<text x="${midX}" y="${h - 15}" class="time-text">${d.date}</text>`;

                    if (showCandleSignals && d.candle_signal && d.candle_signal.signal !== 'neutral') {
                        const isBull = d.candle_signal.signal === 'bullish';
                        const sigY = isBull ? getY(d.low) + 15 : getY(d.high) - 5;
                        const sigColor = isBull ? '#4ade80' : '#ef5350';
