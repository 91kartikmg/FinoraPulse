    <script type="application/ld+json"> 
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
        {
            "@type": "Question",
            "name": "What technical overlays are supported on the canvas?",
            "acceptedAnswer": {
            "@type": "Answer",
            "text": "The canvas supports a rich array of technical overlays including SMA 20/50, EMA 9/21, VWAP, Ichimoku Clouds, SuperTrend, Bollinger Bands, and Fair Value Gaps (FVG)."
            }
        },
        {
            "@type": "Question",
            "name": "Can I draw support and resistance lines manually?",
            "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our drawing tools allow you to plot custom horizontal Support/Resistance lines, diagonal Trendlines, and Fibonacci Retracement levels directly onto the SVG coordinate space."
            }
        },
        {
            "@type": "Question",
            "name": "How does automatic candlestick pattern detection work?",
