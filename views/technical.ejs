            // Fullscreen Logic
            function toggleFullScreen(element) {
                const isMobile = window.innerWidth <= 768;

                if (isMobile) {
                    if (element.classList.contains('mobile-fullscreen')) {
                        element.classList.remove('mobile-fullscreen');
                        document.body.style.overflow = '';
                        document.body.classList.remove('fullscreen-active');
                    } else {
                        element.classList.add('mobile-fullscreen');
                        document.body.style.overflow = 'hidden';
                        document.body.classList.add('fullscreen-active');
                    }
                    setTimeout(renderAll, 100);
                    return;
                }

                // Desktop Logic
                const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;
                if (!isFullscreen) {
                    const req = element.requestFullscreen || element.webkitRequestFullscreen || element.mozRequestFullScreen || element.msRequestFullscreen;
                    if (req) { try { req.call(element); } catch (e) { console.log(e); } }
                } else {
                    const ext = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
                    if (ext) { try { ext.call(document); } catch (e) { console.log(e); } }
                }
                setTimeout(renderAll, 100);
            }

            function exitFullScreen(btn) {
                const element = btn.closest('.chart-card');
                const isMobile = window.innerWidth <= 768;

                if (isMobile && element.classList.contains('mobile-fullscreen')) {
                    element.classList.remove('mobile-fullscreen');
                    document.body.style.overflow = '';
                    document.body.classList.remove('fullscreen-active');
                    setTimeout(renderAll, 100);
                    return;
                }

                const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;
                if (isFullscreen) {
                    const ext = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen;
                    if (ext) { try { ext.call(document); } catch (e) { console.log(e); } }
                }
                setTimeout(renderAll, 100);
            }

            // Sync standard browser fullscreen state with body class
            function handleStandardFullscreenChange() {
                const isFullscreen = document.fullscreenElement || document.webkitFullscreenElement;
                if (isFullscreen) {
                    document.body.classList.add('fullscreen-active');
                } else {
                    const hasMobileFullscreen = document.querySelector('.mobile-fullscreen');
                    if (!hasMobileFullscreen) {
                        document.body.classList.remove('fullscreen-active');
                    }
                }
                setTimeout(renderAll, 100);
            }
            document.addEventListener('fullscreenchange', handleStandardFullscreenChange);
            document.addEventListener('webkitfullscreenchange', handleStandardFullscreenChange);

            document.getElementById('btn-fullscreen-main').onclick = () => toggleFullScreen(document.getElementById('main-chart-card'));
            document.getElementById('btn-fullscreen-pattern').onclick = () => toggleFullScreen(document.getElementById('pattern-chart-card'));

            function updateTrendSuggestion() {
                if (!ohlcData || ohlcData.length === 0) return;

                const histData = ohlcData.filter(d => !d.is_future);
                const futData = ohlcData.filter(d => d.is_future);

                if (histData.length === 0 || futData.length === 0) return;

                const lastHist = histData[histData.length - 1];
                const lastFut = futData[futData.length - 1];

                const ema9Hist = lastHist.ema9;
                const ema9Fut = lastFut.ema9;
                const ema21Hist = lastHist.ema21;
                const ema21Fut = lastFut.ema21;
                const sma20Hist = lastHist.sma20;
                const sma20Fut = lastFut.sma20;
                const sma50Hist = lastHist.sma50;
                const sma50Fut = lastFut.sma50;

                const suggestionEl = document.getElementById('ai-trend-suggestion');
                const textEl = document.getElementById('trend-summary-text');
                const ema9El = document.getElementById('ema9-projection');
                const ema21El = document.getElementById('ema21-projection');
                const sma20El = document.getElementById('sma20-projection');
                const sma50El = document.getElementById('sma50-projection');

                if (!suggestionEl) return;

                let ema9Trend = 'flat', ema21Trend = 'flat', sma20Trend = 'flat', sma50Trend = 'flat';
                let ema9Text = 'Consolidating', ema21Text = 'Consolidating', sma20Text = 'Consolidating', sma50Text = 'Consolidating';

                const checkTrend = (histVal, futVal) => {
                    if (histVal && futVal) {
                        const diff = futVal - histVal;
                        const pct = diff / histVal;
                        if (pct > 0.0002) return { trend: 'up', text: '↗ Uptrend' };
                        if (pct < -0.0002) return { trend: 'down', text: '↘ Downtrend' };
                    }
                    return { trend: 'flat', text: 'Consolidating' };
                };

                const resEma9 = checkTrend(ema9Hist, ema9Fut);
                ema9Trend = resEma9.trend; ema9Text = resEma9.text;

                const resEma21 = checkTrend(ema21Hist, ema21Fut);
                ema21Trend = resEma21.trend; ema21Text = resEma21.text;

                const resSma20 = checkTrend(sma20Hist, sma20Fut);
                sma20Trend = resSma20.trend; sma20Text = resSma20.text;

                const resSma50 = checkTrend(sma50Hist, sma50Fut);
                sma50Trend = resSma50.trend; sma50Text = resSma50.text;

                const updateEl = (el, label, text, trend) => {
                    if (el) {
                        el.innerText = `${label}: ${text}`;
                        el.style.color = trend === 'up' ? '#26a69a' : (trend === 'down' ? '#ef5350' : '#8E9BAE');
                    }
                };

                updateEl(ema9El, 'EMA 9', ema9Text, ema9Trend);
                updateEl(ema21El, 'EMA 21', ema21Text, ema21Trend);
                updateEl(sma20El, 'SMA 20', sma20Text, sma20Trend);
                updateEl(sma50El, 'SMA 50', sma50Text, sma50Trend);

                const trends = [ema9Trend, ema21Trend, sma20Trend, sma50Trend];
                const ups = trends.filter(t => t === 'up').length;
                const downs = trends.filter(t => t === 'down').length;

                let overallText = 'Consolidating Range 🔄';
                let badgeColor = 'rgba(234, 179, 8, 0.1)';
                let badgeText = '#eab308';
                let badgeBorder = 'rgba(234, 179, 8, 0.2)';

                if (ups === 4) {
                    overallText = 'Strong Bullish Trend Forecasted 🚀';
                    badgeColor = 'rgba(38, 166, 154, 0.1)';
                    badgeText = '#26a69a';
                    badgeBorder = 'rgba(38, 166, 154, 0.2)';
                } else if (downs === 4) {
                    overallText = 'Strong Bearish Trend Forecasted ⚠️';
                    badgeColor = 'rgba(239, 83, 80, 0.1)';
                    badgeText = '#ef5350';
                    badgeBorder = 'rgba(239, 83, 80, 0.2)';
                } else if (ups >= 2 && ups > downs) {
                    overallText = 'Bullish Trend Bias 📈';
                    badgeColor = 'rgba(34, 197, 94, 0.1)';
                    badgeText = '#22c55e';
                    badgeBorder = 'rgba(34, 197, 94, 0.2)';
                } else if (downs >= 2 && downs > ups) {
                    overallText = 'Bearish Trend Bias 📉';
                    badgeColor = 'rgba(239, 83, 80, 0.1)';
                    badgeText = '#ef5350';
                    badgeBorder = 'rgba(239, 83, 80, 0.2)';
                }

                textEl.innerText = overallText;
                
                const badge = suggestionEl.querySelector('span');
                if (badge) {
                    badge.style.background = badgeColor;
                    badge.style.color = badgeText;
                    badge.style.borderColor = badgeBorder;
                }

                suggestionEl.style.display = 'flex';

                // Calculate dynamic Technical Quant Score (1 to 100)
                let score = 50;

                // 1. Moving average trend slopes (forecasted future vs current)
                if (ema9Trend === 'up') score += 10;
                else if (ema9Trend === 'down') score -= 10;

                if (ema21Trend === 'up') score += 10;
                else if (ema21Trend === 'down') score -= 10;

                if (sma20Trend === 'up') score += 10;
                else if (sma20Trend === 'down') score -= 10;

                if (sma50Trend === 'up') score += 10;
                else if (sma50Trend === 'down') score -= 10;

                // 2. Alignment & crossovers
                if (ema9Hist && ema21Hist) {
                    if (ema9Hist > ema21Hist) score += 5;
                    else score -= 5;
                }
                if (sma20Hist && sma50Hist) {
                    if (sma20Hist > sma50Hist) score += 5;
                    else score -= 5;
                }

                // 3. Price position relative to key moving averages
                const currentPrice = lastHist.close;
                if (currentPrice && sma50Hist) {
                    if (currentPrice > sma50Hist) score += 10;
                    else score -= 10;
                }
                if (currentPrice && sma20Hist) {
                    if (currentPrice > sma20Hist) score += 5;
                    else score -= 5;
                }

                // Clamp score between 1 and 100
                score = Math.max(1, Math.min(100, Math.round(score)));

                // Rotate the needle (from -90deg to +90deg)
                const degrees = ((score / 100) * 180) - 90;
                const needleEl = document.getElementById('tech-needle');
                if (needleEl) needleEl.style.transform = `rotate(${degrees}deg)`;

                // Update score text
                const scoreTextEl = document.getElementById('tech-score-text');
                if (scoreTextEl) scoreTextEl.innerText = `${score}/100`;

                // Determine evaluation state and meaning
                let evaluationState = "";
                let evaluationClass = "";
                let panelBorderColor = "";
                let meaningExplanation = "";

                if (score > 50) {
                    evaluationState = "Bullish";
                    evaluationClass = "highlight-good";
                    panelBorderColor = "#00FF9D";
                    meaningExplanation = `A score of <strong>${score}</strong> indicates a <strong>Bullish</strong> momentum. Immediate upward projections are supported by rising indicators and positive moving average alignment, suggesting a favorable outlook for long positions.`;
                } else if (score < 50) {
                    evaluationState = "Bearish";
                    evaluationClass = "highlight-bad";
                    panelBorderColor = "#ff4d4d";
                    meaningExplanation = `A score of <strong>${score}</strong> indicates a <strong>Bearish</strong> pressure. Downward projections are reinforced by falling moving averages and bearish crossovers, suggesting increased downside risk or short setup opportunities.`;
                } else {
                    evaluationState = "Neutral";
                    evaluationClass = "highlight-neutral";
                    panelBorderColor = "#f59e0b";
                    meaningExplanation = `A score of <strong>50</strong> represents a <strong>Neutral</strong> consolidation phase. Short-term indicators are flat or conflicting, suggesting range-bound volatility with no clear directional bias.`;
                }

                // Update evaluation explanation and description
                const summaryTextEl = document.getElementById('tech-summary-text');
                if (summaryTextEl) {
                    summaryTextEl.innerHTML = `
                        The AI Technical Score of the asset is currently evaluated at <span class="${evaluationClass}">${score}/100</span>, indicating a <strong>${evaluationState}</strong> posture.
                        ${meaningExplanation}
                        <div style="font-size: 0.82rem; color: #8E9BAE; margin-top: 10px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 8px;">
                            <strong>Meter Definition:</strong> This indicator measures technical trend health from 1 to 100. Scores below 50 reflect bearish momentum (sell pressure dominates), scores above 50 signal bullish momentum (buy pressure dominates), and exactly 50 represents consolidation.
                        </div>
                    `;
                }

                // Update panel color and display
                const panelEl = document.getElementById('tech-health-panel');
                if (panelEl) {
                    panelEl.style.borderLeftColor = panelBorderColor;
                    panelEl.style.display = 'flex';
                }
            }

            let typingTimer = null;
            function typeWriterEffect(elementId, text) {
                const element = document.getElementById(elementId);
                if (!element) return;
                
                if (typingTimer) {
                    clearInterval(typingTimer);
                }

                let formattedText = text
                    .replace(/\*\*(.*?)\*\*/g, '<strong style="color: #38bdf8;">$1</strong>')
                    .replace(/\n/g, '<br>');

                element.innerHTML = '';
                
                let index = 0;
                typingTimer = setInterval(() => {
                    if (index >= formattedText.length) {
                        clearInterval(typingTimer);
                        element.innerHTML = formattedText;
                        return;
                    }
                    
                    if (formattedText[index] === '<') {
                        const closeIdx = formattedText.indexOf('>', index);
                        if (closeIdx !== -1) {
                            index = closeIdx + 1;
                        } else {
                            index++;
                        }
                    } else {
                        index += 3;
                    }
                    
                    element.innerHTML = formattedText.substring(0, index) + '<span style="border-right: 2px solid #38bdf8; animation: blink 0.75s step-end infinite;">&nbsp;</span>';
                }, 10);
            }

            function copySummaryText() {
                const element = document.getElementById('ai-summary-text');
                if (!element) return;
                const text = element.innerText;
                
                navigator.clipboard.writeText(text).then(() => {
                    const btn = document.getElementById('copy-summary-btn');
                    const originalHTML = btn.innerHTML;
                    btn.innerHTML = '✅ Copied!';
                    btn.style.color = '#26a69a';
                    btn.style.borderColor = 'rgba(38, 166, 154, 0.4)';
                    setTimeout(() => {
                        btn.innerHTML = originalHTML;
                        btn.style.color = '';
                        btn.style.borderColor = '';
                    }, 2000);
                }).catch(err => {
                    console.error('Failed to copy: ', err);
                });
            }

            function generateAITechnicalScript() {
                if (!ohlcData || ohlcData.length === 0) return;

                const histData = ohlcData.filter(d => !d.is_future);
                const futData = ohlcData.filter(d => d.is_future);

                if (histData.length === 0) return;

                const lastHist = histData[histData.length - 1];
                const lastFut = futData.length > 0 ? futData[futData.length - 1] : lastHist;

                const ticker = currentTicker;
                const timeframe = currentTimeframe;
                const currentPrice = lastHist.close;
                
                const rsi = lastHist.rsi;
                const macd = lastHist.macd;
                const macdSignal = lastHist.signal;
                const macdHist = lastHist.hist;
                
                const sma20Hist = lastHist.sma20;
                const sma50Hist = lastHist.sma50;
                const ema9Hist = lastHist.ema9;
                const ema9Fut = lastFut.ema9;
                const ema21Hist = lastHist.ema21;
                const ema21Fut = lastFut.ema21;
                
                const metaCandle = ohlcData[ohlcData.length - 1];
                const patterns = metaCandle.patterns || [];
                const sr_levels = metaCandle.sr_levels;

                let overview = "";
                if (sma20Hist && sma50Hist) {
                    if (currentPrice > sma20Hist && sma20Hist > sma50Hist) {
                        overview = `**Market Structure Overview:**\n${ticker} is exhibiting a solid bullish market structure on the ${timeframe} timeframe, trading at a price of **${currentPrice.toFixed(2)}**. The asset is holding above both its 20-period SMA (${sma20Hist.toFixed(2)}) and 50-period SMA (${sma50Hist.toFixed(2)}), with the shorter SMA riding above the longer SMA, indicating strong buying momentum.`;
                    } else if (currentPrice < sma20Hist && sma20Hist < sma50Hist) {
                        overview = `**Market Structure Overview:**\n${ticker} is currently in a confirmed bearish phase on the ${timeframe} timeframe, trading at a price of **${currentPrice.toFixed(2)}**. The price remains capped under its 20-period SMA (${sma20Hist.toFixed(2)}) and 50-period SMA (${sma50Hist.toFixed(2)}). With the shorter SMA trending below the longer SMA, sellers remain in clear control of the primary trend.`;
                    } else {
                        overview = `**Market Structure Overview:**\n${ticker} is trading in a consolidation pattern on the ${timeframe} timeframe, with a last close price of **${currentPrice.toFixed(2)}**. The price action is oscillating around its 20-period SMA (${sma20Hist.toFixed(2)}) and 50-period SMA (${sma50Hist.toFixed(2)}), signaling lack of directional dominance.`;
                    }
                } else {
                    overview = `**Market Structure Overview:**\n${ticker} is currently trading at a price of **${currentPrice.toFixed(2)}** on the ${timeframe} timeframe. Indicators are being processed.`;
                }

                let maScript = "";
                if (ema9Fut && ema9Hist && ema21Fut && ema21Hist) {
                    const ema9Diff = ema9Fut - ema9Hist;
                    const ema21Diff = ema21Fut - ema21Hist;
                    if (ema9Diff > 0 && ema21Diff > 0) {
                        maScript = `\n\n**Moving Average Projections:**\nThe short-term EMA 9 and EMA 21 are both projecting positive slopes into the future. EMA 9 is forecasted to rise from ${ema9Hist.toFixed(2)} to ${ema9Fut.toFixed(2)}, indicating that immediate upward momentum is expected to accelerate.`;
                    } else if (ema9Diff < 0 && ema21Diff < 0) {
                        maScript = `\n\n**Moving Average Projections:**\nThe short-term EMA 9 and EMA 21 are projecting negative slopes. EMA 9 is forecasted to drift lower from ${ema9Hist.toFixed(2)} to ${ema9Fut.toFixed(2)}, pointing to sustained near-term downward pressure.`;
                    } else {
                        maScript = `\n\n**Moving Average Projections:**\nThe short-term EMAs (EMA 9 and EMA 21) are flattening out. EMA 9 is projected to move from ${ema9Hist.toFixed(2)} to ${ema9Fut.toFixed(2)}, signaling immediate consolidation.`;
                    }
                }

                let oscScript = "\n\n**Momentum Indicators:**\n";
                if (rsi != null) {
                    if (rsi > 70) {
                        oscScript += `Relative Strength Index (RSI) is currently at **${rsi.toFixed(2)}**, placing the asset in overbought territory. This suggests a potential near-term cooldown or pullback risk. `;
                    } else if (rsi < 30) {
                        oscScript += `Relative Strength Index (RSI) is at **${rsi.toFixed(2)}**, placing the asset in oversold territory, indicating high exhaustion and a potential rebound opportunity. `;
                    } else {
                        oscScript += `RSI is currently neutral at **${rsi.toFixed(2)}**, indicating balanced buying and selling pressure. `;
                    }
                }
                
                if (macd != null && macdSignal != null && macdHist != null) {
                    const isCrossover = macd > macdSignal;
                    if (isCrossover && macdHist > 0) {
                        oscScript += `The MACD indicator shows a bullish momentum bias, with the MACD line hovering above the signal line and the histogram demonstrating expanding green momentum bars (${macdHist.toFixed(2)}).`;
                    } else if (!isCrossover && macdHist < 0) {
                        oscScript += `The MACD indicator reinforces the bearish trend, with the MACD line staying below the signal line and the histogram printing expanding red momentum bars (${macdHist.toFixed(2)}).`;
                    } else {
                        oscScript += `The MACD lines are converging with a narrowing histogram (${macdHist.toFixed(2)}), pointing to a transitional phase in momentum.`;
                    }
                }

                let levelsScript = "";
                if (sr_levels && (sr_levels.support.length > 0 || sr_levels.resistance.length > 0)) {
                    levelsScript = `\n\n**Key Support & Resistance Levels:**\n`;
                    if (sr_levels.resistance.length > 0) {
                        levelsScript += `Immediate resistance ceilings are identified at: **${sr_levels.resistance.map(r => r.toFixed(2)).join(', ')}**. `;
                    }
                    if (sr_levels.support.length > 0) {
                        levelsScript += `On the downside, structural support floors are established at: **${sr_levels.support.map(s => s.toFixed(2)).join(', ')}**. `;
                    }
                }
                
                if (patterns && patterns.length > 0) {
                    const pattern = patterns[0];
                    levelsScript += `Additionally, a **${pattern.name}** chart formation has been detected by the pattern engine, projecting a bias towards ${pattern.name.includes('Bullish') ? 'upward breakout' : (pattern.name.includes('Bearish') ? 'downward breakdown' : 'range-bound consolidation')}.`;
                }

                let outlookScript = "";
                if (futData.length > 0) {
                    const finalFutPrice = lastFut.close;
                    const netChange = finalFutPrice - currentPrice;
                    const pctChange = (netChange / currentPrice) * 100;
                    
                    outlookScript = `\n\n**AI Quantitative Forecast:**\nOver the next 10 predicted candles, the AI forecasting model projects the price of ${ticker} to move from ${currentPrice.toFixed(2)} towards a target of **${finalFutPrice.toFixed(2)}** (${pctChange >= 0 ? '+' : ''}${pctChange.toFixed(2)}%). `;
                    
                    if (pctChange > 0.5) {
                        outlookScript += `The predictive model advises a **BULLISH** stance, indicating potential long setups with entry zones near support floors, keeping target profit levels aligned with the forecasted targets.`;
                    } else if (pctChange < -0.5) {
                        outlookScript += `The model advises a **BEARISH** tactical stance, recommending short setups on rallies towards resistance levels or staying defensive in cash positions.`;
                    } else {
                        outlookScript += `The model projects **CONSOLIDATION** and range-bound trading, recommending range-bound scalp strategies between the support and resistance limits.`;
                    }
                }

                const fullScript = `${overview}${maScript}${oscScript}${levelsScript}${outlookScript}`;

                document.getElementById('ai-summary-section').style.display = 'block';
                typeWriterEffect('ai-summary-text', fullScript);
            }

            // ==========================================
            // VIRTUAL TRADING PORTAL INTEGRATED JS
            // ==========================================
            let chartTradeAction = 'BUY';
            let activeStockPrice = 0;
            const isIndianStock = currentTicker.endsWith('.NS') || currentTicker.endsWith('.BO') || currentTicker === 'INR=X';
            const curSym = isIndianStock ? '₹' : '$';

            // Fetch user balance and holdings details
            async function loadChartTradePortfolio() {
                try {
                    const response = await fetch('/api/trading/portfolio');
                    const data = await response.json();

                    if (response.ok && !data.error) {
                        const cash = data.virtualBalance;
                        document.getElementById('virtual-cash-display').innerText = `₹${cash.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;

                        // Filter holdings for the current stock ticker
                        const holding = data.holdings.find(h => h.ticker === currentTicker);
                        if (holding) {
                            document.getElementById('virtual-holding-display').innerText = `${holding.shares} Shares`;
                            document.getElementById('virtual-avg-price-display').innerText = `${curSym}${holding.averageBuyPrice.toFixed(2)}`;
                        } else {
                            document.getElementById('virtual-holding-display').innerText = `0 Shares`;
                            document.getElementById('virtual-avg-price-display').innerText = `${curSym}0.00`;
                        }
                    }
                } catch (err) {
                    console.error("Failed to load portfolio stats in chart:", err);
                }
            }

            // Set BUY vs SELL
            function setChartTradeAction(action) {
                chartTradeAction = action;
                const buyBtn = document.getElementById('trade-btn-buy');
                const sellBtn = document.getElementById('trade-btn-sell');
                const submitBtn = document.getElementById('chart-trade-submit-btn');

                if (action === 'BUY') {
                    buyBtn.style.background = '#26a69a';
                    buyBtn.style.color = '#000';
                    sellBtn.style.background = 'transparent';
                    sellBtn.style.color = '#8E9BAE';
                    submitBtn.style.background = '#26a69a';
                    submitBtn.style.boxShadow = '0 4px 15px rgba(38,166,154,0.3)';
                } else {
                    buyBtn.style.background = 'transparent';
                    buyBtn.style.color = '#8E9BAE';
                    sellBtn.style.background = '#ff0055';
                    sellBtn.style.color = '#fff';
                    submitBtn.style.background = '#ff0055';
                    submitBtn.style.boxShadow = '0 4px 15px rgba(255,0,85,0.3)';
                }

                submitBtn.innerText = `${action} ${currentTicker}`;
                recalcChartTradeEstimate();
            }

            // Recalculate transaction estimate
            function recalcChartTradeEstimate() {
                if (activeStockPrice <= 0) {
                    // Try to get price from ohlcData in memory if not already set
                    if (ohlcData && ohlcData.length > 0) {
                        const histData = ohlcData.filter(d => !d.is_future);
                        if (histData.length > 0) {
                            activeStockPrice = histData[histData.length - 1].close;
                        }
                    }
                }

                const qtyInput = document.getElementById('trade-qty-input');
                let qty = parseInt(qtyInput.value);
                if (isNaN(qty) || qty <= 0) {
                    qty = 1;
                    qtyInput.value = 1;
                }

                const subtotal = activeStockPrice * qty;
                document.getElementById('chart-trade-currency').innerText = isIndianStock ? 'INR' : 'USD';
                document.getElementById('chart-trade-estimate-price').innerText = `${curSym}${activeStockPrice.toFixed(2)} each`;
                document.getElementById('chart-trade-estimate-total').innerText = `${curSym}${subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            }

            // Submit virtual trade request
            async function executeChartTrade() {
                const qtyInput = document.getElementById('trade-qty-input');
                const qty = parseInt(qtyInput.value);
                if (isNaN(qty) || qty <= 0) {
                    alert("Please select a valid quantity of shares.");
                    return;
                }

                const submitBtn = document.getElementById('chart-trade-submit-btn');
                const originalText = submitBtn.innerText;
                submitBtn.disabled = true;
                submitBtn.innerText = 'EXECUTING...';

                try {
                    const response = await fetch('/api/trading/trade', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            ticker: currentTicker,
                            action: chartTradeAction,
                            shares: qty
                        })
                    });

                    const data = await response.json();
                    if (response.ok && data.success) {
                        alert(data.message);
                        loadChartTradePortfolio();
                    } else {
                        alert(data.error || 'Failed to complete transaction.');
                    }
                } catch (err) {
                    console.error("Trade failed:", err);
                    alert("Connectivity error during transaction.");
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerText = originalText;
                }
            }

            // AI News & Sentiment Terminal Integration
            async function loadSentimentTerminal() {
                const listEl = document.getElementById('sentiment-news-list');
                const labelEl = document.getElementById('sentiment-overall-label');
                const iconEl = document.getElementById('sentiment-overall-icon');
                const indexEl = document.getElementById('sentiment-index-val');
                const needleEl = document.getElementById('sentiment-gauge-needle');
                const driversEl = document.getElementById('sentiment-drivers-container');
                const updatedEl = document.getElementById('sentiment-last-updated');

                if (!listEl) return;

                try {
                    const res = await fetch(`/api/sentiment?ticker=${currentTicker}`);
                    const data = await res.json();

                    if (res.ok && !data.error) {
                        const score = data.sentimentScore;
                        const overall = data.overallSentiment;
                        const drivers = data.keyDrivers || [];
                        const articles = data.articles || [];

                        // 1. Overall sentiment styling
                        labelEl.innerText = overall.toUpperCase();
                        if (overall === 'Bullish') {
                            labelEl.style.color = '#00FF9D';
                            iconEl.style.color = '#00FF9D';
                            iconEl.innerText = '📈';
                        } else if (overall === 'Bearish') {
                            labelEl.style.color = '#ff0055';
                            iconEl.style.color = '#ff0055';
                            iconEl.innerText = '📉';
                        } else {
                            labelEl.style.color = '#8e9bae';
                            iconEl.style.color = '#8e9bae';
                            iconEl.innerText = '📡';
                        }

                        // 2. Score index value
                        const prefix = score > 0 ? '+' : '';
                        indexEl.innerText = `${prefix}${score.toFixed(2)}`;

                        // 3. Gauge rotation: map -1 to +1 into a rotation
                        // 0 is neutral (pointing straight up: 0deg rotation). 
                        // -1 is bearish (pointing left: -90deg rotation).
                        // +1 is bullish (pointing right: 90deg rotation).
                        const deg = score * 90;
                        needleEl.style.transform = `rotate(${deg}deg)`;

                        // 4. Drivers container
                        if (drivers.length > 0) {
                            driversEl.innerHTML = drivers.map(d => `
                                <span style="font-size: 0.75rem; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.3); color: #c084fc; padding: 3px 8px; border-radius: 12px; text-transform: capitalize;">
                                    ${d}
                                </span>
                            `).join('');
                        } else {
                            driversEl.innerHTML = `<span style="font-size: 0.75rem; color: #64748b;">Neutral catalysts</span>`;
                        }

                        // 5. Render articles list
                        if (articles.length > 0) {
                            listEl.innerHTML = articles.map(a => {
                                const isUp = a.sentiment === 'Bullish';
                                const isDown = a.sentiment === 'Bearish';
                                const tagColor = isUp ? 'rgba(0,255,157,0.1)' : (isDown ? 'rgba(255,0,85,0.1)' : 'rgba(255,255,255,0.05)');
                                const tagText = isUp ? '#00ff9d' : (isDown ? '#ff0055' : '#8e9bae');
                                const dateStr = a.publishTime ? new Date(a.publishTime).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Recent';

                                return `
                                    <div style="padding: 12px; border-bottom: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; gap: 8px;">
                                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 15px;">
                                            <a href="${a.link}" target="_blank" style="color: #f8fafc; text-decoration: none; font-weight: 600; font-size: 0.9rem; line-height: 1.4; transition: color 0.2s;" onmouseover="this.style.color='#38bdf8'" onmouseout="this.style.color='#f8fafc'">
                                                ${a.title}
                                            </a>
                                            <span style="font-size: 0.7rem; padding: 2px 6px; border-radius: 4px; font-weight: bold; background: ${tagColor}; color: ${tagText}; text-transform: uppercase; flex-shrink: 0;">
                                                ${a.sentiment}
                                            </span>
                                        </div>
                                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #64748b;">
                                            <span>${a.publisher}</span>
                                            <span>${dateStr}</span>
                                        </div>
                                    </div>
                                `;
                            }).join('');
                        } else {
                            listEl.innerHTML = `<div style="text-align: center; color: #64748b; padding: 20px; font-size: 0.9rem;">No news articles found for ${currentTicker}.</div>`;
                        }

                        // 6. Update last checked time
                        updatedEl.innerText = `UPDATED: ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
                    } else {
                        throw new Error(data.error || 'Invalid sentiment data');
                    }
                } catch (err) {
                    console.error("Sentiment terminal load error:", err);
                    listEl.innerHTML = `
                        <div style="text-align: center; color: #ff0055; padding: 20px; font-size: 0.9rem;">
                            ⚠️ News feed temporarily unavailable.
                        </div>
                    `;
                    labelEl.innerText = "OFFLINE";
                    labelEl.style.color = "#ff4d4d";
                }
            }

            // Hook into the OHLC fetch to get price on load
            const originalFetchOHLCData = fetchOHLCData;
            fetchOHLCData = async function() {
                await originalFetchOHLCData();
                if (ohlcData && ohlcData.length > 0) {
                    const histData = ohlcData.filter(d => !d.is_future);
                    if (histData.length > 0) {
                        activeStockPrice = histData[histData.length - 1].close;
                        recalcChartTradeEstimate();
                    }
                }
                loadChartTradePortfolio();
                loadSentimentTerminal();

                // Update Live HUD price display fields
                const priceVal = activeStockPrice || (ohlcData && ohlcData.length > 0 ? ohlcData[ohlcData.length - 1].close : null);
                if (priceVal) {
                    const formattedPrice = curSym + priceVal.toFixed(2);
                    document.querySelectorAll('.hud-price-value').forEach(el => el.innerText = formattedPrice);
                }
            };

            window.addEventListener('resize', renderAll);
            fetchOHLCData();
        </script>
</body>

</html>