    <style>
        .chart-loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(8, 10, 12, 0.85);
            backdrop-filter: blur(4px);
            z-index: 100;
            color: #00E5FF;
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 8px;
        }

        /* AI Technical Quant Score Styles */
        .tech-health-panel {
            background: #0d1117;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 40px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            border-left: 4px solid #8E9BAE;
            transition: opacity 0.3s;
        }
        
        .tech-health-gauge {
            width: 180px;
            position: relative;
            text-align: center;
            flex-shrink: 0;
        } 
        .tech-gauge-bg {
            width: 100%;
            padding-top: 50%;
            background: conic-gradient(from 270deg at 50% 100%, #ff4d4d 0deg, #f59e0b 90deg, #00FF9D 180deg, transparent 180deg);
            border-radius: 200px 200px 0 0;
            position: relative;
        }
        .tech-gauge-inner {
            position: absolute;
            top: 14px;
            left: 14px;
            right: 14px;
            bottom: 0;
            background: #0d1117;
            border-radius: 200px 200px 0 0;
        }
        .tech-gauge-needle {
            position: absolute;
            bottom: 0;
            left: calc(50% - 2px);
            width: 4px;
            height: 90%;
            background: #fff;
            border-radius: 4px;
            transform-origin: bottom center;
            transition: transform 1.5s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 10px rgba(255,255,255,0.5);
        }
        .tech-health-score-value {
            margin-top: 15px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 2.2rem;
            font-weight: 900;
            color: #fff;
            letter-spacing: -2px;
        }
        
        .tech-health-text {
            flex-grow: 1;
        }
        .tech-health-title {
            font-size: 0.8rem;
            color: #a855f7;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }
        .tech-health-summary {
            font-size: 1.15rem;
            color: #f8fafc;
            line-height: 1.6;
        }

        .highlight-good {
            color: #00FF9D !important;
            font-weight: bold;
        }
        .highlight-bad {
            color: #ff4d4d !important;
            font-weight: bold;
        }
        .highlight-neutral {
            color: #f59e0b !important;
            font-weight: bold;
        }
        
        @media screen and (max-width: 768px) {
            .tech-health-panel {
                flex-direction: column;
                text-align: center;
                gap: 15px;
                padding: 20px;
            }
            .tech-health-text {
                text-align: center;
            }
        }

        .strategy-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .chart-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
            position: relative;
        }

        .crosshair {
            stroke: #475569;
            stroke-dasharray: 4;
            pointer-events: none;
        }

        .price-text {
            fill: #94a3b8;
            font-size: 11px;
            font-family: monospace;
        }

        .time-text {
            fill: #64748b;
            font-size: 10px;
            text-anchor: middle;
        }

        #svg-container {
            position: relative;
            height: 450px;
            width: 100%;
            cursor: crosshair;
            user-select: none;
            overflow: hidden;
        }

        .sub-chart {
            height: 220px;
            width: 100%;
            user-select: none;
            overflow: hidden;
            border-top: 1px dashed #334155;
            margin-top: 15px;
            padding-top: 15px;
            display: none;
        }

        .toolbar {
            display: flex;
            gap: 8px;
            background: #0d1117;
            padding: 6px;
            border-radius: 8px;
            border: 1px solid var(--border);
            align-items: center;
            flex-wrap: wrap;
        }

        .tool-btn {
            background: transparent;
            border: 1px solid transparent;
            color: #8E9BAE;
            padding: 4px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 600;
            transition: all 0.2s;
        }

        .tool-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
        }

        .tool-btn.active {
            background: rgba(56, 189, 248, 0.1);
            border-color: #38bdf8;
            color: #38bdf8;
        }

        .tool-checkbox {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.8rem;
            font-weight: bold;
            cursor: pointer;
        }

        .chart-card:fullscreen,
        .chart-card:-webkit-full-screen {
            padding: 15px !important;
            width: 100vw !important;
            height: 100vh !important;
            margin: 0 !important;
            border-radius: 0 !important;
            border: none !important;
            display: flex !important;
            flex-direction: column !important;
            background: #0d1117 !important;
            overflow: hidden !important;
            z-index: 9999 !important;
        }

        .close-fullscreen-btn,
        .menu-toggle-btn {
            display: none;
            position: absolute;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            cursor: pointer;
            z-index: 100000;
            align-items: center;
            justify-content: center;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .close-fullscreen-btn {
            background: rgba(239, 83, 80, 0.15);
            color: #ef5350;
            border: 1px solid rgba(239, 83, 80, 0.4);
            box-shadow: 0 4px 15px rgba(239, 83, 80, 0.2);
        }

        .close-fullscreen-btn:hover {
            background: rgba(239, 83, 80, 0.35);
            color: #fff;
            box-shadow: 0 6px 20px rgba(239, 83, 80, 0.4);
            transform: scale(1.05);
        }

        .menu-toggle-btn {
            background: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
            border: 1px solid rgba(56, 189, 248, 0.4);
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.2);
        }

        .menu-toggle-btn:hover {
            background: rgba(56, 189, 248, 0.35);
            color: #fff;
            box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
            transform: scale(1.05);
        }

        .chart-card:fullscreen .close-fullscreen-btn,
        .chart-card:-webkit-full-screen .close-fullscreen-btn,
        .mobile-fullscreen .close-fullscreen-btn,
        .chart-card:fullscreen .menu-toggle-btn,
        .chart-card:-webkit-full-screen .menu-toggle-btn,
        .mobile-fullscreen .menu-toggle-btn {
            display: flex !important;
        }

        .chart-card:fullscreen #svg-container,
        .chart-card:-webkit-full-screen #svg-container,
        .chart-card:fullscreen #pattern-container,
        .chart-card:-webkit-full-screen #pattern-container,
        .fake-fullscreen #svg-container,
        .fake-fullscreen #pattern-container {
            flex: 1 1 0 !important;
            height: auto !important;
        }

        /* Chart Header HUD */
        .chart-header-hud {
            display: none;
            width: 100%;
            align-items: center;
            justify-content: space-between;
            background: rgba(13, 17, 23, 0.65);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 8px;
            padding: 8px 16px;
            margin-bottom: 12px;
            box-sizing: border-box;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        .chart-card:fullscreen .chart-header-hud,
        .chart-card:-webkit-full-screen .chart-header-hud,
        .mobile-fullscreen .chart-header-hud {
            display: flex !important;
        }

        /* Hide the old h3 when HUD is showing */
        .chart-card:fullscreen h3,
        .chart-card:-webkit-full-screen h3,
        .mobile-fullscreen h3 {
            display: none !important;
        }

        .hud-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .hud-ticker {
            background: rgba(0, 229, 255, 0.1);
            color: #00E5FF;
            border: 1px solid rgba(0, 229, 255, 0.3);
            padding: 3px 8px;
            border-radius: 4px;
            font-weight: 800;
            font-size: 0.8rem;
            font-family: 'JetBrains Mono', monospace;
        }

        .hud-timeframe {
            background: rgba(255, 255, 255, 0.05);
            color: #cbd5e1;
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 3px 6px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.75rem;
            font-family: 'JetBrains Mono', monospace;
        }

        .hud-live-dot {
            width: 8px;
            height: 8px;
            background: #26a69a;
            border-radius: 50%;
            box-shadow: 0 0 8px #26a69a;
            animation: pulse-green 1.5s infinite;
        }

        .hud-live-text {
            color: #26a69a;
            font-size: 0.75rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .hud-center {
            font-family: 'Inter', sans-serif;
            font-size: 0.9rem;
            font-weight: 700;
            color: #f8fafc;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .hud-right {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .hud-price-label {
            color: #64748b;
            font-size: 0.75rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        .hud-price-value {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 800;
            font-size: 0.95rem;
            color: #fff;
        }

        @media screen and (max-width: 768px) {
            .chart-card:fullscreen .sub-chart,
            .chart-card:-webkit-full-screen .sub-chart,
            .fake-fullscreen .sub-chart {
                height: 75px !important;
                margin-top: 6px !important;
                padding-top: 6px !important;
            }
        }

        /* Mobile Fullscreen Panel */
        .mobile-fullscreen {
            position: fixed !important;
            z-index: 99999 !important;
            margin: 0 !important;
            border-radius: 0 !important;
            border: none !important;
            display: flex !important;
            flex-direction: column !important;
            background: #0d1117 !important;
            box-sizing: border-box !important;
            padding: 8px !important;
        }

        /* Mobile Fullscreen Spacing & Scrolling Optimizations */
        .mobile-fullscreen #ai-trend-suggestion {
            display: none !important;
        }

        .mobile-fullscreen #svg-container,
        .mobile-fullscreen #pattern-container {
            display: block !important;
            flex: 1 1 0 !important;
            height: auto !important;
            min-height: 0 !important;
            width: 100% !important;
        }

        .mobile-fullscreen .sub-chart {
            display: block !important;
            flex: 0 0 80px !important;
            height: 80px !important;
            min-height: 80px !important;
            width: 100% !important;
            margin-top: 10px !important;
            padding-top: 10px !important;
            border-top: 2px dashed #334155 !important;
            box-sizing: border-box !important;
        }

        .mobile-fullscreen .chart-header-hud {
            margin-bottom: 6px !important;
            padding: 6px 12px !important;
        }

        .mobile-fullscreen .chart-title-row {
            margin-bottom: 0px !important;
        }

        @media screen and (orientation: portrait) {
            .mobile-fullscreen {
                top: 50% !important;
                left: 50% !important;
                width: 100vh !important;
                width: 100dvh !important;
                height: 100vw !important;
                height: 100dvw !important;
                transform: translate(-50%, -50%) rotate(90deg) !important;
                overflow: hidden !important; /* Prevent scroll entirely, flexbox handles sizing */
            }

            .mobile-fullscreen .close-fullscreen-btn {
                top: 20px !important;
                right: 20px !important; /* Mapped Top-Right physically */
                left: auto !important;
                bottom: auto !important;
            }

            .mobile-fullscreen .menu-toggle-btn {
                top: 20px !important;
                left: 20px !important; /* Mapped Top-Left physically */
                right: auto !important;
                bottom: auto !important;
            }
        }

        @media screen and (orientation: landscape) {
            .mobile-fullscreen {
                top: 0 !important;
                left: 0 !important;
                width: 100vw !important;
                width: 100dvw !important;
                height: 100vh !important;
                height: 100dvh !important;
                transform: none !important;
                overflow: hidden !important;
            }

            .mobile-fullscreen .close-fullscreen-btn {
                top: 20px !important;
                right: 20px !important;
                left: auto !important;
                bottom: auto !important;
            }

            .mobile-fullscreen .menu-toggle-btn {
                top: 20px !important;
                left: 20px !important;
                right: auto !important;
                bottom: auto !important;
            }
        }

        /* Sidebar styling for fullscreen: Grid Layout (Desktop) */
        .chart-card:fullscreen .toolbar,
        .chart-card:-webkit-full-screen .toolbar {
            position: absolute !important;
            top: 70px !important;
            left: 15px !important;
            width: 320px !important;
            max-height: calc(100vh - 90px) !important;
            background: rgba(13, 17, 23, 0.95) !important;
            backdrop-filter: blur(10px) !important;
            border: 1px solid var(--border) !important;
            border-radius: 12px !important;
            padding: 12px !important;
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            align-items: center !important;
            gap: 8px !important;
            z-index: 99999 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            transform: translateX(-350px) !important;
            transition: transform 0.3s ease !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;
        }

        .chart-card:fullscreen .toolbar.open,
        .chart-card:-webkit-full-screen .toolbar.open {
            transform: translateX(0) !important;
        }

        .chart-card:fullscreen .toolbar .tool-btn,
        .chart-card:-webkit-full-screen .toolbar .tool-btn {
            width: 100% !important;
            text-align: left !important;
            padding: 8px 12px !important;
            border-radius: 6px !important;
            flex-shrink: 0 !important;
        }

        .chart-card:fullscreen .toolbar .tool-checkbox,
        .chart-card:-webkit-full-screen .toolbar .tool-checkbox {
            width: 100% !important;
            box-sizing: border-box !important;
            padding: 6px 8px !important;
            flex-shrink: 0 !important;
            margin-left: 0 !important;
        }

        .chart-card:fullscreen .toolbar #btn-fullscreen-main,
        .chart-card:-webkit-full-screen .toolbar #btn-fullscreen-main {
            grid-column: span 2 !important;
        }

        .chart-card:fullscreen .toolbar span,
        .chart-card:-webkit-full-screen .toolbar span {
            grid-column: span 2 !important;
            margin-top: 4px !important;
            margin-bottom: 2px !important;
        }

        .chart-card:fullscreen .toolbar div[style*="width: 1px"],
        .chart-card:-webkit-full-screen .toolbar div[style*="width: 1px"],
        .chart-card:fullscreen .toolbar div[style*="width:1px"],
        .chart-card:-webkit-full-screen .toolbar div[style*="width:1px"] {
            grid-column: span 2 !important;
            width: 100% !important;
            height: 1px !important;
            margin: 6px 0 !important;
            background: #30363d !important;
            flex-shrink: 0 !important;
        }

        /* Mobile Fullscreen Toolbar: Grid-like chip panel */
        .mobile-fullscreen .toolbar {
            position: absolute !important;
            top: 70px !important;
            left: 15px !important;
            width: calc(100% - 30px) !important;
            max-height: calc(100% - 90px) !important;
            background: rgba(13, 17, 23, 0.96) !important;
            backdrop-filter: blur(15px) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 12px !important;
            padding: 12px !important;
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: wrap !important;
            align-content: flex-start !important;
            justify-content: flex-start !important;
            align-items: center !important;
            gap: 6px 8px !important;
            z-index: 99999 !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            transform: translateY(-150%) !important;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5) !important;
        }

        .mobile-fullscreen .toolbar.open {
            transform: translateY(0) !important;
        }

        .mobile-fullscreen .toolbar .tool-btn,
        .mobile-fullscreen .toolbar .tool-checkbox {
            width: calc(33.33% - 6px) !important;
            height: 38px !important;
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            color: #8E9BAE !important;
            padding: 4px 8px !important;
            border-radius: 6px !important;
            flex-shrink: 0 !important;
            box-sizing: border-box !important;
            margin: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            font-size: 0.72rem !important;
            font-weight: 600 !important;
            transition: all 0.2s ease !important;
        }

        .mobile-fullscreen .toolbar .tool-btn:hover,
        .mobile-fullscreen .toolbar .tool-checkbox:hover {
            background: rgba(255, 255, 255, 0.08) !important;
            color: #fff !important;
            border-color: rgba(255, 255, 255, 0.15) !important;
        }

        .mobile-fullscreen .toolbar .tool-btn.active {
            background: rgba(56, 189, 248, 0.1) !important;
            border-color: #38bdf8 !important;
            color: #38bdf8 !important;
        }

        .mobile-fullscreen .toolbar span {
            width: 100% !important;
            margin: 8px 0 4px 0 !important;
            color: #38bdf8 !important;
            font-size: 0.7rem !important;
            font-weight: bold !important;
            text-transform: uppercase !important;
            letter-spacing: 1px !important;
            display: flex !important;
            align-items: center;
        }

        .mobile-fullscreen .toolbar div[style*="width: 1px"],
        .mobile-fullscreen .toolbar div[style*="width:1px"] {
            width: 100% !important;
            height: 1px !important;
            margin: 8px 0 !important;
            background: rgba(255, 255, 255, 0.08) !important;
            flex-shrink: 0 !important;
        }

        /* Hide navbar/header and sidebar when chart is in full screen or mobile rotated view */
        body.fullscreen-active .navbar,
        body.fullscreen-active .price-ticker-wrapper,
        body.fullscreen-active .ticker-sidebar,
        body.fullscreen-active .side-panel,
        body.fullscreen-active .side-panel.right,
        body.fullscreen-active .strategy-header {
            display: none !important;
        }

        /* Hide all sibling panels in content-panel except the active fullscreen container */
        body.fullscreen-active .content-panel > * {
            display: none !important;
        }
        body.fullscreen-active .content-panel > .mobile-fullscreen {
            display: block !important;
        }
        body.fullscreen-active .content-panel > :fullscreen,
        body.fullscreen-active .content-panel > :-webkit-full-screen {
            display: flex !important;
        }

        body.fullscreen-active .main-wrapper {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            height: 100vh !important;
            width: 100vw !important;
        }

        body.fullscreen-active .content-panel {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            overflow: visible !important;
            backdrop-filter: none !important;
            filter: none !important;
        }

        body.fullscreen-active {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: 100% !important;
            overflow: hidden !important;
        }

        @keyframes pulse-green {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(38, 166, 154, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(38, 166, 154, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(38, 166, 154, 0); }
        }
        @keyframes blink {
            from, to { border-color: transparent }
            50% { border-color: #38bdf8; }
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="main-wrapper">
            <%- include('partials/sidebar') %>

                <main class="content-panel">
                    <div class="strategy-header">
                        <div>
                            <a href="/predict?ticker=<%= ticker %>"
                                style="color: #8E9BAE; text-decoration: none; font-size: 0.85rem; display: flex; align-items: center; gap: 5px; margin-bottom: 10px;">
                                ← Back to AI Prediction
                            </a>
                            <h1 style="margin: 0; font-size: 2.2rem;">Pro Chart: <span class="accent">
                                    <%= ticker %>
                                </span></h1>
                            <p style="margin: 5px 0 0 0; color: #8E9BAE; font-size: 0.9rem;">Timeframe: <strong
                                    id="timeframe-label" style="color: #fff;">
                                    <%= timeframe %>
                                </strong></p>
                        </div>
                        <div class="tf-btn-group">
                            <button class="tf-btn <%= timeframe === '5m' ? 'active' : '' %>" onclick="changeTimeframe('5m', this)">5 Min</button>
                            <button class="tf-btn <%= timeframe === '1d' ? 'active' : '' %>" onclick="changeTimeframe('1d', this)">1 Day</button>
                            <button class="tf-btn <%= timeframe === '1wk' ? 'active' : '' %>" onclick="changeTimeframe('1wk', this)">1 Week</button>
                        </div>
                    </div>

                    <div class="tech-health-panel" id="tech-health-panel" style="display: none;">
                        <div class="tech-health-gauge">
                            <div class="tech-gauge-bg">
                                <div class="tech-gauge-inner"></div>
                                <div id="tech-needle" class="tech-gauge-needle" style="transform: rotate(0deg);"></div>
                            </div>
                            <div class="tech-health-score-value" id="tech-score-text">0/100</div>
                        </div>
                        <div class="tech-health-text">
                            <div class="tech-health-title">✨ AI Technical Evaluation</div>
                            <div class="tech-health-summary" id="tech-summary-text">
                                Analyzing technical indicators...
                            </div>
                        </div>
                    </div>

                    <div class="chart-card" id="main-chart-card" style="padding-bottom: 25px;">
                        <button class="close-fullscreen-btn" onclick="exitFullScreen(this)" title="Close Full Screen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                        <button class="menu-toggle-btn" onclick="toggleSidebarMenu(this)" title="Toggle Drawing Tools">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
                        </button>

                        <div class="chart-header-hud">
                            <div class="hud-left">
                                <span class="hud-ticker"><%= ticker %></span>
                                <span class="hud-timeframe"><%= timeframe %></span>
                                <span class="hud-live-dot"></span>
                                <span class="hud-live-text">Live</span>
                            </div>
                            <div class="hud-center">
                                <span class="hud-title">Advanced Technical Canvas</span>
                            </div>
                            <div class="hud-right">
                                <span class="hud-price-label">Last:</span>
                                <span class="hud-price-value">--</span>
                            </div>
                        </div>

                        <div class="chart-title-row"
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                            <h3 style="margin: 0; color: #e2e8f0;">Advanced Technical Canvas <span
                                    style="font-size: 0.75rem; color: #64748b; font-weight: normal; margin-left: 10px;">(Hold
                                    Ctrl to Zoom)</span></h3>

                            <div class="toolbar">
                                <button class="tool-btn" id="btn-fullscreen-main"
                                    style="color: #fff; background: rgba(255,255,255,0.1);">⛶ Full View</button>
                                <button class="tool-btn active" id="tool-pan">✋ Pan</button>
                                <button class="tool-btn" id="tool-hz">➖ S/R Line</button>
                                <button class="tool-btn" id="tool-trend">📈 Trendline</button>
                                <button class="tool-btn" id="tool-fib">📐 Fibonacci</button>
                                <button class="tool-btn" id="tool-clear" style="color: #ef5350;">🗑️ Clear</button>

                                <div style="width: 1px; height: 20px; background: #30363d; margin: 0 5px;"></div>

                                <label class="tool-checkbox" style="color: #38bdf8;"><input type="checkbox"
                                        id="toggle-sma20"> SMA 20</label>
                                <label class="tool-checkbox" style="color: #f59e0b;"><input type="checkbox"
                                        id="toggle-sma50"> SMA 50</label>
                                <label class="tool-checkbox" style="color: #22d3ee; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-ema9"> EMA 9</label>
                                <label class="tool-checkbox" style="color: #818cf8; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-ema21"> EMA 21</label>
                                <label class="tool-checkbox" style="color: #fbbf24; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-vwap"> VWAP</label>
                                <label class="tool-checkbox" style="color: #a78bfa; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-ichimoku"> Ichimoku</label>
                                <label class="tool-checkbox" style="color: #4ade80; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-supertrend"> SuperTrend</label>
                                <label class="tool-checkbox" style="color: #f43f5e; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-fvg"> FVG</label>
                                <label class="tool-checkbox" style="color: #00E5FF; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-bb"> Bollinger Bands</label>
                                <label class="tool-checkbox" style="color: #f472b6; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-psar"> Trend Dots</label>
                                <label class="tool-checkbox" style="color: #cbd5e1; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-vpvr"> Vol Profile</label>
                                <label class="tool-checkbox" style="color: #4ade80; margin-left: 5px;"><input
                                        type="checkbox" id="toggle-candlesignals"> Signals</label>

                                <div style="width: 1px; height: 20px; background: #30363d; margin: 0 5px;"></div>

                                <span
                                    style="color: #8E9BAE; font-size: 0.75rem; font-weight: bold; text-transform: uppercase;">Oscillator:</span>
                                <button class="tool-btn active" id="tab-rsi"
                                    style="color: #a855f7; border-color: rgba(168, 85, 247, 0.4); background: rgba(168, 85, 247, 0.1);">RSI</button>
                                <button class="tool-btn" id="tab-macd" style="color: #4ade80;">MACD</button>
                                <button class="tool-btn" id="tab-stoch" style="color: #fbbf24;">Stoch</button>
                                <button class="tool-btn" id="tab-atr" style="color: #38bdf8;">ATR</button>
                                <button class="tool-btn" id="tab-ao" style="color: #f472b6;">AO</button>
                                <button class="tool-btn" id="tab-none" style="color: #ef5350;">Off</button>
                            </div>
                        </div>

                        <div id="ai-trend-suggestion" class="trend-suggestion-box" style="display: none;">
                            <div class="trend-left">
                                <span class="trend-badge">AI FORECAST GAUGE</span>
                                <span id="trend-summary-text">Analyzing trend projections...</span>
                            </div>
                            <div class="trend-right">
                                <span id="ema9-projection" style="color: #22d3ee;">EMA 9: --</span>
                                <span id="ema21-projection" style="color: #818cf8;">EMA 21: --</span>
                                <span id="sma20-projection" style="color: #38bdf8;">SMA 20: --</span>
                                <span id="sma50-projection" style="color: #f59e0b;">SMA 50: --</span>
                            </div>
                        </div>

                        <div id="svg-container">
                            <div id="tech-chart-loading" class="chart-loading-overlay">
                                <div class="loading-pulse">Calculating Technical Indicators...</div>
                            </div>
                            <svg id="main-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="grid-layer"></g>
                                <g id="volume-layer" opacity="0.15"></g>
                                <g id="overlay-layer"></g>
                                <g id="candle-layer" style="shape-rendering: crispEdges;"></g>
                                <g id="signal-layer"></g>
                                <g id="drawing-layer"></g>
                                <g id="time-layer"></g>
                                <line id="cross-h" class="crosshair" x1="0" y1="0" x2="100%" y2="0" />
                                <line id="cross-v" class="crosshair" x1="0" y1="0" x2="0" y2="100%" />
                            </svg>
                        </div>

                        <div id="rsi-container" class="sub-chart" style="display: block;">
                            <svg id="rsi-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="rsi-grid-layer"></g>
                                <g id="rsi-line-layer"></g>
                            </svg>
                        </div>

                        <div id="macd-container" class="sub-chart" style="display: none;">
                            <svg id="macd-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="macd-grid-layer"></g>
                                <g id="macd-hist-layer" style="shape-rendering: crispEdges;"></g>
                                <g id="macd-line-layer"></g>
                            </svg>
                        </div>

                        <div id="stoch-container" class="sub-chart" style="display: none;">
                            <svg id="stoch-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="stoch-grid-layer"></g>
                                <g id="stoch-line-layer"></g>
                            </svg>
                        </div>

                        <div id="atr-container" class="sub-chart" style="display: none;">
                            <svg id="atr-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="atr-grid-layer"></g>
                                <g id="atr-line-layer"></g>
                            </svg>
                        </div>

                        <div id="ao-container" class="sub-chart" style="display: none;">
                            <svg id="ao-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="ao-grid-layer"></g>
                                <g id="ao-hist-layer" style="shape-rendering: crispEdges;"></g>
                            </svg>
                        </div>
                    </div>

                    <div class="chart-card" id="virtual-trading-panel" style="padding: 25px; margin-bottom: 25px;">
                        <div class="panel-header-row">
                            <h3 style="margin: 0; color: #f8fafc; font-size: 1.25rem;">Virtual Paper Trading Terminal</h3>
                            <a href="/trade-history" style="color: #38bdf8; text-decoration: none; font-size: 0.85rem; font-weight: 600;" onmouseover="this.style.textDecoration='underline'" onmouseout="this.style.textDecoration='none'">
                                View Complete Portfolio & Trade History →
                            </a>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                                <div style="background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;">
                                    <div style="font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;">Available Cash</div>
                                    <div id="virtual-cash-display" style="font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;">$100,000.00</div>
                                </div>
                                <div style="background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;">
                                    <div style="font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;">Position in <%= ticker %></div>
                                    <div id="virtual-holding-display" style="font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;">0 Shares</div>
                                </div>
                                <div style="background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;">
                                    <div style="font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;">Average Buy Price</div>
                                    <div id="virtual-avg-price-display" style="font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;">$0.00</div>
                                </div>
                            </div>
                            
                            <div class="trade-action-box">
                                <div style="flex: 1; min-width: 150px;">
                                    <label style="display: block; font-size: 0.75rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 8px;">Order Action</label>
                                    <div style="display: flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #0d1117; height: 42px; box-sizing: border-box;">
                                        <button type="button" id="trade-btn-buy" onclick="setChartTradeAction('BUY')" style="flex: 1; border: none; background: #26a69a; color: #000; font-weight: bold; cursor: pointer; transition: all 0.2s;">BUY</button>
                                        <button type="button" id="trade-btn-sell" onclick="setChartTradeAction('SELL')" style="flex: 1; border: none; background: transparent; color: #8E9BAE; font-weight: bold; cursor: pointer; transition: all 0.2s;">SELL</button>
                                    </div>
                                </div>
                                
                                <div style="flex: 1; min-width: 120px;">
                                    <label style="display: block; font-size: 0.75rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 8px;">Quantity</label>
                                    <input type="number" id="trade-qty-input" value="1" min="1" step="1" oninput="recalcChartTradeEstimate()" style="width: 100%; height: 42px; padding: 10px; background: #0d1117; border: 1px solid var(--border); border-radius: 6px; color: #fff; font-family: 'JetBrains Mono', monospace; font-size: 1rem; font-weight: bold; outline: none; box-sizing: border-box;">
                                </div>
                                
                                <div style="flex: 1.5; min-width: 180px;">
                                    <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 8px;">
                                        <span>Estimated Cost</span>
                                        <span id="chart-trade-currency" style="color: #64748b;">USD</span>
                                    </div>
                                    <div style="background: #0d1117; border: 1px solid var(--border); border-radius: 6px; padding: 0 15px; height: 42px; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box;">
                                        <span id="chart-trade-estimate-price" style="font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: #8E9BAE;">$0.00 each</span>
                                        <span id="chart-trade-estimate-total" style="font-family: 'JetBrains Mono', monospace; font-weight: bold; color: #fff; font-size: 1rem;">$0.00</span>
                                    </div>
                                </div>
                                
                                <button type="button" id="chart-trade-submit-btn" onclick="executeChartTrade()" style="height: 42px; padding: 0 25px; background: #26a69a; border: none; border-radius: 6px; color: #000; font-weight: bold; cursor: pointer; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.2s; box-shadow: 0 4px 15px rgba(38,166,154,0.3);">
                                    BUY <%= ticker %>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="chart-card" id="sentiment-analysis-panel" style="padding: 25px; margin-bottom: 25px;">
                        <div class="panel-header-row">
                            <h3 style="margin: 0; color: #f8fafc; font-size: 1.25rem; display: flex; align-items: center; gap: 8px;">
                                <span>🤖</span> AI News & Sentiment Terminal
                            </h3>
                            <span style="font-size: 0.8rem; color: #8e9bae; font-family: 'JetBrains Mono', monospace;" id="sentiment-last-updated">PENDING...</span>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                                <div style="background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px; display: flex; align-items: center; justify-content: space-between;">
                                    <div>
                                        <div style="font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;">Overall Sentiment</div>
                                        <div id="sentiment-overall-label" style="font-family: 'JetBrains Mono', monospace; font-size: 1.4rem; font-weight: 800; color: #8e9bae;">LOADING...</div>
                                    </div>
                                    <div id="sentiment-overall-icon" style="font-size: 2.2rem;">📡</div>
                                </div>

                                <div style="background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px; display: flex; align-items: center; gap: 20px;">
                                    <div style="position: relative; width: 80px; height: 40px; overflow: hidden; flex-shrink: 0;">
                                        <div style="width: 80px; height: 80px; border-radius: 50%; background: conic-gradient(from 270deg at 50% 50%, #ff0055 0deg, #f59e0b 90deg, #00FF9D 180deg, transparent 180deg); box-sizing: border-box; position: absolute; top: 0; left: 0;"></div>
                                        <div style="width: 60px; height: 60px; border-radius: 50%; background: #0d1117; position: absolute; top: 10px; left: 10px;"></div>
                                        <div style="width: 8px; height: 8px; border-radius: 50%; background: #fff; position: absolute; bottom: 0; left: 36px; z-index: 5;"></div>
                                        <div id="sentiment-gauge-needle" style="width: 2px; height: 32px; background: #fff; position: absolute; bottom: 0; left: 39px; transform-origin: bottom center; transform: rotate(0deg); transition: transform 1s cubic-bezier(0.175, 0.885, 0.32, 1.275); z-index: 4; box-shadow: 0 0 5px rgba(255,255,255,0.8);"></div>
                                    </div>
                                    <div>
                                        <div style="font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;">Sentiment Index</div>
                                        <div id="sentiment-index-val" style="font-family: 'JetBrains Mono', monospace; font-size: 1.3rem; font-weight: 800; color: #fff;">0.00</div>
                                    </div>
                                </div>

                                <div style="background: #0d1117; border: 1px solid var(--border); padding: 15px; border-radius: 8px;">
                                    <div style="font-size: 0.7rem; color: #8E9BAE; text-transform: uppercase; font-weight: bold; margin-bottom: 5px;">Key Market Drivers</div>
                                    <div id="sentiment-drivers-container" style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 5px;">
                                        <span style="font-size: 0.75rem; color: #64748b;">No active drivers</span>
                                    </div>
                                </div>
                            </div>

                            <div style="background: #0d1117; border: 1px solid var(--border); border-radius: 8px; padding: 20px;">
                                <div style="font-size: 0.8rem; color: #8e9bae; font-weight: bold; text-transform: uppercase; border-bottom: 1px solid var(--border); padding-bottom: 10px; margin-bottom: 15px;">
                                    Latest Headwinds & Catalysts
                                </div>
                                <div id="sentiment-news-list" style="display: flex; flex-direction: column; gap: 15px; max-height: 250px; overflow-y: auto; padding-right: 5px;">
                                    <div style="text-align: center; color: #64748b; padding: 20px; font-size: 0.9rem;">
                                        Analyzing news articles...
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="chart-card" id="pattern-chart-card">
                        <button class="close-fullscreen-btn" onclick="exitFullScreen(this)" title="Close Full Screen">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </button>
                        <button class="menu-toggle-btn" onclick="toggleSidebarMenu(this)" title="Toggle Drawing Tools">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
                        </button>

                        <div class="chart-header-hud">
                            <div class="hud-left">
                                <span class="hud-ticker"><%= ticker %></span>
                                <span class="hud-timeframe"><%= timeframe %></span>
                                <span class="hud-live-dot"></span>
                                <span class="hud-live-text">Live Analysis</span>
                            </div>
                            <div class="hud-center">
                                <span class="hud-title">Pattern Recognition Canvas</span>
                            </div>
                            <div class="hud-right">
                                <span class="hud-price-label">Last:</span>
                                <span class="hud-price-value">--</span>
                            </div>
                        </div>

                        <div class="chart-title-row"
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; flex-wrap: wrap; gap: 10px;">
                            <h3 style="margin: 0; color: #e2e8f0;">Pattern Recognition Canvas <span
                                    style="font-size: 0.75rem; color: #64748b; font-weight: normal; margin-left: 10px;">(Hold
                                    Ctrl to Zoom)</span></h3>
                            <div class="toolbar"
                                style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                                <button class="tool-btn" id="btn-fullscreen-pattern"
                                    style="color: #fff; background: rgba(255,255,255,0.1); border: 1px solid transparent; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-size: 0.8rem; font-weight: 600;">⛶
                                    Full View</button>
                                <label class="tool-checkbox"
                                    style="color: #fbbf24; padding: 4px 10px; background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-auto" checked> Auto Patterns
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #26a69a; padding: 4px 10px; background: rgba(38, 166, 154, 0.1); border: 1px solid rgba(38, 166, 154, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-trendline" checked> Auto Trendline
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #a855f7; padding: 4px 10px; background: rgba(168, 85, 247, 0.1); border: 1px solid rgba(168, 85, 247, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-sr"> Auto S/R
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #f43f5e; padding: 4px 10px; background: rgba(244, 63, 94, 0.1); border: 1px solid rgba(244, 63, 94, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-fib"> Auto Fib
                                </label>
                                <label class="tool-checkbox"
                                    style="color: #60a5fa; padding: 4px 10px; background: rgba(96, 165, 250, 0.1); border: 1px solid rgba(96, 165, 250, 0.4); border-radius: 4px;">
                                    <input type="checkbox" id="toggle-pattern-pivot"> Pivot Points
                                </label>
                            </div>
                        </div>
                        <div id="pattern-container"
                            style="position: relative; height: 350px; width: 100%; user-select: none; overflow: hidden; display: block; cursor: crosshair;">
                            <div id="pattern-chart-loading" class="chart-loading-overlay">
                                <div class="loading-pulse">Analyzing Candlestick Patterns...</div>
                            </div>
                            <svg id="pattern-svg" style="width: 100%; height: 100%; display: block;">
                                <g id="pattern-grid-layer"></g>
                                <g id="pattern-candle-layer" style="shape-rendering: crispEdges;"></g>
                                <g id="pattern-signal-layer"></g>
                                <g id="pattern-time-layer"></g>
                                <g id="pattern-drawing-layer"></g>
                                <line id="cross-h-pat" class="crosshair" x1="0" y1="0" x2="100%" y2="0" />
                                <line id="cross-v-pat" class="crosshair" x1="0" y1="0" x2="0" y2="100%" />
                            </svg>
                        </div>
                    </div>

                    <div class="chart-card" id="ai-summary-section" style="margin-top: 25px; display: none;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <h3 style="margin: 0; color: #e2e8f0; display: flex; align-items: center; gap: 8px;">
                                    <span style="color: #38bdf8;">🤖</span> AI Technical Analyst Executive Summary
                                </h3>
                                <div style="display: flex; align-items: center; gap: 5px; background: rgba(38, 166, 154, 0.1); border: 1px solid rgba(38, 166, 154, 0.2); padding: 3px 8px; border-radius: 4px;">
                                    <span style="width: 6px; height: 6px; background: #26a69a; border-radius: 50%; display: inline-block; animation: pulse-green 1.5s infinite;"></span>
                                    <span style="font-size: 0.65rem; color: #26a69a; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase;">Live Quant Analysis</span>
                                </div>
                            </div>
                            <button id="copy-summary-btn" onclick="copySummaryText()" style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 6px; transition: all 0.2s; border-radius: 6px;">
                                📋 Copy Report
                            </button>
                        </div>
                        <div id="ai-summary-content" style="font-family: 'Inter', sans-serif; font-size: 0.95rem; line-height: 1.7; color: #cbd5e1; background: rgba(13, 17, 23, 0.5); border: 1px solid #1e293b; padding: 25px; border-radius: 12px; min-height: 120px; max-height: 400px; overflow-y: auto; position: relative;">
                            <div id="ai-summary-text" style="font-family: 'Inter', sans-serif; font-size: 0.95rem; line-height: 1.7; color: #e2e8f0; white-space: pre-line;">Generating technical analysis script...</div>
                        </div>
                    </div>

                    <%- include('partials/footer') %>
                </main>
                <aside class="side-panel right"></aside>
        </div>

        <script>
            const currentTicker = "<%= ticker %>";
            let currentTimeframe = "<%= timeframe %>";

            function changeTimeframe(tf, btnElement) {
                currentTimeframe = tf;
                document.querySelectorAll('.tf-btn').forEach(btn => btn.classList.remove('active'));
                btnElement.classList.add('active');

                const tfLabel = document.getElementById('timeframe-label');
                if (tfLabel) {
                    tfLabel.innerText = tf;
                }

                drawnLines = []; // Clear manual drawings since index/price scales change
                fetchOHLCData();
            }

            let ohlcData = [];

            // State Management
            let visibleCount = window.innerWidth <= 768 ? 40 : 80; let offset = 0; let dragAccumulator = 0;
            let chartState = { minP: 0, maxP: 0, range: 0, candleW: 0, chartH: 0, padT: 20, padB: 40, padR: 55 };

            let patternVisibleCount = window.innerWidth <= 768 ? 40 : 80; let patternOffset = 0; let patternDragAccumulator = 0;
            let patternState = { minP: 0, maxP: 0, range: 0, candleW: 0, chartH: 0, padT: 20, padB: 40, padR: 55 };

            let verticalScrollShift = 0;
            let patternVerticalScrollShift = 0;

            function toggleSidebarMenu(btn) {
                const card = btn.closest('.chart-card');
                const toolbar = card.querySelector('.toolbar');
                toolbar.classList.toggle('open');
            }

            function closeActiveDrawer() {
                document.querySelectorAll('.toolbar').forEach(tb => tb.classList.remove('open'));
            }

            // UI States
            let showSMA20 = false, showSMA50 = false, showEMA9 = false, showEMA21 = false, showVWAP = false;
            let showBB = false, showVPVR = false, showIchimoku = false, showSuperTrend = false, showFVG = false;
            let showPSAR = false, showCandleSignals = false;

            // NEW STATES FOR PATTERN CANVAS
            let showPatternSR = false, showAutoPatterns = true, showAutoTrendline = true, showAutoFib = false, showPivotPoints = false;

            let activeSubChart = 'RSI', activeTool = 'pan';
            let drawnLines = [], tempTrendline = null, tempFib = null;

            const svgContainer = document.getElementById('svg-container');
            const patternContainer = document.getElementById('pattern-container');
            const chartContainers = [svgContainer, patternContainer];

            // Tools
            const tools = { 'tool-pan': 'pan', 'tool-hz': 'hz', 'tool-trend': 'trend', 'tool-fib': 'fib' };
            Object.keys(tools).forEach(id => {
                document.getElementById(id).onclick = (e) => {
                    document.querySelectorAll('#tool-pan, #tool-hz, #tool-trend, #tool-fib').forEach(b => b.classList.remove('active'));
                    e.target.classList.add('active');
                    activeTool = tools[id];
                    const cursorStyle = activeTool === 'pan' ? 'grab' : 'crosshair';
                    svgContainer.style.cursor = cursorStyle; patternContainer.style.cursor = cursorStyle;
                    closeActiveDrawer();
                };
            });

            // Top Chart Listeners
            document.getElementById('tool-clear').onclick = () => { drawnLines = []; renderAll(); closeActiveDrawer(); };
            document.getElementById('toggle-sma20').onchange = (e) => { showSMA20 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-sma50').onchange = (e) => { showSMA50 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-ema9').onchange = (e) => { showEMA9 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-ema21').onchange = (e) => { showEMA21 = e.target.checked; renderSVG(); };
            document.getElementById('toggle-vwap').onchange = (e) => { showVWAP = e.target.checked; renderSVG(); };
            document.getElementById('toggle-ichimoku').onchange = (e) => { showIchimoku = e.target.checked; renderSVG(); };
            document.getElementById('toggle-supertrend').onchange = (e) => { showSuperTrend = e.target.checked; renderSVG(); };
            document.getElementById('toggle-fvg').onchange = (e) => { showFVG = e.target.checked; renderSVG(); };
            document.getElementById('toggle-bb').onchange = (e) => { showBB = e.target.checked; renderSVG(); };
            document.getElementById('toggle-vpvr').onchange = (e) => { showVPVR = e.target.checked; renderSVG(); };
            document.getElementById('toggle-psar').onchange = (e) => { showPSAR = e.target.checked; renderSVG(); };
            document.getElementById('toggle-candlesignals').onchange = (e) => { showCandleSignals = e.target.checked; renderAll(); };

            // Pattern Chart Listeners
            document.getElementById('toggle-pattern-sr').onchange = (e) => { showPatternSR = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-auto').onchange = (e) => { showAutoPatterns = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-trendline').onchange = (e) => { showAutoTrendline = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-fib').onchange = (e) => { showAutoFib = e.target.checked; renderPatternChart(); };
            document.getElementById('toggle-pattern-pivot').onchange = (e) => { showPivotPoints = e.target.checked; renderPatternChart(); };

            // Checkbox drawer close handler
            document.querySelectorAll('.toolbar input[type="checkbox"]').forEach(cb => {
                cb.addEventListener('change', () => {
                    if (window.innerWidth <= 768) {
                        closeActiveDrawer();
                    }
                });
            });

            document.getElementById('tab-rsi').onclick = () => setSubChart('RSI');
            document.getElementById('tab-macd').onclick = () => setSubChart('MACD');
            document.getElementById('tab-stoch').onclick = () => setSubChart('STOCH');
            document.getElementById('tab-atr').onclick = () => setSubChart('ATR');
            document.getElementById('tab-ao').onclick = () => setSubChart('AO');
            document.getElementById('tab-none').onclick = () => setSubChart('OFF');

            function setSubChart(type) {
                activeSubChart = type;
                const btns = ['tab-rsi', 'tab-macd', 'tab-stoch', 'tab-atr', 'tab-ao', 'tab-none'].map(id => document.getElementById(id));
                const colors = { 'RSI': 'rgba(168, 85, 247,', 'MACD': 'rgba(74, 222, 128,', 'STOCH': 'rgba(251, 191, 36,', 'ATR': 'rgba(56, 189, 248,', 'AO': 'rgba(244, 114, 182,', 'OFF': 'rgba(239, 83, 80,' };

                btns.forEach(btn => { btn.style.borderColor = 'transparent'; btn.style.background = 'transparent'; btn.classList.remove('active'); });
                ['rsi', 'macd', 'stoch', 'atr', 'ao'].forEach(id => document.getElementById(id + '-container').style.display = 'none');

                if (type !== 'OFF') {
                    const activeBtn = document.getElementById('tab-' + type.toLowerCase());
                    const c = colors[type];
                    activeBtn.style.borderColor = c + ' 0.4)'; activeBtn.style.background = c + ' 0.1)'; activeBtn.classList.add('active');
                    document.getElementById(type.toLowerCase() + '-container').style.display = 'block';
                } else {
                    const offBtn = document.getElementById('tab-none');
                    offBtn.style.borderColor = colors['OFF'] + ' 0.4)'; offBtn.style.background = colors['OFF'] + ' 0.1)'; offBtn.classList.add('active');
                }
                closeActiveDrawer();
                renderSVG();
            }

            async function fetchOHLCData() {
                const techOverlay = document.getElementById('tech-chart-loading');
                const patternOverlay = document.getElementById('pattern-chart-loading');
                if (techOverlay) techOverlay.style.display = 'flex';
                if (patternOverlay) patternOverlay.style.display = 'flex';

                try {
                    const res = await fetch(`/api/chart-svg?ticker=${currentTicker}&timeframe=${currentTimeframe}`);
                    let data = await res.json();

                    if (techOverlay) techOverlay.style.display = 'none';
                    if (patternOverlay) patternOverlay.style.display = 'none';

                    if (data.error || !Array.isArray(data)) {
                        document.getElementById('overlay-layer').innerHTML = `<text x="50%" y="50%" fill="#ef5350" font-size="20" font-weight="bold" text-anchor="middle">⚠️ Error: ${data.error || 'Invalid Data'}</text>`;
                        return;
                    }
                    if (data.length > 0 && Array.isArray(data[0])) { data = data.map(d => ({ date: d[0], open: d[1], high: d[2], low: d[3], close: d[4], volume: d[5] })); }

                    ohlcData = data;
                    offset = Math.max(0, ohlcData.length - visibleCount);
                    patternOffset = Math.max(0, ohlcData.length - patternVisibleCount);
                    renderAll();
                    updateTrendSuggestion();
                    generateAITechnicalScript();
                } catch (e) {
                    if (techOverlay) techOverlay.style.display = 'none';
                    if (patternOverlay) patternOverlay.style.display = 'none';
                    document.getElementById('overlay-layer').innerHTML = `<text x="50%" y="50%" fill="#ef5350" font-size="16" font-weight="bold" text-anchor="middle">Network Error: ${e.message}</text>`;
                }
            }

            function getPriceFromY(y, container) {
                const state = container === svgContainer ? chartState : patternState;
                return state.range === 0 ? 0 : state.minP + state.range * ((container.clientHeight - state.padB - y) / state.chartH);
            }
            function getIndexFromX(x, container) {
                return (container === svgContainer ? offset : patternOffset) + Math.floor(x / (container === svgContainer ? chartState : patternState).candleW);
            }

            // Controls (Mouse & Touch)
            function getLocalCoords(clientX, clientY, container) {
                const card = container.closest('.chart-card');
                const isMobileFullscreen = card.classList.contains('mobile-fullscreen');
                const isPortrait = window.innerHeight > window.innerWidth;
                const isRotated = isMobileFullscreen && isPortrait;
                const rect = container.getBoundingClientRect();
                if (isRotated) {
                    const centerX = rect.left + rect.width / 2;
                    const centerY = rect.top + rect.height / 2;
                    const dx_screen = clientX - centerX;
                    const dy_screen = clientY - centerY;
                    const dx_local = dy_screen;
                    const dy_local = -dx_screen;
                    return { x: container.clientWidth / 2 + dx_local, y: container.clientHeight / 2 + dy_local };
                }
                return { x: clientX - rect.left, y: clientY - rect.top };
            }

            const handleWheel = (e, container) => {
                const card = container.closest('.chart-card');
                const isMobileFullscreen = card.classList.contains('mobile-fullscreen');
                const isPortrait = window.innerHeight > window.innerWidth;
                const isRotated = isMobileFullscreen && isPortrait;
                let deltaX = isRotated ? e.deltaY : e.deltaX;
                let deltaY = isRotated ? -e.deltaX : e.deltaY;

                const isMain = container === svgContainer;
                let currentVis = isMain ? visibleCount : patternVisibleCount;
                let currentOff = isMain ? offset : patternOffset;
                let currentDrag = isMain ? dragAccumulator : patternDragAccumulator;

                if (Math.abs(deltaX) > Math.abs(deltaY)) {
                    e.preventDefault(); currentDrag -= deltaX;
                    const candleW = (container.clientWidth - 55) / currentVis;
                    const moves = Math.trunc(currentDrag / candleW);
                    if (moves !== 0) {
                        currentOff = Math.min(Math.max(currentOff - moves, 0), ohlcData.length - currentVis);
                        currentDrag -= (moves * candleW);
                        if (isMain) { offset = currentOff; renderSVG(); }
                        else { patternOffset = currentOff; renderPatternChart(); }
                    }
                    if (isMain) { dragAccumulator = currentDrag; }
                    else { patternDragAccumulator = currentDrag; }
                    return;
                }

                if (e.ctrlKey || e.metaKey) {
                    e.preventDefault(); const delta = Math.sign(deltaY);
                    const oldVis = currentVis;
                    currentVis = Math.min(Math.max(currentVis + (delta * Math.ceil(currentVis * 0.15)), 10), ohlcData.length);
                    currentOff = Math.min(Math.max(currentOff + Math.floor((oldVis - currentVis) / 2), 0), ohlcData.length - currentVis);
                    if (isMain) { offset = currentOff; visibleCount = currentVis; renderSVG(); }
                    else { patternOffset = currentOff; patternVisibleCount = currentVis; renderPatternChart(); }
                }
            };

            svgContainer.addEventListener('wheel', (e) => handleWheel(e, svgContainer), { passive: false });
            patternContainer.addEventListener('wheel', (e) => handleWheel(e, patternContainer), { passive: false });

            // Double Click to Reset Vertical Shifts
            svgContainer.ondblclick = () => { verticalScrollShift = 0; renderSVG(); };
            patternContainer.ondblclick = () => { patternVerticalScrollShift = 0; renderPatternChart(); };

            // Touch Panning & Pinch-to-Zoom
            chartContainers.forEach(container => {
                let tStartX = 0, tStartY = 0;
                let initialTouchDist = 0;
                let initialVisCount = 0;

                container.addEventListener('touchstart', (e) => {
                    if (e.touches.length === 1) {
                        const coords = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                        const card = container.closest('.chart-card');
                        const isMobileFullscreen = card && card.classList.contains('mobile-fullscreen');
                        const isPortrait = window.innerHeight > window.innerWidth;
                        if (isMobileFullscreen && isPortrait) {
                            tStartX = e.touches[0].clientX;
                            tStartY = e.touches[0].clientY;
                        } else {
                            tStartX = coords.x;
                            tStartY = coords.y;
                        }
                        if (container === svgContainer) dragAccumulator = 0; else patternDragAccumulator = 0;
                    } else if (e.touches.length === 2) {
                        const t1 = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                        const t2 = getLocalCoords(e.touches[1].clientX, e.touches[1].clientY, container);
                        initialTouchDist = Math.hypot(t1.x - t2.x, t1.y - t2.y);
                        initialVisCount = container === svgContainer ? visibleCount : patternVisibleCount;
                    }
                }, { passive: true });

                container.addEventListener('touchmove', (e) => {
                    const isMain = container === svgContainer;
                    const card = container.closest('.chart-card');
                    const isMobileFullscreen = card && card.classList.contains('mobile-fullscreen');
                    const isPortrait = window.innerHeight > window.innerWidth;

                    if (isMobileFullscreen && isPortrait) {
                        if (e.touches.length === 1 && activeTool === 'pan') {
                            e.preventDefault();
                            const touchY = e.touches[0].clientY;
                            const dy = touchY - tStartY;
                            tStartY = touchY;

                            let cVis = isMain ? visibleCount : patternVisibleCount;
                            let cOff = isMain ? offset : patternOffset;
                            let cDrag = isMain ? dragAccumulator : patternDragAccumulator;

                            cDrag += dy;
                            const cW = (container.clientWidth - 55) / cVis;
                            const moves = Math.trunc(cDrag / cW);
                            if (moves !== 0) {
                                cOff = Math.min(Math.max(cOff - moves, 0), ohlcData.length - cVis);
                                cDrag -= (moves * cW);
                                if (isMain) { offset = cOff; renderSVG(); }
                                else { patternOffset = cOff; renderPatternChart(); }
                            }
                            if (isMain) { dragAccumulator = cDrag; }
                            else { patternDragAccumulator = cDrag; }
                        }
                    } else {
                        if (e.touches.length === 1 && activeTool === 'pan') {
                            const coords = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                            const dx = coords.x - tStartX;
                            const dy = coords.y - tStartY;

                            if (Math.abs(dx) > Math.abs(dy)) {
                                e.preventDefault();
                                tStartX = coords.x;
                                tStartY = coords.y;

                                let cVis = isMain ? visibleCount : patternVisibleCount;
                                let cOff = isMain ? offset : patternOffset;
                                let cDrag = isMain ? dragAccumulator : patternDragAccumulator;

                                cDrag += dx;
                                const cW = (container.clientWidth - 55) / cVis;
                                const moves = Math.trunc(cDrag / cW);
                                if (moves !== 0) {
                                    cOff = Math.min(Math.max(cOff - moves, 0), ohlcData.length - cVis);
                                    cDrag -= (moves * cW);
                                    if (isMain) { offset = cOff; renderSVG(); }
                                    else { patternOffset = cOff; renderPatternChart(); }
                                }
                                if (isMain) { dragAccumulator = cDrag; }
                                else { patternDragAccumulator = cDrag; }
                            }
                        } else if (e.touches.length === 2 && initialTouchDist > 0) {
                            e.preventDefault();
                            const t1 = getLocalCoords(e.touches[0].clientX, e.touches[0].clientY, container);
                            const t2 = getLocalCoords(e.touches[1].clientX, e.touches[1].clientY, container);
                            const dist = Math.hypot(t1.x - t2.x, t1.y - t2.y);

                            if (dist > 10) {
                                const scale = dist / initialTouchDist;
                                const oldVis = isMain ? visibleCount : patternVisibleCount;
                                let newVis = Math.round(initialVisCount / scale);
                                newVis = Math.min(Math.max(newVis, 10), ohlcData.length);

                                if (newVis !== oldVis) {
                                    if (isMain) {
                                        offset = Math.min(Math.max(offset + Math.floor((oldVis - newVis) / 2), 0), ohlcData.length - newVis);
                                        visibleCount = newVis;
                                        renderSVG();
                                    } else {
                                        patternOffset = Math.min(Math.max(patternOffset + Math.floor((oldVis - newVis) / 2), 0), ohlcData.length - newVis);
                                        patternVisibleCount = newVis;
                                        renderPatternChart();
                                    }
                                }
                            }
                        }
                    }
                }, { passive: false });

                container.addEventListener('touchend', (e) => {
                    if (e.touches.length < 2) {
                        initialTouchDist = 0;
                    }
                }, { passive: true });
            });

            // Document-level touch event handling for mobile portrait fullscreen scrolling
