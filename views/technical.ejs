    <meta property="twitter:title" content="Pro Chart: <%= ticker %> (<%= timeframe %>) | FinoraPulse">
    <meta property="twitter:description"
        content="Interactive charting terminal for <%= ticker %> on <%= timeframe %> timeframe. Standard & advanced overlays with automatic candlestick pattern detection.">
    <meta property="twitter:image" content="https://finorapulse.com/images/finorapulse-og-banner.jpg">

