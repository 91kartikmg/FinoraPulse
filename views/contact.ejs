<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | FinoraPulse AI</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@500;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/header.css" crossorigin="anonymous">
    <link rel="stylesheet" href="/css/home.css" crossorigin="anonymous">
    <link rel="icon" type="image/x-icon" href="/favicon.png">

    <style>
        .contact-card {
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 16px;
            padding: 40px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.3);
            margin-bottom: 30px;
            color: #e2e8f0;
            line-height: 1.7;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1.5fr;
            gap: 40px;
        }

        @media (max-width: 768px) {
            .contact-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
        }

        .info-panel {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .info-block h3 {
            margin: 0 0 5px 0;
            color: #00E5FF;
            font-size: 1.1rem;
        }

        .info-block p {
            margin: 0;
            color: #94a3b8;
            font-size: 0.95rem;
        }

        .form-group {
            margin-bottom: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group label {
            color: #94a3b8;
            font-size: 0.8rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .form-group textarea {
            background: #020617;
            border: 1px solid #1e293b;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            resize: vertical;
            min-height: 120px;
            transition: border-color 0.2s;
        }

        .form-group textarea:focus {
            border-color: #00E5FF;
        }

        .btn-send {
            background: #00E5FF;
            color: #020617;
            padding: 12px 24px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: opacity 0.2s;
            width: fit-content;
        }

        .btn-send:hover {
            opacity: 0.9;
        }

        .alert {
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            display: none;
        }

        .alert-success {
            background: rgba(0, 255, 157, 0.1);
            color: #00FF9D;
            border: 1px solid rgba(0, 255, 157, 0.2);
        }

        .alert-error {
            background: rgba(255, 77, 77, 0.1);
            color: #ff4d4d;
            border: 1px solid rgba(255, 77, 77, 0.2);
        }
    </style>
</head>

<body>

    <%- include('partials/header') %>

        <div class="main-wrapper">
            <%- include('partials/sidebar') %>

                <main class="content-panel"
                    style="padding: 30px; display: flex; flex-direction: column; min-height: 100%;">
                    <div style="margin-bottom: 15px;">
                        <a href="/"
                            style="color: #8E9BAE; text-decoration: none; font-size: 0.85rem; display: flex; align-items: center; gap: 5px;">
                            ← Back to Home Terminal
                        </a>
                    </div>

                    <div
                        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
                        <h1 style="margin: 0; font-size: 2.2rem; font-weight: 700; color: #fff;">Contact Us</h1>
                        <div style="font-size: 0.85rem; color: #64748b; font-family: 'JetBrains Mono', monospace;">
                            GATEWAY: <span style="color: #00ff9d;">SMTP_FEEDBACK</span>
                        </div>
                    </div>

                    <div class="contact-card">
                        <div class="contact-grid">
                            <!-- Left: Contact Info -->
                            <div class="info-panel">
                                <div class="info-block">
                                    <h3>Developer Email</h3>
                                    <p>finorapulse@gmail.com</p>
                                </div>
                                <div class="info-block">
                                    <h3>Office Hours</h3>
                                    <p>Monday – Friday: 9 AM – 6 PM IST</p>
                                </div>
                                <div class="info-block">
                                    <h3>Suggestions Portal</h3>
                                    <p>Your feedback is logged directly on the secure MongoDB feedback cluster and monitored by our administrator team.</p>
                                </div>
                            </div>

                            <!-- Right: Contact Form -->
                            <div>
                                <div id="alert-box" class="alert"></div>
                                <form id="contactForm" onsubmit="submitForm(event)">
                                    <div class="form-group">
                                        <label>Your Feedback / Message</label>
                                        <textarea id="msgContent" required placeholder="Type your suggestion or feedback here..."></textarea>
                                    </div>
                                    <button type="submit" class="btn-send">Send Message</button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Include Footer inside scrollable area -->
                    <%- include('partials/footer') %>
                </main>
        </div>

        <script>
            async function submitForm(e) {
                e.preventDefault();
                const text = document.getElementById('msgContent').value;
                const alertBox = document.getElementById('alert-box');
                
                alertBox.style.display = 'none';
                
                try {
                    const response = await fetch('/api/suggestion', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ text })
                    });
                    const data = await response.json();
                    
                    if (response.ok && data.success) {
                        alertBox.className = 'alert alert-success';
                        alertBox.innerText = data.message;
                        alertBox.style.display = 'block';
                        document.getElementById('msgContent').value = '';
                    } else {
                        alertBox.className = 'alert alert-error';
                        alertBox.innerText = data.error || 'Failed to send feedback. Please try again.';
                        alertBox.style.display = 'block';
                    }
                } catch (err) {
                    alertBox.className = 'alert alert-error';
                    alertBox.innerText = 'Network error. Please try again.';
                    alertBox.style.display = 'block';
                }
            }
        </script>
</body>

</html>
