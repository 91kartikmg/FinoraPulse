<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pro Scroll & Zoom Scalper Chart View (Dev Tool) | FinoraPulse</title>
    <meta name="robots" content="noindex, nofollow">
    <style>
        body { background: #0b0f19; color: white; font-family: sans-serif; margin: 0; overflow: hidden; }
        #chart-container { width: 100vw; height: 100vh; cursor: crosshair; user-select: none; }
        svg { width: 100%; height: 100%; shape-rendering: crispEdges; }
        .crosshair { stroke: #475569; stroke-dasharray: 4; pointer-events: none; }
        .price-text { fill: #94a3b8; font-size: 11px; font-family: monospace; }
        .time-text { fill: #64748b; font-size: 10px; text-anchor: middle; }
    </style>
</head>
<body>
    <div id="chart-container">
        <svg id="main-svg">
            <g id="grid-layer"></g>
            <g id="volume-layer" opacity="0.15"></g>
            <g id="candle-layer"></g>
            <g id="time-layer"></g>
            <line id="cross-h" class="crosshair" x1="0" y1="0" x2="100%" y2="0" />
            <line id="cross-v" class="crosshair" x1="0" y1="0" x2="0" y2="100%" />
        </svg>
    </div>

<script>
    let fullData = [];
    let visibleCount = 60; 
    let offset = 0;        
    
    // NEW: Variable to store small mouse movements
    let dragAccumulator = 0; 
    
    const svgEl = document.getElementById('main-svg');

    async function fetchData() {
        const res = await fetch('/api/chart-svg?ticker=<%= ticker %>');
        const data = await res.json();
        if (data.error) return console.error(data.error);
        
        fullData = data;
        offset = Math.max(0, fullData.length - visibleCount);
        render();
    }

    // --- ZOOM LOGIC ---
    window.addEventListener('wheel', (e) => {
        e.preventDefault();
        
        // NEW: Allow horizontal trackpad scrolling to Pan the chart
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
            dragAccumulator -= e.deltaX;
            const candleW = (window.innerWidth - 80) / visibleCount;
            const candlesToMove = Math.trunc(dragAccumulator / candleW);
            
            if (candlesToMove !== 0) {
                offset = Math.min(Math.max(offset - candlesToMove, 0), fullData.length - visibleCount);
                dragAccumulator -= (candlesToMove * candleW);
                render();
            }
            return;
        }

        // Vertical scroll for Zoom
        const delta = Math.sign(e.deltaY);
        const oldVisibleCount = visibleCount;
        const step = Math.ceil(visibleCount * 0.15);
        
        visibleCount = Math.min(Math.max(visibleCount + (delta * step), 10), fullData.length);
        offset = Math.min(Math.max(offset + Math.floor((oldVisibleCount - visibleCount) / 2), 0), fullData.length - visibleCount);
        render();
    }, { passive: false });

    // --- PANNING LOGIC ---
    let isPanning = false;
    let lastMouseX = 0;

    svgEl.onmousedown = (e) => {
        isPanning = true;
        lastMouseX = e.clientX;
        dragAccumulator = 0; // Reset accumulator on new click
    };

    window.onmouseup = () => { isPanning = false; };

    window.onmousemove = (e) => {
        const rect = svgEl.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;

        // Update Crosshair Position
        document.getElementById('cross-h').setAttribute('y1', my);
        document.getElementById('cross-h').setAttribute('y2', my);
        document.getElementById('cross-v').setAttribute('x1', mx);
        document.getElementById('cross-v').setAttribute('x2', mx);

        if (isPanning) {
            // FIXED: Accumulate pixel movements continuously
            const dx = e.clientX - lastMouseX;
            lastMouseX = e.clientX; 
            dragAccumulator += dx; 

            const chartW = window.innerWidth - 80;
            const candleW = chartW / visibleCount;
            
            // Check if accumulated pixels are enough to move at least 1 candle
            const candlesToMove = Math.trunc(dragAccumulator / candleW);
            
            if (candlesToMove !== 0) {
                offset = Math.min(Math.max(offset - candlesToMove, 0), fullData.length - visibleCount);
                
                // Subtract the used pixels, but keep the remainder for smooth slow-dragging
                dragAccumulator -= (candlesToMove * candleW); 
                render();
            }
        }
    };

    function render() {
        if (!fullData.length) return;

        const w = window.innerWidth, h = window.innerHeight;
        const padR = 80, padB = 40, padT = 20;
        const chartW = w - padR, chartH = h - padB - padT;

        const displayData = fullData.slice(offset, offset + visibleCount);
        const highs = displayData.map(d => d[2]), lows = displayData.map(d => d[3]);
        const maxP = Math.max(...highs), minP = Math.min(...lows);
        const range = maxP - minP;

        const getY = (p) => (h - padB) - ((p - minP) / range) * chartH;
        const candleW = chartW / displayData.length;

        // 1. Grid
        let gridHtml = '';
        for (let i = 0; i <= 10; i++) {
            const p = minP + (range * (i / 10));
            const y = getY(p);
            gridHtml += `<line x1="0" y1="${y}" x2="${chartW}" y2="${y}" stroke="#1e293b" stroke-width="1"/>
                         <text x="${chartW + 8}" y="${y + 4}" class="price-text">${p.toFixed(2)}</text>`;
        }
        document.getElementById('grid-layer').innerHTML = gridHtml;

        // 2. Candles, Volume & Time
        let candleHtml = '', volHtml = '', timeHtml = '';
        const maxV = Math.max(...displayData.map(d => d[5] || 0));
        const timeStep = Math.ceil(visibleCount / 8);

        displayData.forEach((d, i) => {
            const [date, o, hi, lo, c, v] = d;
            const x = i * candleW;
            const midX = x + (candleW / 2);
            const color = c >= o ? "#26a69a" : "#ef5350";

            // Volume Bars
            const vH = (v / maxV) * 60;
            volHtml += `<rect x="${x + 2}" y="${h - padB - vH}" width="${candleW - 4}" height="${vH}" fill="${color}" />`;

            // Candle Body (Thick) & Wick (Thin)
            const bodyT = getY(Math.max(o, c)), bodyB = getY(Math.min(o, c));
            const bodyH = Math.max(Math.abs(bodyT - bodyB), 1.5);
            
            candleHtml += `<line x1="${midX}" y1="${getY(hi)}" x2="${midX}" y2="${getY(lo)}" stroke="${color}" stroke-width="1.5" />`;
            candleHtml += `<rect x="${x + (candleW * 0.15)}" y="${bodyT}" width="${candleW * 0.7}" height="${bodyH}" fill="${color}" />`;

            // Time Labels
            if (i % timeStep === 0) {
                timeHtml += `<text x="${midX}" y="${h - 15}" class="time-text">${date}</text>`;
            }
        });

        document.getElementById('candle-layer').innerHTML = candleHtml;
        document.getElementById('volume-layer').innerHTML = volHtml;
        document.getElementById('time-layer').innerHTML = timeHtml;
    }

    window.onresize = render;
    fetchData();
</script>
</body>
</html>