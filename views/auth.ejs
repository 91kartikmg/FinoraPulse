
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Terminal Portal Sign In | FinoraPulse AI</title>
    <meta name="robots" content="noindex, nofollow">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #020617; --card-bg: #0f172a; --accent: #38bdf8;
            --text-main: #f8fafc; --text-muted: #94a3b8; --border: #1e293b;
            --error: #ef4444;
        }
        body { margin: 0; background-color: var(--bg-dark); color: var(--text-main); font-family: 'Inter', sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; }
        
        .auth-container { background: var(--card-bg); width: 100%; max-width: 400px; padding: 2rem; border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1); box-sizing: border-box; margin: 20px; }
        .logo { text-align: center; margin-bottom: 2rem; font-size: 1.5rem; font-weight: 700; }
        .accent { color: var(--accent); }
        
        .tabs { display: flex; border-bottom: 1px solid var(--border); margin-bottom: 20px; }
        .tab { flex: 1; padding: 10px; text-align: center; cursor: pointer; color: var(--text-muted); transition: all 0.3s; border-bottom: 2px solid transparent; }
        .tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }
        
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 5px; }
        input { width: 100%; background: rgba(2, 6, 23, 0.5); border: 1px solid var(--border); color: white; padding: 10px; border-radius: 8px; outline: none; transition: 0.3s; }
        input:focus { border-color: var(--accent); }
        
        .btn { width: 100%; background: var(--accent); color: var(--bg-dark); padding: 12px; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; margin-top: 10px; transition: opacity 0.2s; }
        .btn:hover { opacity: 0.9; }
        
        .error-msg { background: rgba(239, 68, 68, 0.1); color: var(--error); padding: 10px; border-radius: 6px; font-size: 0.85rem; margin-bottom: 15px; display: none; text-align: center; border: 1px solid rgba(239, 68, 68, 0.2); }
        .success-msg { background: rgba(56, 189, 248, 0.1); color: var(--accent); padding: 10px; border-radius: 6px; font-size: 0.85rem; margin-bottom: 15px; display: none; text-align: center; border: 1px solid rgba(56, 189, 248, 0.2); }
        
        #register-form { display: none; }
    </style>
</head>
<body>

<div class="auth-container">
    <div class="logo">StockPulse <span class="accent">AI</span></div>

    <div class="error-msg" id="ajax-error"></div>
    <div class="success-msg" id="ajax-success"></div>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-msg" style="display: block;"><%= error %></div>
    <% } %>

    <div class="tabs">
        <div class="tab active" onclick="switchTab('login')">Login</div>
        <div class="tab" onclick="switchTab('register')">Sign Up</div>
    </div>

    <form id="login-form" action="/login" method="POST">
        <div class="form-group">
            <label>User ID or Gmail</label>
            <input type="text" name="loginInput" required placeholder="Enter username or email">
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" required placeholder="••••••••">
        </div>
        <div style="display: flex; justify-content: flex-end; margin-top: -5px; margin-bottom: 15px;">
            <a href="#" onclick="showForgotPassword(event)" style="color: var(--accent); text-decoration: none; font-size: 0.8rem; opacity: 0.8; transition: opacity 0.2s;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.8">Forgot Password?</a>
        </div>
        <button type="submit" class="btn">Access Terminal</button>
    </form>

    <form id="register-form" action="/register" method="POST">
        <div class="form-group">
            <label>Gmail Address</label>
            <input type="email" name="email" required placeholder="you@gmail.com">
        </div>
        <div class="form-group">
            <label>User ID</label>
            <input type="text" name="username" required placeholder="Create a unique ID">
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" required placeholder="Create password">
        </div>
        <div class="form-group">
            <label>Confirm Password</label>
            <input type="password" name="confirmPassword" required placeholder="Repeat password">
        </div>
        <button type="submit" class="btn">Create Account</button>
    </form>

    <form id="forgot-form" style="display: none;">
        <!-- Step 1: Verify OTP -->
        <div id="forgot-step-otp">
            <div class="form-group">
                <label>Verification OTP (6-digits)</label>
                <input type="text" id="forgot-otp" placeholder="••••••" pattern="\d{6}" maxlength="6" style="text-align: center; letter-spacing: 0.5rem; font-size: 1.25rem; font-weight: 600;">
            </div>
            <button type="button" onclick="handleVerifyOTP()" class="btn" id="verify-otp-btn">Verify OTP</button>
        </div>

        <!-- Step 2: Reset Password (Hidden by default) -->
        <div id="forgot-step-reset" style="display: none;">
            <div class="form-group">
                <label>New Password</label>
                <input type="password" id="forgot-new-password" placeholder="Enter new password">
            </div>
            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" id="forgot-confirm-password" placeholder="Repeat new password">
            </div>
            <button type="button" onclick="handleResetPassword()" class="btn" id="reset-pass-btn">Reset Password</button>
        </div>
        
        <div style="text-align: center; margin-top: 20px; display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem;">
            <a href="#" onclick="resendOTP(event)" id="resend-otp-link" style="color: var(--accent); text-decoration: none; opacity: 0.8;" onmouseover="this.style.opacity=1" onmouseout="this.style.opacity=0.8">Resend OTP</a>
            <a href="#" onclick="cancelForgotPassword(event)" style="color: var(--text-muted); text-decoration: none;" onmouseover="this.style.color='var(--text-main)'" onmouseout="this.style.color='var(--text-muted)'">Back to Login</a>
        </div>
    </form>
</div>

<script>
    function switchTab(tab) {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        if (tab === 'login') {
            document.querySelectorAll('.tab')[0].classList.add('active');
            document.getElementById('login-form').style.display = 'block';
            document.getElementById('register-form').style.display = 'none';
        } else {
            document.querySelectorAll('.tab')[1].classList.add('active');
            document.getElementById('login-form').style.display = 'none';
            document.getElementById('register-form').style.display = 'block';
        }
    }

    async function showForgotPassword(e) {
        if (e) e.preventDefault();
        
        clearAlerts();

        const loginInputVal = document.querySelector('input[name="loginInput"]').value.trim();
        if (!loginInputVal) {
            showAlert('error', 'Please enter your User ID or Gmail address in the login field first.');
            return;
        }

        // Hide existing forms and tab selectors
        document.getElementById('login-form').style.display = 'none';
        document.getElementById('register-form').style.display = 'none';
        document.querySelector('.tabs').style.display = 'none';
        
        // Show forgot form
        document.getElementById('forgot-form').style.display = 'block';
        document.getElementById('forgot-step-otp').style.display = 'block';
        document.getElementById('forgot-step-reset').style.display = 'none';

        // Trigger OTP immediately
        await triggerOTPSending(loginInputVal);
    }

    async function triggerOTPSending(loginInput) {
        const verifyBtn = document.getElementById('verify-otp-btn');
        verifyBtn.disabled = true;
        
        showAlert('success', 'Sending verification OTP to your registered email...');

        try {
            const response = await fetch('/auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ loginInput })
            });
            
            const data = await response.json();
            if (response.ok && data.success) {
                showAlert('success', data.message);
                // Focus OTP field
                setTimeout(() => document.getElementById('forgot-otp').focus(), 100);
            } else {
                showAlert('error', data.error || 'Failed to send OTP. Please return to login and try again.');
            }
        } catch (err) {
            showAlert('error', 'Network error. Please try again.');
        } finally {
            verifyBtn.disabled = false;
        }
    }

    async function resendOTP(e) {
        if (e) e.preventDefault();
        const loginInputVal = document.querySelector('input[name="loginInput"]').value.trim();
        if (!loginInputVal) return;
        
        const resendLink = document.getElementById('resend-otp-link');
        const originalText = resendLink.textContent;
        resendLink.textContent = 'Resending...';
        resendLink.style.pointerEvents = 'none';
        resendLink.style.opacity = '0.5';

        try {
            const response = await fetch('/auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ loginInput: loginInputVal })
            });
            
            const data = await response.json();
            if (response.ok && data.success) {
                showAlert('success', data.message);
            } else {
                showAlert('error', data.error || 'Failed to resend OTP. Please try again.');
            }
        } catch (err) {
            showAlert('error', 'Network error. Please try again.');
        } finally {
            resendLink.textContent = originalText;
            resendLink.style.pointerEvents = 'auto';
            resendLink.style.opacity = '0.8';
        }
    }

    async function handleVerifyOTP() {
        const loginInputVal = document.querySelector('input[name="loginInput"]').value.trim();
        const otp = document.getElementById('forgot-otp').value.trim();
        
        if (!otp) {
            showAlert('error', 'Please enter the 6-digit OTP.');
            return;
        }
        
        const btn = document.getElementById('verify-otp-btn');
        const originalText = btn.textContent;
        btn.textContent = 'Verifying...';
        btn.disabled = true;
        
        try {
            const response = await fetch('/auth/verify-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ loginInput: loginInputVal, otp })
            });
            
            const data = await response.json();
            if (response.ok && data.success) {
                showAlert('success', data.message);
                document.getElementById('forgot-step-otp').style.display = 'none';
                document.getElementById('forgot-step-reset').style.display = 'block';
                setTimeout(() => document.getElementById('forgot-new-password').focus(), 100);
            } else {
                showAlert('error', data.error || 'Invalid or expired OTP. Please try again.');
            }
        } catch (err) {
            showAlert('error', 'Network error. Please try again.');
        } finally {
            btn.textContent = originalText;
            btn.disabled = false;
        }
    }
    
    function cancelForgotPassword(e) {
        if (e) e.preventDefault();
        
        // Hide forgot password form
        document.getElementById('forgot-form').style.display = 'none';
        
        // Reset steps
        document.getElementById('forgot-step-otp').style.display = 'block';
        document.getElementById('forgot-step-reset').style.display = 'none';
        
        // Clear fields
        document.getElementById('forgot-otp').value = '';
        document.getElementById('forgot-new-password').value = '';
        document.getElementById('forgot-confirm-password').value = '';
        
        // Show login form and tab selectors
        document.querySelector('.tabs').style.display = 'flex';
        switchTab('login');
        
        // Clear message alerts
        clearAlerts();
    }
    
    function clearAlerts() {
        const ajaxErr = document.getElementById('ajax-error');
        const ajaxSucc = document.getElementById('ajax-success');
        if (ajaxErr) { ajaxErr.style.display = 'none'; ajaxErr.textContent = ''; }
        if (ajaxSucc) { ajaxSucc.style.display = 'none'; ajaxSucc.textContent = ''; }
        
        // Also clear any server-side ejs error block if exists
        const serverErr = document.querySelector('.auth-container > .error-msg:not(#ajax-error)');
        if (serverErr) serverErr.style.display = 'none';
    }
    
    function showAlert(type, message) {
        clearAlerts();
        if (type === 'error') {
            const errDiv = document.getElementById('ajax-error');
            errDiv.textContent = message;
            errDiv.style.display = 'block';
        } else if (type === 'success') {
            const succDiv = document.getElementById('ajax-success');
            succDiv.textContent = message;
            succDiv.style.display = 'block';
        }
    }
    
    async function handleResetPassword() {
        const loginInputVal = document.querySelector('input[name="loginInput"]').value.trim();
        const otp = document.getElementById('forgot-otp').value.trim();
        const password = document.getElementById('forgot-new-password').value;
        const confirmPassword = document.getElementById('forgot-confirm-password').value;
        
        if (!otp || !password || !confirmPassword) {
            showAlert('error', 'All fields are required.');
            return;
        }
        
        if (password !== confirmPassword) {
            showAlert('error', 'Passwords do not match.');
            return;
        }
        
        const btn = document.getElementById('reset-pass-btn');
        const originalText = btn.textContent;
        btn.textContent = 'Resetting...';
        btn.disabled = true;
        
        try {
            const response = await fetch('/auth/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ loginInput: loginInputVal, otp, password, confirmPassword })
            });
            
            const data = await response.json();
            if (response.ok && data.success) {
                showAlert('success', data.message);
                // Clear fields
                document.getElementById('forgot-otp').value = '';
                document.getElementById('forgot-new-password').value = '';
                document.getElementById('forgot-confirm-password').value = '';
                
                // Keep showing success but return to login after 3 seconds
                setTimeout(() => {
                    cancelForgotPassword();
                }, 3000);
            } else {
                showAlert('error', data.error || 'Failed to reset password. Please try again.');
            }
        } catch (err) {
            showAlert('error', 'Network error. Please try again.');
        } finally {
            btn.textContent = originalText;
            btn.disabled = false;
        }
    }
</script>
</body>
</html>