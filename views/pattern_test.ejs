<!DOCTYPE html>
<html lang="en">
<head>
    <title>Pattern Detection Test</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { background: #0b0e11; color: white; font-family: sans-serif; }
        .chart-container { width: 90%; margin: auto; background: #161a1e; padding: 20px; border-radius: 8px; }
        .signal-badge { padding: 10px 20px; border-radius: 5px; font-weight: bold; display: inline-block; margin-bottom: 10px; }
        .buy { background: #2ebd85; }
    </style>
</head>
<body>
    <div class="chart-container">
        <h2>Pattern Analysis: <span id="tickerDisplay"><%= ticker %></span></h2>
        <div id="signal" class="signal-badge buy">WAITING FOR DATA...</div>
        <canvas id="patternChart"></canvas>
    </div>

    <script>
        async function loadChart() {
            const ticker = "<%= ticker %>";
            const res = await fetch(`/api/patterns?ticker=${ticker}`);
            const data = await res.json();

            document.getElementById('signal').innerText = data.signal;
            
            const ctx = document.getElementById('patternChart').getContext('2d');
            
            // Prepare Actual Price Dataset
            const actualData = data.actual_price.map(p => ({ x: p.time, y: p.value }));
            
            const datasets = [{
                label: 'Actual Price',
                data: actualData,
                borderColor: '#3b82f6', // Blue Line
                borderWidth: 2,
                pointRadius: 0,
                fill: false,
                tension: 0.1
            }];

            // Add Detected Patterns as separate Red Line datasets
            data.detected_patterns.forEach(pattern => {
                datasets.push({
                    label: pattern.label,
                    data: pattern.points,
                    borderColor: 'red', // Red Line
                    borderWidth: 3,
                    pointRadius: 5,
                    fill: false,
                    showLine: true
                });
            });

            new Chart(ctx, {
                type: 'line',
                data: { datasets: datasets },
                options: {
                    responsive: true,
                    scales: {
                        x: { grid: { color: '#232730' } },
                        y: { grid: { color: '#232730' } }
                    },
                    plugins: {
                        legend: { labels: { color: 'white' } }
                    }
                }
            });
        }
        loadChart();
    </script>
</body>
</html>